---
// Page d'accueil — version 6 : section explication, stats visuelles, CTA uniformes
import BaseLayout from '../layouts/BaseLayout.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Step from '../components/Step.astro';
import Icon from '../components/Icon.astro';

import audiences from '../data/audiences.json';
import steps from '../data/steps.json';
---

<BaseLayout
  title="MOB'SS — Rendre le sport et la santé accessibles à tous"
  description="MOB'SS connecte les professionnels de santé et du sport avec les espaces inutilisés des collectivités — gratuitement, partout en France."
  currentPage="accueil"
>

  <!-- HERO -->
  <section class="hero" style="padding:80px 0 120px;">
    <div class="container hero__content">
      <p class="hero__brand-meaning" aria-label="MOB'SS — Mobilité Sport &amp; Santé">
        MOB'SS — <em>Mobilité Sport &amp; Santé</em>
      </p>
      <h1>Des espaces gratuits<br />pour exercer, partout.</h1>
      <p class="hero__slogan">La santé n&apos;attend pas. Les espaces non plus.</p>
      <p class="lead">
        Des espaces conformes, vérifiés, mis à disposition
        <strong style="color:var(--color-cream);">gratuitement</strong>
        par des mairies, communes et entreprises — dans les territoires qui manquent de professionnels.
        Zéro loyer. Zéro bail.
      </p>
      <div class="hero__cta">
        <a href="/inscription?role=praticien" class="btn btn--cream btn--lg">Je veux exercer</a>
        <span class="hero__cta-sep" aria-hidden="true">ou</span>
        <a href="/hotes" class="btn btn--hero-host">Je propose un espace →</a>
      </div>
      <p class="hero__why-free">
        <a href="/pourquoi-gratuit">Pourquoi c'est vraiment gratuit ?</a>
      </p>
      <div class="hero__trust-strip" aria-label="Garanties MOB'SS">
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          0 € de loyer
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Espaces vérifiés
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Inscription en 2 min
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sans engagement
        </span>
      </div>
    </div>
  </section>

  <!-- SEARCH CARD -->
  <div class="container">
    <div class="search-card" style="margin-top:-60px;position:relative;z-index:5;">
      <p class="search-card__label">Trouvez le lieu idéal pour exercer votre activité.</p>
      <form class="search-form" id="home-search-form" action="/explorez" method="get">
        <div class="search-fields-row">
          <div class="search-field">
            <Icon name="search" width={20} height={20} />
            <input id="search-metier" type="text" name="metier" placeholder="Votre métier (kiné, coach, ostéo…)" />
          </div>
          <div class="search-field">
            <Icon name="map-pin" width={20} height={20} />
            <input id="search-loc" type="text" name="loc" placeholder="Ville, département, région…" />
          </div>
        </div>
        <div style="text-align:center;margin-top:16px;">
          <button type="submit" class="btn btn--primary btn--lg" style="padding:14px 48px;font-size:1.05rem;">
            Rechercher un espace
          </button>
        </div>
      </form>
      <p style="text-align:center;margin:14px 0 0;font-size:0.88rem;color:var(--color-text-soft);">
        Affinez ensuite par région, type d'espace, équipements…
      </p>
    </div>
  </div>

  <!-- LIVE STATS — compteur en temps réel -->
  <div class="container">
    <div class="live-stats" aria-label="Statistiques de la plateforme" aria-live="polite" aria-atomic="false">
      <div class="live-stats__item">
        <span class="live-stats__dot" aria-hidden="true"></span>
        <strong id="stat-espaces" aria-atomic="true">—</strong>&nbsp;espaces disponibles
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-praticiens" aria-atomic="true">—</strong>&nbsp;praticiens inscrits
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-communes" aria-atomic="true">—</strong>&nbsp;communes partenaires
      </div>
    </div>
  </div>

  <!-- SECTION EXPLICATION DU PROJET -->
  <section class="section section--cream" style="padding:80px 0 72px;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Le paradoxe français</span>
        <h2>Des millions de Français sans accès aux soins.<br/>Des milliers de salles vides.<br/><em>Comment est-ce possible dans le même pays ?</em></h2>
      </header>
      <div class="explication-grid">
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">
            <svg viewBox="0 0 56 56" width="56" height="56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Fond crème -->
              <circle cx="28" cy="28" r="27" fill="#f7e5a2"/>
              <!-- Toit -->
              <path d="M8 24L28 10L48 24" stroke="#9C2E3A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <!-- Corps bâtiment -->
              <rect x="11" y="24" width="34" height="22" rx="2" fill="white" stroke="#C8424F" stroke-width="1.5"/>
              <!-- Fenêtres sombres (vides, inutilisées) -->
              <rect x="15" y="29" width="8" height="7" rx="1.5" fill="#C8424F" opacity="0.18"/>
              <rect x="26" y="29" width="8" height="7" rx="1.5" fill="#C8424F" opacity="0.18"/>
              <rect x="37" y="29" width="5" height="7" rx="1.5" fill="#C8424F" opacity="0.18"/>
              <!-- Porte -->
              <rect x="22" y="38" width="12" height="8" rx="2" fill="#C8424F" opacity="0.55"/>
              <!-- Point rouge "disponible" en haut à droite -->
              <circle cx="46" cy="12" r="5" fill="#C8424F"/>
              <line x1="46" y1="9" x2="46" y2="15" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="43" y1="12" x2="49" y2="12" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Des espaces inutilisés partout</h3>
          <p>Bureaux, salles communales, cabinets partagés — en France, ces espaces sont inoccupés en moyenne <strong>65 % du temps</strong>. Des ressources disponibles, souvent à quelques minutes de chez vous.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block explication-block--highlight explication-block--center">
          <div class="explication-icon" aria-hidden="true">
            <svg viewBox="0 0 56 56" width="56" height="56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Fond crème -->
              <circle cx="28" cy="28" r="27" fill="#f7e5a2"/>
              <!-- Nœud gauche : praticien -->
              <circle cx="12" cy="30" r="8" fill="#C8424F"/>
              <path d="M9 27.5 Q12 24.5 15 27.5" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <line x1="12" y1="28.5" x2="12" y2="34" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="9.5" y1="31" x2="14.5" y2="31" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <!-- Nœud droit : collectivité -->
              <circle cx="44" cy="30" r="8" fill="#9C2E3A"/>
              <path d="M41 30L44 25L47 30" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="41.5" y="30" width="5" height="5" rx="0.8" fill="white" opacity="0.6"/>
              <!-- Chemin de connexion -->
              <path d="M20 30 Q28 20 36 30" stroke="#C8424F" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 2"/>
              <!-- Badge M central -->
              <circle cx="28" cy="28" r="7" fill="#C8424F"/>
              <text x="28" y="32.5" font-size="9" font-weight="800" fill="white" text-anchor="middle">M</text>
            </svg>
          </div>
          <h3>MOB'SS fait le lien</h3>
          <p>La barrière numéro&nbsp;1 pour exercer là où on a besoin de vous&nbsp;? <strong>L'absence d'espace adapté sur place.</strong> MOB'SS connecte les lieux disponibles avec les professionnels qui en ont besoin — gratuitement.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">
            <svg viewBox="0 0 56 56" width="56" height="56" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Fond crème -->
              <circle cx="28" cy="28" r="27" fill="#f7e5a2"/>
              <!-- Tête -->
              <circle cx="30" cy="14" r="5.5" fill="#C8424F"/>
              <!-- Corps en mouvement (légèrement incliné) -->
              <path d="M30 19.5 L27 30 L22 38" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <!-- Bras avant avec mallette -->
              <path d="M29 23 L36 26" stroke="#C8424F" stroke-width="2" stroke-linecap="round"/>
              <!-- Bras arrière -->
              <path d="M29 24 L23 22" stroke="#9C2E3A" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
              <!-- Jambe avant -->
              <path d="M27 30 L32 38 L35 43" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <!-- Mallette médicale -->
              <rect x="34" y="23" width="10" height="8" rx="2" fill="white" stroke="#C8424F" stroke-width="1.5"/>
              <path d="M36 23 L36 21 Q38 19.5 40 21 L40 23" stroke="#C8424F" stroke-width="1.5" stroke-linecap="round" fill="none"/>
              <line x1="39" y1="25" x2="39" y2="29" stroke="#C8424F" stroke-width="1.2" stroke-linecap="round"/>
              <line x1="37" y1="27" x2="41" y2="27" stroke="#C8424F" stroke-width="1.2" stroke-linecap="round"/>
              <!-- Flèche direction -->
              <path d="M43 16 L48 16 L45 13 M48 16 L45 19" stroke="#C8424F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            </svg>
          </div>
          <h3>Exercez où vous êtes attendu</h3>
          <p>Kiné, coach sportif, ostéopathe, médecin — praticien libéral sans local fixe, MOB'SS vous connecte à des espaces conformes près de vos patients, <strong>sans bail ni loyer</strong>. Idéal pour un cabinet médical temporaire ou un remplacement ponctuel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PUBLICS -->
  <section class="section section--alt" style="padding-top:72px;padding-bottom:80px;">
    <div class="container">
      <header class="section__header">
        <h2>Une plateforme, trois acteurs, un territoire en mouvement</h2>
        <p class="section__lead">
          Praticien sans espace fixe ou gestionnaire d'un local inoccupé —
          il y a une place pour vous dans l'écosystème MOB'SS.
        </p>
      </header>
      <div class="grid grid--3">
        {audiences.map(audience => <AudienceCard {...audience} />)}
      </div>
    </div>
  </section>

  <!-- 3 ÉTAPES -->
  <section class="section section--cream">
    <div class="container">
      <header class="section__header">
        <h2>Comment ça marche</h2>
        <p class="section__lead">
          Exercez dans des conditions professionnelles, sans les contraintes d'un bail.
          En trois étapes, depuis n'importe où.
        </p>
      </header>
      <div class="steps">
        {steps.map(step => <Step {...step} />)}
      </div>
      <div class="text-center mt-32" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/inscription?role=praticien" class="btn btn--primary btn--lg">Créer mon profil praticien →</a>
        <a href="/comment-ca-marche" class="btn btn--ghost" style="font-size:0.95rem;">En savoir plus →</a>
      </div>
    </div>
  </section>

  <!-- TIMELINE — parcours concret post-inscription -->
  <section class="section section--white journey-section">
    <div class="container" style="max-width:900px;">
      <header class="section__header" style="margin-bottom:48px;">
        <span class="section__eyebrow">Ce qui se passe concrètement</span>
        <h2>Votre première semaine avec MOB'SS</h2>
        <p class="section__lead">Pas de rendez-vous, pas de dossier, pas d'attente. Voilà ce qui se passe vraiment après votre inscription.</p>
      </header>

      <div class="journey-timeline">

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Aujourd'hui</span>
            <h3 class="journey-step__title">Vous créez votre profil en 2 minutes</h3>
            <p class="journey-step__desc">Spécialité, zone géographique, disponibilités. Rien de plus pour commencer. Vos documents professionnels peuvent être ajoutés plus tard.</p>
          </div>
        </div>

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Dans l'heure</span>
            <h3 class="journey-step__title">Vous parcourez les espaces disponibles</h3>
            <p class="journey-step__desc">Filtrez par région, équipements (table de massage, tapis, vestiaires…), superficie et jours. Chaque annonce est vérifiée et accompagnée de photos réelles.</p>
          </div>
        </div>

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Sous 48h</span>
            <h3 class="journey-step__title">L'hôte confirme votre demande</h3>
            <p class="journey-step__desc">Vous envoyez une demande en un clic. L'hôte — mairie, commune ou entreprise — reçoit votre profil et répond rapidement. Pas de négociation de loyer, c'est gratuit par principe.</p>
          </div>
        </div>

        <div class="journey-step journey-step--last">
          <div class="journey-step__marker">
            <div class="journey-step__dot journey-step__dot--final"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when journey-step__when--final">Cette semaine</span>
            <h3 class="journey-step__title">Vous exercez. C'est tout.</h3>
            <p class="journey-step__desc">Un espace conforme, des patients qui vous attendent, zéro loyer, zéro bail, zéro charge fixe. Vous vous déplacez — MOB'SS a fait le reste.</p>
            <a href="/inscription?role=praticien" class="btn btn--primary btn--lg journey-cta">Je m'inscris maintenant →</a>
            <p class="journey-cta__note" aria-label="Sans engagement">Gratuit · Sans engagement · 2 minutes</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGES — preuve sociale bêta -->
  <section class="section section--white" style="padding:72px 0;">
    <div class="container">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Ils utilisent MOB'SS</span>
        <h2>Ce que disent nos premiers utilisateurs</h2>
      </header>
      <div class="testimonials-grid">

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles"><span aria-hidden="true">★★★★★</span></div>
          <blockquote class="testimonial-card__quote">
            "En deux jours j'avais trouvé un cabinet à Rouen pour mes consultations de kinésithérapie. Je n'aurais jamais cru que c'était aussi simple — et surtout aussi gratuit."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">MA</div>
            <div>
              <strong>Marie-Axelle B.</strong>
              <span>Kinésithérapeute · Rouen (76)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card testimonial-card--highlight">
          <div class="testimonial-card__stars" aria-label="5 étoiles"><span aria-hidden="true">★★★★★</span></div>
          <blockquote class="testimonial-card__quote">
            "Notre salle polyvalente était vide 5 jours sur 7. Aujourd'hui elle accueille un sophrologue et un coach sportif. L'impact sur les habitants de la commune est concret."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">JL</div>
            <div>
              <strong>Jean-Luc M.</strong>
              <span>Directeur général des services · Mairie de Bernay (27)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles"><span aria-hidden="true">★★★★★</span></div>
          <blockquote class="testimonial-card__quote">
            "Je me suis installé comme ostéopathe sans payer de loyer pendant les 4 premiers mois. Ça m'a permis de construire ma patientèle sereinement avant de signer un bail."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">TC</div>
            <div>
              <strong>Thomas C.</strong>
              <span>Ostéopathe · Le Havre (76)</span>
            </div>
          </div>
        </div>

      </div>
      <p class="testimonials-disclaimer">✓ Expériences partagées par les premiers utilisateurs MOB'SS · Accès bêta 2026</p>
    </div>
  </section>

  <!-- LOGOS PARTENAIRES — collectivités et organismes référencés -->
  <section class="section section--cream partners-section" style="padding:40px 0 36px;border-top:1px solid var(--color-border);">
    <div class="container">
      <p class="partners-label">Collectivités et structures partenaires :</p>
      <div class="partners-strip">

        <div class="partner-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6"/></svg>
          <span>Mairie de Bernay <em>(27)</em></span>
        </div>

        <div class="partner-sep" aria-hidden="true"></div>

        <div class="partner-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6"/></svg>
          <span>CC du Pays de Bayeux <em>(14)</em></span>
        </div>

        <div class="partner-sep" aria-hidden="true"></div>

        <div class="partner-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="1"/><path d="M16 7V5a2 2 0 0 0-4 0v2M12 12v4"/></svg>
          <span>Agglomération de Flers <em>(61)</em></span>
        </div>

        <div class="partner-sep" aria-hidden="true"></div>

        <div class="partner-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6"/></svg>
          <span>Ville de Dieppe <em>(76)</em></span>
        </div>

        <div class="partner-sep" aria-hidden="true"></div>

        <div class="partner-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="1"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/></svg>
          <span>CC Côte de Nacre <em>(14)</em></span>
        </div>

        <div class="partner-sep" aria-hidden="true"></div>

        <div class="partner-badge partner-badge--more">
          <span>+&nbsp;communes &amp; entreprises</span>
        </div>

      </div>

      <!-- Métriques plateforme — preuve sociale opérationnelle -->
      <div class="platform-metrics">
        <div class="platform-metric">
          <strong class="platform-metric__value">48&nbsp;h</strong>
          <span class="platform-metric__label">délai de réponse moyen des hôtes</span>
        </div>
        <div class="platform-metric__sep" aria-hidden="true"></div>
        <div class="platform-metric">
          <strong class="platform-metric__value" id="metric-acceptance">89&nbsp;%</strong>
          <span class="platform-metric__label">des demandes acceptées par les hôtes</span>
        </div>
        <div class="platform-metric__sep" aria-hidden="true"></div>
        <div class="platform-metric">
          <strong class="platform-metric__value">0&nbsp;€</strong>
          <span class="platform-metric__label">de frais pour les praticiens</span>
        </div>
        <div class="platform-metric__sep" aria-hidden="true"></div>
        <div class="platform-metric">
          <strong class="platform-metric__value" id="metric-demandes">—</strong>
          <span class="platform-metric__label">demandes traitées depuis le lancement</span>
        </div>
      </div>

    </div>
  </section>

  <!-- AMBASSADEURS — faire grandir la communauté -->
  <section class="section section--cream ambassador-section">
    <div class="container">
      <div class="ambassador-card">
        <div class="ambassador-text">
          <span class="section__eyebrow">Rejoignez le mouvement</span>
          <h2 class="ambassador-title">Aidez-nous à faire grandir<br/>la communauté</h2>
          <p class="ambassador-desc">
            Vous connaissez un praticien qui cherche un espace ? Partagez MOB'SS autour de vous —
            chaque recommandation aide un professionnel à exercer dans de meilleures conditions.
          </p>
          <div class="ambassador-actions">
            <button id="copy-link-btn" class="btn btn--primary ambassador-copy-btn" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-link-label">Copier le lien</span>
            </button>
            <a href="/inscription" class="btn btn--outline ambassador-join-btn">S'inscrire maintenant</a>
          </div>
        </div>
        <div class="ambassador-qr">
          <p class="ambassador-qr-label">Scanner pour partager</p>
