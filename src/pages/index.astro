---
// Page d'accueil — version 6 : section explication, stats visuelles, CTA uniformes
import BaseLayout from '../layouts/BaseLayout.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Step from '../components/Step.astro';
import Icon from '../components/Icon.astro';

import audiences from '../data/audiences.json';
import steps from '../data/steps.json';
---

<BaseLayout
  title="MOB'SS — Des espaces gratuits pour exercer, partout en France"
  description="MOB'SS connecte les espaces inoccupés des collectivités et des entreprises avec les professionnels du sport et de la santé."
  currentPage="accueil"
>

  <!-- HERO -->
  <section class="hero" style="padding:80px 0 120px;">
    <div class="container hero__content">
      <h1>Des espaces gratuits<br />pour exercer,&nbsp;partout.</h1>
      <p class="lead">
        Collectivités et entreprises ouvrent leurs locaux aux professionnels
        du sport et de la santé — sans frais, en quelques clics.
      </p>
      <div class="hero__cta">
        <a href="/explorez" class="btn btn--cream btn--lg">Trouver un espace →</a>
        <a href="/inscription?role=collectivite" class="btn btn--hero-host btn--lg">
          Proposer un local
        </a>
      </div>
      <p class="hero__reassurance">Gratuit · Sans engagement · 100&nbsp;% en ligne</p>
    </div>
  </section>

  <!-- SEARCH CARD -->
  <div class="container">
    <div class="search-card" style="margin-top:-60px;position:relative;z-index:5;">
      <h2 style="font-size:clamp(1.15rem,2.5vw,1.45rem);margin-bottom:20px;">Trouvez le lieu idéal pour exercer votre activité.</h2>
      <form class="search-form" id="home-search-form" action="/explorez" method="get">
        <div class="search-fields-row">
          <div class="search-field">
            <Icon name="search" width={20} height={20} />
            <input id="search-metier" type="text" name="metier" placeholder="Votre métier (kiné, coach, ostéo…)" />
          </div>
          <div class="search-field">
            <Icon name="map-pin" width={20} height={20} />
            <input id="search-loc" type="text" name="loc" placeholder="Ville, département, région…" />
          </div>
        </div>
        <div style="text-align:center;margin-top:16px;">
          <button type="submit" class="btn btn--primary btn--lg" style="padding:14px 48px;font-size:1.05rem;">
            Rechercher un espace
          </button>
        </div>
      </form>
      <p style="text-align:center;margin:14px 0 0;font-size:0.88rem;color:var(--color-text-soft);">
        Affinez ensuite par région, type d'espace, équipements…
      </p>
    </div>
  </div>

  <!-- SECTION EXPLICATION DU PROJET -->
  <section class="section section--white" style="padding:80px 0 72px;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Le concept MOB'SS</span>
        <h2>Des locaux inutilisés. Des professionnels qui cherchent où exercer.<br/>La solution s'appelle MOB'SS.</h2>
      </header>
      <div class="explication-grid">
        <div class="explication-block">
          <div class="explication-icon">🏢</div>
          <h3>Des espaces qui dorment</h3>
          <p>Partout en France, des salles de réunion, gymnases, locaux municipaux et espaces d'entreprises restent vides une partie de la semaine — des ressources inexploitées à fort potentiel.</p>
        </div>
        <div class="explication-arrow">→</div>
        <div class="explication-block explication-block--highlight">
          <div class="explication-icon">🤝</div>
          <h3>MOB'SS fait le lien</h3>
          <p>Notre plateforme met en relation les propriétaires d'espaces avec les professionnels du sport et de la santé à la recherche d'un lieu pour exercer. Simple, gratuit, et ancré dans votre territoire.</p>
        </div>
        <div class="explication-arrow">→</div>
        <div class="explication-block">
          <div class="explication-icon">🏃</div>
          <h3>Des soins accessibles à tous</h3>
          <p>Kinés, coachs sportifs, ostéopathes, diététiciens… exercent dans des locaux adaptés sans frais de location. Résultat : plus de professionnels là où les habitants en ont besoin.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PUBLICS -->
  <section class="section section--alt" style="padding-top:72px;padding-bottom:80px;">
    <div class="container">
      <header class="section__header">
        <h2>Une réponse adaptée à chaque acteur du territoire</h2>
        <p class="section__lead">
          MOB'SS rassemble praticiens, collectivités et entreprises autour d'un même objectif :
          rendre le sport et la santé accessibles partout, sans barrière financière.
        </p>
      </header>
      <div class="grid grid--3">
        {audiences.map(audience => <AudienceCard {...audience} />)}
      </div>
    </div>
  </section>

  <!-- 3 ÉTAPES -->
  <section class="section section--cream">
    <div class="container">
      <header class="section__header">
        <h2>Comment ça marche</h2>
        <p class="section__lead">
          Un fonctionnement simple, en trois étapes, pour démarrer rapidement.
        </p>
      </header>
      <div class="steps">
        {steps.map(step => <Step {...step} />)}
      </div>
      <div class="text-center mt-32" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/explorez" class="btn btn--primary btn--lg">Chercher un espace maintenant</a>
        <a href="/comment-ca-marche" class="btn btn--ghost" style="font-size:0.95rem;">En savoir plus →</a>
      </div>
    </div>
  </section>

  <!-- POURQUOI MOB'SS — chiffres visuels -->
  <section class="section section--white" style="padding:80px 0;">
    <div class="container">
      <header class="section__header">
        <span class="section__eyebrow">Pourquoi MOB'SS, et pourquoi maintenant</span>
        <h2>Un problème national.<br/>Une solution locale.</h2>
        <p class="section__lead">
          Sédentarité, déserts médicaux, espaces inoccupés, manque d'accès au sport&nbsp;—
          trois enjeux convergent pour faire de MOB'SS une nécessité.
        </p>
      </header>

      <!-- Chiffres clés — 3 stats impactantes -->
      <div class="stats-visual">
        <div class="stat-visual-card stat-visual-card--red">
          <div class="stat-visual-card__value">5 M m²</div>
          <div class="stat-visual-card__label">de bureaux vacants rien qu'en Île-de-France</div>
          <div class="stat-visual-card__source">JLL — Q4 2024</div>
        </div>
        <div class="stat-visual-card stat-visual-card--dark">
          <div class="stat-visual-card__value">−7 ans</div>
          <div class="stat-visual-card__label">d'espérance de vie en bonne santé dus à la sédentarité</div>
          <div class="stat-visual-card__source">Santé Publique France</div>
        </div>
        <div class="stat-visual-card stat-visual-card--cream">
          <div class="stat-visual-card__value">0 €</div>
          <div class="stat-visual-card__label">de loyer pour le praticien — modèle gracieux</div>
          <div class="stat-visual-card__source">Modèle MOB'SS</div>
        </div>
      </div>

      <!-- Stats secondaires -->
      <div class="stats-secondary">
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">65 %</span>
          <span class="stat-secondary-item__label">des salariés favorables au sport au travail</span>
          <span class="stat-secondary-item__source">Étude Ifop 2023</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">13 %</span>
          <span class="stat-secondary-item__label">de vacance commerciale en centre-ville</span>
          <span class="stat-secondary-item__source">Baromètre Procos 2024</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">60 %</span>
          <span class="stat-secondary-item__label">de réduction d'impôt pour les entreprises mécènes</span>
          <span class="stat-secondary-item__source">Article 238 bis CGI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL — double audience -->
  <section class="section cta-final-section" style="padding:80px 0;">
    <div class="container">
      <div class="cta-final-grid">

        <!-- Praticien -->
        <div class="cta-final-card cta-final-card--praticien">
          <span class="cta-final-card__eyebrow">Vous êtes praticien</span>
          <h2 class="cta-final-card__title">Trouvez un espace dès aujourd'hui</h2>
          <p class="cta-final-card__desc">Kinésithérapeute, coach, ostéopathe… accédez à des locaux adaptés, sans frais de location, près de chez vous.</p>
          <a href="/explorez" class="btn btn--cream btn--lg">Parcourir les espaces →</a>
          <p class="cta-final-card__sub">Inscription gratuite · 2 min</p>
        </div>

        <!-- Hôte -->
        <div class="cta-final-card cta-final-card--hote">
          <span class="cta-final-card__eyebrow">Vous avez un espace</span>
          <h2 class="cta-final-card__title">Donnez vie à vos locaux inutilisés</h2>
          <p class="cta-final-card__desc">Collectivité, entreprise, association — vos salles inoccupées peuvent accueillir des professionnels de santé et générer un impact local concret.</p>
          <a href="/inscription?role=collectivite" class="btn btn--primary btn--lg">Déposer un espace →</a>
          <p class="cta-final-card__sub">Gratuit · Accompagnement inclus</p>
        </div>

      </div>
    </div>
  </section>

  <!-- BANDEAU DOCTOLIB — discret, juste avant le footer -->
  <div class="doctolib-banner">
    <span>👤 Vous êtes patient·e ?</span>
    <span style="color:var(--color-text-soft);">MOB'SS est réservé aux professionnels. Pour prendre rendez-vous :</span>
    <a href="https://www.doctolib.fr" target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="white-space:nowrap;">
      Aller sur Doctolib →
    </a>
  </div>

</BaseLayout>

<style>
  /* Recherche — inputs sur une ligne, bouton en dessous centré */
  .search-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* Section explication */
  .explication-grid {
    display: grid;
    grid-template-columns: 1fr 40px 1fr 40px 1fr;
    gap: 8px;
    align-items: center;
  }
  .explication-block {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
  }
  .explication-block--highlight {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .explication-block--highlight h3 { color: #fff; }
  .explication-block--highlight p { color: rgba(255,255,255,0.88); }
  .explication-icon {
    font-size: 2.2rem;
    margin-bottom: 14px;
    line-height: 1;
  }
  .explication-block h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .explication-block p { color: var(--color-text-soft); font-size: 0.93rem; margin: 0; line-height: 1.55; }
  .explication-arrow {
    text-align: center;
    font-size: 1.8rem;
    color: var(--color-primary);
    font-weight: 700;
    opacity: 0.5;
  }

  /* Stats visuelles — 3 grandes cartes colorées */
  .stats-visual {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  .stat-visual-card {
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stat-visual-card--red {
    background: var(--color-primary);
    color: #fff;
  }
  .stat-visual-card--dark {
    background: var(--color-text);
    color: #fff;
  }
  .stat-visual-card--cream {
    background: var(--color-cream);
    color: var(--color-primary-dark);
  }
  .stat-visual-card__value {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-visual-card--red   .stat-visual-card__value { color: #fff; }
  .stat-visual-card--dark  .stat-visual-card__value { color: var(--color-cream); }
  .stat-visual-card--cream .stat-visual-card__value { color: var(--color-primary); }
  .stat-visual-card__label {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    opacity: 0.9;
  }
  .stat-visual-card__source {
    font-size: 0.78rem;
    opacity: 0.65;
    margin-top: auto;
  }

  /* Stats secondaires — ligne horizontale -->
  .stats-secondary {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px 32px;
    gap: 0;
  }
  .stat-secondary-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }
  .stat-secondary-item__value {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-secondary-item__label {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.4;
  }
  .stat-secondary-item__source {
    font-size: 0.75rem;
    color: var(--color-text-soft);
  }
  .stat-secondary-sep {
    width: 1px;
    height: 56px;
    background: var(--color-border);
    margin: 0 24px;
    flex-shrink: 0;
  }

  /* Hero — ligne de réassurance sous les CTA */
  .hero__reassurance {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.72);
    margin-top: 14px;
    letter-spacing: 0.04em;
  }

  /* Bouton hôte dans le hero — blanc/translucide pour contraste sur fond primary */
  .btn--hero-host {
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.5);
    backdrop-filter: blur(4px);
  }
  .btn--hero-host:hover {
    background: rgba(255,255,255,0.25);
    color: #fff;
    border-color: rgba(255,255,255,0.8);
  }

  /* CTA final — double carte côte à côte */
  .cta-final-section {
    background: var(--color-bg-soft);
  }
  .cta-final-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .cta-final-card {
    border-radius: var(--radius-lg);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cta-final-card--praticien {
    background: var(--color-text);
    color: #fff;
  }
  .cta-final-card--hote {
    background: var(--color-cream);
    color: var(--color-text);
  }
  .cta-final-card__eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .cta-final-card--praticien .cta-final-card__eyebrow { color: var(--color-cream); }
  .cta-final-card--hote      .cta-final-card__eyebrow { color: var(--color-primary); }
  .cta-final-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    line-height: 1.15;
    margin: 0;
  }
  .cta-final-card--praticien .cta-final-card__title { color: #fff; }
  .cta-final-card--hote      .cta-final-card__title { color: var(--color-text); }
  .cta-final-card__desc {
    font-size: 0.96rem;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }
  .cta-final-card--praticien .cta-final-card__desc { color: rgba(255,255,255,0.8); }
  .cta-final-card--hote      .cta-final-card__desc { color: var(--color-text-soft); }
  .cta-final-card__sub {
    font-size: 0.82rem;
    margin: 0;
    opacity: 0.6;
  }
  .cta-final-card .btn { align-self: flex-start; }

  /* Responsive */
  @media (max-width: 860px) {
    .explication-grid {
      grid-template-columns: 1fr;
    }
    .explication-arrow {
      transform: rotate(90deg);
      font-size: 1.4rem;
    }
    .stats-visual {
      grid-template-columns: 1fr;
    }
    .stats-secondary {
      flex-direction: column;
      gap: 20px;
      padding: 24px;
    }
    .stat-secondary-sep {
      width: 100%;
      height: 1px;
      margin: 0;
    }
    .search-fields-row {
      grid-template-columns: 1fr;
    }
    .cta-final-grid {
      grid-template-columns: 1fr;
    }
    .cta-final-card {
      padding: 36px 28px;
    }
  }
</style>

<script>
  // Mémoriser la recherche dans sessionStorage
  const form = document.getElementById('home-search-form') as HTMLFormElement;
  const metierInput = document.getElementById('search-metier') as HTMLInputElement;
  const locInput = document.getElementById('search-loc') as HTMLInputElement;

  // Restaurer les valeurs sauvegardées
  const savedMetier = sessionStorage.getItem('search_metier');
  const savedLoc    = sessionStorage.getItem('search_loc');
  if (savedMetier && metierInput) metierInput.value = savedMetier;
  if (savedLoc    && locInput)    locInput.value    = savedLoc;

  // Sauvegarder avant de soumettre
  form?.addEventListener('submit', () => {
    sessionStorage.setItem('search_metier', metierInput?.value || '');
    sessionStorage.setItem('search_loc',    locInput?.value    || '');
  });
</script>
