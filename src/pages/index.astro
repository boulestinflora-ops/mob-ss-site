<script>
import { loadHomepageStats } from '../lib/homepage-stats';
// Charger les stats quand le DOM est prêt (évite de bloquer le LCP)
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => loadHomepageStats());
} else {
  loadHomepageStats();
}
</script>

<script is:inline>
  // Compteur animé — démarre uniquement quand la section est visible (IntersectionObserver)
  // Évite l'animation hors-viewport lors des chargements lents.
  function animateCounter(el) {
    const target   = parseInt(el.dataset.count, 10);
    const duration = 1400;
    const step     = Math.ceil(target / (duration / 16));
    let current    = 0;
    const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { el.textContent = target.toLocaleString('fr-FR'); return; }
    const timer = setInterval(() => {
      current = Math.min(current + step, target);
      el.textContent = current.toLocaleString('fr-FR');
      if (current >= target) clearInterval(timer);
    }, 16);
  }

  const counters = document.querySelectorAll('[data-count]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          observer.unobserve(entry.target);  // déclenche une seule fois
        }
      });
    }, { threshold: 0.3 });
    counters.forEach(el => io.observe(el));
  } else {
    // Fallback navigateurs anciens
    counters.forEach(animateCounter);
  }

  const searchInput = document.getElementById('hero-search');
  if (searchInput) {
    const saved = sessionStorage.getItem('mobss-search');
    if (saved) searchInput.value = saved;
    searchInput.addEventListener('input', () => {
      sessionStorage.setItem('mobss-search', searchInput.value);
    });
    searchInput.closest('form')?.addEventListener('submit', () => {
      sessionStorage.setItem('mobss-search', searchInput.value);
    });
  }

  // Validation search card — au moins un champ requis avant soumission
  const homeForm = document.getElementById('home-search-form');
  if (homeForm) {
    const showError = (msg: string) => {
      let err = document.getElementById('search-error') as HTMLParagraphElement | null;
      if (!err) {
        err = document.createElement('p');
        err.id = 'search-error';
        err.setAttribute('role', 'alert');
        err.setAttribute('aria-live', 'polite');
        err.style.cssText = 'color:var(--color-primary);font-size:0.85rem;text-align:center;margin-top:10px;font-weight:500;';
        homeForm.appendChild(err);
      }
      err.textContent = msg;
    };
    const clearError = () => {
      const err = document.getElementById('search-error');
      if (err) err.textContent = '';
    };
    homeForm.addEventListener('submit', (e: Event) => {
      const metier = (document.getElementById('search-metier') as HTMLInputElement)?.value.trim();
      const loc    = (document.getElementById('search-loc')    as HTMLInputElement)?.value.trim();
      if (!metier && !loc) {
        e.preventDefault();
        showError('Saisissez au moins un critère — métier ou localisation.');
        document.getElementById('search-metier')?.focus();
      }
    });
    ['search-metier', 'search-loc'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', clearError);
    });
  }
</script>
