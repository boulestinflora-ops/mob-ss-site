---
// Page d'accueil — version 6 : section explication, stats visuelles, CTA uniformes
import BaseLayout from '../layouts/BaseLayout.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Step from '../components/Step.astro';
import Icon from '../components/Icon.astro';

import audiences from '../data/audiences.json';
import steps from '../data/steps.json';
---

<BaseLayout
  title="MOB'SS — Des espaces gratuits pour exercer, partout en France"
  description="MOB'SS connecte les espaces inoccupés des collectivités et des entreprises avec les professionnels du sport et de la santé."
  currentPage="accueil"
>

  <!-- HERO -->
  <section class="hero" style="padding:80px 0 120px;">
    <div class="container hero__content">
      <p class="hero__brand-meaning" aria-label="MOB'SS — Mobilité Sport &amp; Santé">
        MOB'SS — <em>Mobilité Sport &amp; Santé</em>
      </p>
      <h1>Des espaces gratuits<br />pour exercer,&nbsp;partout.</h1>
      <p class="lead">
        Kinés, ostéos, coachs sportifs&nbsp;— des communes et des entreprises de votre
        territoire mettent leurs locaux à votre disposition, <strong style="color:var(--color-cream);">gratuitement</strong>.
        Plus besoin de signer un bail pour exercer.
      </p>
      <div class="hero__cta">
        <a href="/explorez" class="btn btn--cream btn--lg">Trouver un espace →</a>
        <a href="/inscription?role=collectivite" class="btn btn--hero-host btn--lg">
          Proposer un local
        </a>
      </div>
      <p class="hero__reassurance">Gratuit · Sans engagement · 100&nbsp;% en ligne</p>
      <p class="hero__why-free">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="opacity:.7;vertical-align:middle;margin-right:4px;"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        MOB'SS est gratuit pour les praticiens car financé par les collectivités et entreprises qui valorisent leurs locaux.
      </p>
    </div>
  </section>

  <!-- SEARCH CARD -->
  <div class="container">
    <div class="search-card" style="margin-top:-60px;position:relative;z-index:5;">
      <h2 style="font-size:clamp(1.15rem,2.5vw,1.45rem);margin-bottom:20px;">Trouvez le lieu idéal pour exercer votre activité.</h2>
      <form class="search-form" id="home-search-form" action="/explorez" method="get">
        <div class="search-fields-row">
          <div class="search-field">
            <Icon name="search" width={20} height={20} />
            <input id="search-metier" type="text" name="metier" placeholder="Votre métier (kiné, coach, ostéo…)" />
          </div>
          <div class="search-field">
            <Icon name="map-pin" width={20} height={20} />
            <input id="search-loc" type="text" name="loc" placeholder="Ville, département, région…" />
          </div>
        </div>
        <div style="text-align:center;margin-top:16px;">
          <button type="submit" class="btn btn--primary btn--lg" style="padding:14px 48px;font-size:1.05rem;">
            Rechercher un espace
          </button>
        </div>
      </form>
      <p style="text-align:center;margin:14px 0 0;font-size:0.88rem;color:var(--color-text-soft);">
        Affinez ensuite par région, type d'espace, équipements…
      </p>
    </div>
  </div>

  <!-- LIVE STATS — compteur en temps réel -->
  <div class="container">
    <div class="live-stats" aria-label="Statistiques de la plateforme">
      <div class="live-stats__item">
        <span class="live-stats__dot" aria-hidden="true"></span>
        <strong id="stat-espaces">—</strong>&nbsp;espaces disponibles
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-praticiens">—</strong>&nbsp;praticiens inscrits
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-communes">—</strong>&nbsp;communes partenaires
      </div>
    </div>
  </div>

  <!-- SECTION EXPLICATION DU PROJET -->
  <section class="section section--white" style="padding:80px 0 72px;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Le concept MOB'SS</span>
        <h2>Des locaux inutilisés. Des praticiens qui cherchent où exercer.<br/>La solution s'appelle MOB'SS — <em>Mobilité Sport &amp; Santé</em>.</h2>
      </header>
      <div class="explication-grid">
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">🏢</div>
          <h3>Des espaces qui dorment</h3>
          <p>En France, des gymnases, salles de réunion et locaux municipaux restent vides une grande partie de la semaine. Ce sont des ressources publiques qui n'attendent qu'une chose : être utiles.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block explication-block--highlight">
          <div class="explication-icon" aria-hidden="true">🤝</div>
          <h3>MOB'SS fait le lien</h3>
          <p>Notre conviction&nbsp;: le manque d'accès aux soins n'est pas qu'un problème de formation. C'est aussi un problème de loyers et de géographie. MOB'SS attaque ce problème à la racine.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">🏃</div>
          <h3>Des praticiens libres d'exercer</h3>
          <p>Kinés, coachs, ostéopathes, sophrologues… exercent dans des conditions professionnelles, sans loyer ni bail. Ils peuvent aller là où leurs patients ont besoin d'eux — pas où le marché immobilier les contraint.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PUBLICS -->
  <section class="section section--alt" style="padding-top:72px;padding-bottom:80px;">
    <div class="container">
      <header class="section__header">
        <h2>Une réponse adaptée à chaque acteur du territoire</h2>
        <p class="section__lead">
          MOB'SS rassemble praticiens, collectivités et entreprises autour d'un même objectif :
          rendre le sport et la santé accessibles partout, sans barrière financière.
        </p>
      </header>
      <div class="grid grid--3">
        {audiences.map(audience => <AudienceCard {...audience} />)}
      </div>
    </div>
  </section>

  <!-- 3 ÉTAPES -->
  <section class="section section--cream">
    <div class="container">
      <header class="section__header">
        <h2>Comment ça marche</h2>
        <p class="section__lead">
          Exercez dans des conditions professionnelles, sans les contraintes d'un bail.
          En trois étapes, depuis n'importe où.
        </p>
      </header>
      <div class="steps">
        {steps.map(step => <Step {...step} />)}
      </div>
      <div class="text-center mt-32" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/explorez" class="btn btn--primary btn--lg">Chercher un espace maintenant</a>
        <a href="/comment-ca-marche" class="btn btn--ghost" style="font-size:0.95rem;">En savoir plus →</a>
      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGES — preuve sociale bêta -->
  <section class="section section--white" style="padding:72px 0;">
    <div class="container">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Ils utilisent MOB'SS</span>
        <h2>Ce que disent nos premiers utilisateurs</h2>
      </header>
      <div class="testimonials-grid">

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "En deux jours j'avais trouvé un cabinet à Rouen pour mes consultations de kinésithérapie. Je n'aurais jamais cru que c'était aussi simple — et surtout aussi gratuit."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">MA</div>
            <div>
              <strong>Marie-Axelle B.</strong>
              <span>Kinésithérapeute · Rouen (76)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card testimonial-card--highlight">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "Notre salle polyvalente était vide 5 jours sur 7. Aujourd'hui elle accueille un sophrologue et un coach sportif. L'impact sur les habitants de la commune est concret."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">JL</div>
            <div>
              <strong>Jean-Luc M.</strong>
              <span>Directeur général des services · Mairie de Bernay (27)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "Je me suis installé comme ostéopathe sans payer de loyer pendant les 4 premiers mois. Ça m'a permis de construire ma patientèle sereinement avant de signer un bail."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">TC</div>
            <div>
              <strong>Thomas C.</strong>
              <span>Ostéopathe · Le Havre (76)</span>
            </div>
          </div>
        </div>

      </div>
      <p class="testimonials-disclaimer">Témoignages recueillis auprès de bêta-testeurs MOB'SS.</p>
    </div>
  </section>

  <!-- POURQUOI MOB'SS — chiffres visuels -->
  <section class="section section--white" style="padding:80px 0;">
    <div class="container">
      <header class="section__header">
        <span class="section__eyebrow">Pourquoi MOB'SS, et pourquoi maintenant</span>
        <h2>Un problème national.<br/>Une solution locale.</h2>
        <p class="section__lead">
          Sédentarité, déserts médicaux, espaces inoccupés, manque d'accès au sport&nbsp;—
          trois enjeux convergent pour faire de MOB'SS une nécessité.
        </p>
      </header>

      <!-- Chiffres clés — 3 stats impactantes -->
      <div class="stats-visual">
        <div class="stat-visual-card stat-visual-card--red">
          <div class="stat-visual-card__value">5 M m²</div>
          <div class="stat-visual-card__label">de bureaux vacants rien qu'en Île-de-France</div>
          <div class="stat-visual-card__source">JLL — Q4 2024</div>
        </div>
        <div class="stat-visual-card stat-visual-card--dark">
          <div class="stat-visual-card__value">−7 ans</div>
          <div class="stat-visual-card__label">d'espérance de vie en bonne santé dus à la sédentarité</div>
          <div class="stat-visual-card__source">Santé Publique France</div>
        </div>
        <div class="stat-visual-card stat-visual-card--cream">
          <div class="stat-visual-card__value">0 €</div>
          <div class="stat-visual-card__label">de loyer pour le praticien — modèle gracieux</div>
          <div class="stat-visual-card__source">Modèle MOB'SS</div>
        </div>
      </div>

      <!-- Stats secondaires -->
      <div class="stats-secondary">
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">65 %</span>
          <span class="stat-secondary-item__label">des salariés favorables au sport au travail</span>
          <span class="stat-secondary-item__source">Étude Ifop 2023</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">13 %</span>
          <span class="stat-secondary-item__label">de vacance commerciale en centre-ville</span>
          <span class="stat-secondary-item__source">Baromètre Procos 2024</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">60 %</span>
          <span class="stat-secondary-item__label">de réduction d'impôt pour les entreprises mécènes</span>
          <span class="stat-secondary-item__source">Article 238 bis CGI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL — double audience -->
  <section class="section cta-final-section" style="padding:80px 0;">
    <div class="container">
      <div class="cta-final-grid">

        <!-- Praticien -->
        <div class="cta-final-card cta-final-card--praticien">
          <span class="cta-final-card__eyebrow">Vous êtes praticien</span>
          <h2 class="cta-final-card__title">Trouvez un espace dès aujourd'hui</h2>
          <p class="cta-final-card__desc">Exercez dans des conditions professionnelles sans les contraintes d'un cabinet fixe. Vos prochains patients vous attendent — trouvez l'espace qui leur permettra de vous rejoindre.</p>
          <a href="/explorez" class="btn btn--cream btn--lg">Parcourir les espaces →</a>
          <p class="cta-final-card__sub">Inscription gratuite · 2 min · Sans engagement</p>
        </div>

        <!-- Hôte -->
        <div class="cta-final-card cta-final-card--hote">
          <span class="cta-final-card__eyebrow">Vous avez un espace</span>
          <h2 class="cta-final-card__title">Donnez vie à vos locaux inutilisés</h2>
          <p class="cta-final-card__desc">Collectivité, entreprise, association — vos salles inoccupées peuvent accueillir des professionnels de sant�