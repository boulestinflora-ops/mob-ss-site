---
// Page d'accueil — version 6 : section explication, stats visuelles, CTA uniformes
import BaseLayout from '../layouts/BaseLayout.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Step from '../components/Step.astro';
import Icon from '../components/Icon.astro';

import audiences from '../data/audiences.json';
import steps from '../data/steps.json';
---

<BaseLayout
  title="MOB'SS — Rendre le sport et la santé accessibles à tous"
  description="MOB'SS connecte les professionnels de santé et du sport avec les espaces inutilisés des collectivités et entreprises — gratuitement, partout en France."
  currentPage="accueil"
>

  <!-- HERO -->
  <section class="hero" style="padding:80px 0 120px;">
    <div class="container hero__content">
      <p class="hero__brand-meaning" aria-label="MOB'SS — Mobilité Sport &amp; Santé">
        MOB'SS — <em>Mobilité Sport &amp; Santé</em>
      </p>
      <h1>Des espaces gratuits<br />pour exercer, partout.</h1>
      <p class="lead">
        Des espaces conformes, vérifiés, mis à disposition
        <strong style="color:var(--color-cream);">gratuitement</strong>
        par des collectivités et entreprises partenaires — dans les territoires qui manquent de professionnels.
        Zéro loyer. Zéro bail.
      </p>
      <div class="hero__cta">
        <a href="/inscription?role=praticien" class="btn btn--cream btn--lg">Je veux exercer</a>
        <a href="/hotes" class="btn btn--hero-host">
          Je propose un espace →
        </a>
      </div>
      <div class="hero__trust-strip" aria-label="Garanties MOB'SS">
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          0 € de loyer
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Espaces vérifiés
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Inscription en 2 min
        </span>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Sans engagement
        </span>
      </div>
    </div>
  </section>

  <!-- SEARCH CARD -->
  <div class="container">
    <div class="search-card" style="margin-top:-60px;position:relative;z-index:5;">
      <h2 style="font-size:clamp(1.15rem,2.5vw,1.45rem);margin-bottom:20px;">Trouvez le lieu idéal pour exercer votre activité.</h2>
      <form class="search-form" id="home-search-form" action="/explorez" method="get">
        <div class="search-fields-row">
          <div class="search-field">
            <Icon name="search" width={20} height={20} />
            <input id="search-metier" type="text" name="metier" placeholder="Votre métier (kiné, coach, ostéo…)" />
          </div>
          <div class="search-field">
            <Icon name="map-pin" width={20} height={20} />
            <input id="search-loc" type="text" name="loc" placeholder="Ville, département, région…" />
          </div>
        </div>
        <div style="text-align:center;margin-top:16px;">
          <button type="submit" class="btn btn--primary btn--lg" style="padding:14px 48px;font-size:1.05rem;">
            Rechercher un espace
          </button>
        </div>
      </form>
      <p style="text-align:center;margin:14px 0 0;font-size:0.88rem;color:var(--color-text-soft);">
        Affinez ensuite par région, type d'espace, équipements…
      </p>
    </div>
  </div>

  <!-- LIVE STATS — compteur en temps réel -->
  <div class="container">
    <div class="live-stats" aria-label="Statistiques de la plateforme">
      <div class="live-stats__item">
        <span class="live-stats__dot" aria-hidden="true"></span>
        <strong id="stat-espaces">—</strong>&nbsp;espaces disponibles
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-praticiens">—</strong>&nbsp;praticiens inscrits
      </div>
      <div class="live-stats__sep" aria-hidden="true"></div>
      <div class="live-stats__item">
        <strong id="stat-communes">—</strong>&nbsp;communes partenaires
      </div>
    </div>
  </div>

  <!-- SECTION EXPLICATION DU PROJET -->
  <section class="section section--cream" style="padding:80px 0 72px;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Le paradoxe français</span>
        <h2>Des millions de Français sans accès aux soins.<br/>Des milliers de salles vides.<br/><em>Comment est-ce possible dans le même pays ?</em></h2>
      </header>
      <div class="explication-grid">
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">🏢</div>
          <h3>Des espaces inutilisés partout</h3>
          <p>Bureaux, salles communales, cabinets partagés — en France, ces espaces sont inoccupés en moyenne <strong>65 % du temps</strong>. Des ressources disponibles, souvent à quelques minutes de chez vous.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block explication-block--highlight explication-block--center">
          <div class="explication-icon" aria-hidden="true">🤝</div>
          <h3>MOB'SS fait le lien</h3>
          <p>La barrière numéro&nbsp;1 pour exercer là où on a besoin de vous&nbsp;? <strong>L'absence d'espace adapté sur place.</strong> MOB'SS connecte les lieux disponibles avec les professionnels qui en ont besoin — gratuitement.</p>
        </div>
        <div class="explication-arrow" aria-hidden="true">→</div>
        <div class="explication-block">
          <div class="explication-icon" aria-hidden="true">🏃</div>
          <h3>Exercez où vous êtes attendu</h3>
          <p>Kiné, coach sportif, ostéopathe, infirmier, psychologue — peu importe votre spécialité, MOB'SS vous donne accès à des espaces conformes près de vos patients, <strong>sans bail ni loyer</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PUBLICS -->
  <section class="section section--alt" style="padding-top:72px;padding-bottom:80px;">
    <div class="container">
      <header class="section__header">
        <h2>Une plateforme, trois acteurs, un territoire en mouvement</h2>
        <p class="section__lead">
          Praticien sans espace fixe ou gestionnaire d'un local inoccupé —
          il y a une place pour vous dans l'écosystème MOB'SS.
        </p>
      </header>
      <div class="grid grid--3">
        {audiences.map(audience => <AudienceCard {...audience} />)}
      </div>
    </div>
  </section>

  <!-- 3 ÉTAPES -->
  <section class="section section--cream">
    <div class="container">
      <header class="section__header">
        <h2>Comment ça marche</h2>
        <p class="section__lead">
          Exercez dans des conditions professionnelles, sans les contraintes d'un bail.
          En trois étapes, depuis n'importe où.
        </p>
      </header>
      <div class="steps">
        {steps.map(step => <Step {...step} />)}
      </div>
      <div class="text-center mt-32" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/inscription?role=praticien" class="btn btn--primary btn--lg">Créer mon profil praticien →</a>
        <a href="/comment-ca-marche" class="btn btn--ghost" style="font-size:0.95rem;">En savoir plus →</a>
      </div>
    </div>
  </section>

  <!-- TIMELINE — parcours concret post-inscription -->
  <section class="section section--white journey-section">
    <div class="container" style="max-width:900px;">
      <header class="section__header" style="margin-bottom:48px;">
        <span class="section__eyebrow">Ce qui se passe concrètement</span>
        <h2>Votre première semaine avec MOB'SS</h2>
        <p class="section__lead">Pas de rendez-vous, pas de dossier, pas d'attente. Voilà ce qui se passe vraiment après votre inscription.</p>
      </header>

      <div class="journey-timeline">

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Aujourd'hui</span>
            <h3 class="journey-step__title">Vous créez votre profil en 2 minutes</h3>
            <p class="journey-step__desc">Spécialité, zone géographique, disponibilités. Rien de plus pour commencer. Vos documents professionnels peuvent être ajoutés plus tard.</p>
          </div>
        </div>

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Dans l'heure</span>
            <h3 class="journey-step__title">Vous parcourez les espaces disponibles</h3>
            <p class="journey-step__desc">Filtrez par région, équipements (table de massage, tapis, vestiaires…), superficie et jours. Chaque annonce est vérifiée et accompagnée de photos réelles.</p>
          </div>
        </div>

        <div class="journey-step">
          <div class="journey-step__marker">
            <div class="journey-step__dot"></div>
            <div class="journey-step__line"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when">Sous 48h</span>
            <h3 class="journey-step__title">L'hôte confirme votre demande</h3>
            <p class="journey-step__desc">Vous envoyez une demande en un clic. L'hôte — collectivité ou entreprise — reçoit votre profil et répond rapidement. Pas de négociation de loyer, c'est gratuit par principe.</p>
          </div>
        </div>

        <div class="journey-step journey-step--last">
          <div class="journey-step__marker">
            <div class="journey-step__dot journey-step__dot--final"></div>
          </div>
          <div class="journey-step__content">
            <span class="journey-step__when journey-step__when--final">Cette semaine</span>
            <h3 class="journey-step__title">Vous exercez. C'est tout.</h3>
            <p class="journey-step__desc">Un espace conforme, des patients qui vous attendent, zéro loyer, zéro bail, zéro charge fixe. Vous vous déplacez — MOB'SS a fait le reste.</p>
            <a href="/inscription?role=praticien" class="btn btn--primary journey-cta">Je m'inscris maintenant →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGES — preuve sociale bêta -->
  <section class="section section--white" style="padding:72px 0;">
    <div class="container">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Ils utilisent MOB'SS</span>
        <h2>Ce que disent nos premiers utilisateurs</h2>
      </header>
      <div class="testimonials-grid">

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "En deux jours j'avais trouvé un cabinet à Rouen pour mes consultations de kinésithérapie. Je n'aurais jamais cru que c'était aussi simple — et surtout aussi gratuit."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">MA</div>
            <div>
              <strong>Marie-Axelle B.</strong>
              <span>Kinésithérapeute · Rouen (76)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card testimonial-card--highlight">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "Notre salle polyvalente était vide 5 jours sur 7. Aujourd'hui elle accueille un sophrologue et un coach sportif. L'impact sur les habitants de la commune est concret."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">JL</div>
            <div>
              <strong>Jean-Luc M.</strong>
              <span>Directeur général des services · Mairie de Bernay (27)</span>
            </div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-card__stars" aria-label="5 étoiles">★★★★★</div>
          <blockquote class="testimonial-card__quote">
            "Je me suis installé comme ostéopathe sans payer de loyer pendant les 4 premiers mois. Ça m'a permis de construire ma patientèle sereinement avant de signer un bail."
          </blockquote>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar" aria-hidden="true">TC</div>
            <div>
              <strong>Thomas C.</strong>
              <span>Ostéopathe · Le Havre (76)</span>
            </div>
          </div>
        </div>

      </div>
      <p class="testimonials-disclaimer">Témoignages recueillis auprès de bêta-testeurs MOB'SS.</p>
    </div>
  </section>

  <!-- AMBASSADEURS — faire grandir la communauté -->
  <section class="section section--cream ambassador-section">
    <div class="container">
      <div class="ambassador-card">
        <div class="ambassador-text">
          <span class="section__eyebrow">Rejoignez le mouvement</span>
          <h2 class="ambassador-title">Aidez-nous à faire grandir<br/>la communauté</h2>
          <p class="ambassador-desc">
            Vous connaissez un praticien qui cherche un espace ? Partagez MOB'SS autour de vous —
            chaque recommandation aide un professionnel à exercer dans de meilleures conditions.
          </p>
          <div class="ambassador-actions">
            <button id="copy-link-btn" class="btn btn--primary ambassador-copy-btn" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-link-label">Copier le lien</span>
            </button>
            <a href="/inscription" class="btn btn--outline ambassador-join-btn">S'inscrire maintenant</a>
          </div>
        </div>
        <div class="ambassador-qr">
          <p class="ambassador-qr-label">Scanner pour partager</p>
          <div class="ambassador-qr-img-wrap">
            <img
              src="https://api.qrserver.com/v1/create-qr-code/?size=128x128&data=https%3A%2F%2Fmobss.vercel.app%2Finscription&bgcolor=faf7f2&color=1a1a2e&margin=2&qzone=1"
              alt="QR code — s'inscrire sur MOB'SS"
              width="128"
              height="128"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="ambassador-qr-url">mobss.vercel.app/inscription</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // Copy link button
      var btn = document.getElementById('copy-link-btn');
      var label = document.getElementById('copy-link-label');
      if (btn && label) {
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText('https://mobss.vercel.app/inscription').then(function () {
            label.textContent = 'Lien copié !';
            btn.classList.add('ambassador-copy-btn--success');
            setTimeout(function () {
              label.textContent = 'Copier le lien';
              btn.classList.remove('ambassador-copy-btn--success');
            }, 2500);
          }).catch(function () {
            label.textContent = 'mobss.vercel.app/inscription';
            setTimeout(function () { label.textContent = 'Copier le lien'; }, 3000);
          });
        });
      }
    })();
  </script>

  <!-- POURQUOI MOB'SS — chiffres visuels -->
  <section class="section section--white" style="padding:80px 0;">
    <div class="container">
      <header class="section__header">
        <span class="section__eyebrow">Pourquoi MOB'SS, et pourquoi maintenant</span>
        <h2>Des données qui parlent.<br/>Une urgence réelle.</h2>
        <p class="section__lead">
          MOB'SS ne part pas d'une intuition — elle part d'un constat chiffré issu de
          quatre études nationales (IFOP/Qare 2025, Croix-Rouge/CRÉDOC 2025, MACSF 2023).
        </p>
      </header>

      <!-- Chiffres clés — 3 stats impactantes -->
      <div class="stats-visual">
        <div class="stat-visual-card stat-visual-card--red">
          <div class="stat-visual-card__value">44 %</div>
          <div class="stat-visual-card__label">des Français estiment vivre dans un désert médical</div>
          <div class="stat-visual-card__source">Croix-Rouge / CRÉDOC, 2025</div>
        </div>
        <div class="stat-visual-card stat-visual-card--dark">
          <div class="stat-visual-card__value">64 %</div>
          <div class="stat-visual-card__label">des médecins iraient exercer en désert médical si un espace était disponible</div>
          <div class="stat-visual-card__source">MACSF, 2023</div>
        </div>
        <div class="stat-visual-card stat-visual-card--cream">
          <div class="stat-visual-card__value">0 €</div>
          <div class="stat-visual-card__label">de loyer pour accéder aux espaces MOB'SS — mise à disposition gracieuse</div>
          <div class="stat-visual-card__source">Modèle MOB'SS — gratuit pour les praticiens</div>
        </div>
      </div>

      <!-- Stats secondaires -->
      <div class="stats-secondary">
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">76 %</span>
          <span class="stat-secondary-item__label">des Français estiment que l'accès aux soins s'est dégradé en 10 ans</span>
          <span class="stat-secondary-item__source">IFOP / Qare, avril 2025</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">65 %</span>
          <span class="stat-secondary-item__label">des surfaces de bureaux sont vides la majeure partie du temps</span>
          <span class="stat-secondary-item__source">Données occupation bureaux, 2023</span>
        </div>
        <div class="stat-secondary-sep"></div>
        <div class="stat-secondary-item">
          <span class="stat-secondary-item__value">1 sur 3</span>
          <span class="stat-secondary-item__label">des Français a déjà renoncé à des soins</span>
          <span class="stat-secondary-item__source">Croix-Rouge / CRÉDOC, 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL — double audience -->
  <section class="section cta-final-section" style="padding:80px 0;">
    <div class="container">
      <div class="cta-final-grid">

        <!-- Praticien -->
        <div class="cta-final-card cta-final-card--praticien">
          <span class="cta-final-card__eyebrow">Vous êtes professionnel de santé ou du sport</span>
          <h2 class="cta-final-card__title">Exercez là où vos patients ont besoin de vous</h2>
          <p class="cta-final-card__desc">Médecins, kinésithérapeutes, coachs, diététiciens… Trouvez des espaces conformes, réservez vos créneaux et développez votre patientèle — sans loyer, sans bail, sans contrainte géographique.</p>
          <a href="/inscription?role=praticien" class="btn btn--cream btn--lg">Créer mon profil gratuitement →</a>
          <p class="cta-final-card__sub">Inscription gratuite · Sans engagement · 2 min</p>
        </div>

        <!-- Hôte -->
        <div class="cta-final-card cta-final-card--hote">
          <span class="cta-final-card__eyebrow">Vous avez un espace à proposer</span>
          <h2 class="cta-final-card__title">Vos espaces inutilisés deviennent des ressources pour votre territoire</h2>
          <p class="cta-final-card__desc">Collectivités, entreprises, bailleurs — vos salles de réunion, gymnases et locaux inoccupés peuvent accueillir des professionnels de santé et générer un impact social concret sur vos habitants.</p>
          <a href="/inscription?role=collectivite" class="btn btn--primary btn--lg">Déposer un espace →</a>
          <p class="cta-final-card__sub">Gratuit · Accompagnement inclus</p>
        </div>

      </div>
    </div>
  </section>

  <!-- BANDEAU DOCTOLIB — discret, juste avant le footer -->
  <div class="doctolib-banner">
    <span>👤 Vous êtes patient·e ?</span>
    <span style="color:var(--color-text-soft);">MOB'SS est réservé aux professionnels. Pour prendre rendez-vous :</span>
    <a href="https://www.doctolib.fr" target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="white-space:nowrap;">
      Aller sur Doctolib →
    </a>
  </div>

</BaseLayout>

<style>
  /* Recherche — inputs sur une ligne, bouton en dessous centré */
  .search-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* Section explication */
  .explication-grid {
    display: grid;
    grid-template-columns: 1fr 40px 1fr 40px 1fr;
    gap: 8px;
    align-items: center;
  }
  .explication-block {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
  }
  .explication-block--highlight {
    background: #fff;
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: 0 4px 20px rgba(181,48,64,.12);
  }
  .explication-block--center h3 { color: var(--color-primary); }
  .explication-block--highlight p { color: var(--color-text-soft); }
  .explication-icon {
    font-size: 2.2rem;
    margin-bottom: 14px;
    line-height: 1;
  }
  .explication-block h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .explication-block p { color: var(--color-text-soft); font-size: 0.93rem; margin: 0; line-height: 1.55; }
  .explication-arrow {
    text-align: center;
    font-size: 1.8rem;
    color: var(--color-primary);
    font-weight: 700;
    opacity: 0.5;
  }

  /* Stats visuelles — 3 grandes cartes colorées */
  .stats-visual {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  .stat-visual-card {
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stat-visual-card--red {
    background: var(--color-primary);
    color: #fff;
  }
  .stat-visual-card--dark {
    background: var(--color-text);
    color: #fff;
  }
  .stat-visual-card--cream {
    background: var(--color-cream);
    color: var(--color-primary-dark);
  }
  .stat-visual-card__value {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-visual-card--red   .stat-visual-card__value { color: #fff; }
