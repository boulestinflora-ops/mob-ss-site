---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import stats from '../data/stats.json';
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Accueil","item":"https://mobss.fr/"},
    {"@type":"ListItem","position":2,"name":"Le problème","item":"https://mobss.fr/le-probleme"}
  ]
});
const articleLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Un paradoxe au cœur des territoires",
  "description": "76 % des Français estiment que l'accès aux soins s'est dégradé. Pourtant, 65 % des espaces professionnels sont vides.",
  "author": {"@type":"Organization","name":"MOB\'SS","url":"https://mobss.fr"},
  "publisher": {"@type":"Organization","name":"MOB\'SS","url":"https://mobss.fr"},
  "url": "https://mobss.fr/le-probleme",
  "inLanguage": "fr-FR"
});

---

<BaseLayout
  title="Désert médical en France : le problème — MOB'SS"
  description="Déserts médicaux, espaces vides : le paradoxe français analysé en chiffres. MOB'SS explore le problème et ses solutions concrètes."
  currentPage="probleme"
>
  <Fragment slot="head" set:html={`<script type="application/ld+json">${breadcrumbLd}</script><script type="application/ld+json">${articleLd}</script>`} />


  <!-- HERO -->
  <PageHero
    eyebrow="Notre étude de marché"
    title="Un paradoxe au cœur des territoires"
    lead="En France, des millions de personnes n'ont plus accès à un médecin ou à une activité sportive encadrée. Dans le même temps, des milliers de salles et d'espaces restent vides la majeure partie du temps. Le problème n'est pas un manque de professionnels — c'est un manque de mise en relation."
  />

  <!-- STATS CHOC -->
  <section class="section section--white" style="padding:64px 0;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">Le contexte en chiffres</span>
        <h2>Des données qui parlent</h2>
        <p class="section__lead">
          Sources&nbsp;: IFOP/Qare, avril&nbsp;2025 (n&nbsp;=&nbsp;4&nbsp;007)&nbsp;·
          Croix-Rouge française&nbsp;/ CRÉDOC, 2025&nbsp;·
          Enquête MACSF, sept.&nbsp;2023 (n&nbsp;=&nbsp;1&nbsp;632)&nbsp;·
          Données occupation bureaux France, 2023
        </p>
      </header>

      <!-- 3 grandes stats -->
      <div class="stats-grid">
        <div class="stat-card stat-card--red">
          <div class="stat-card__value">76 %</div>
          <div class="stat-card__label">des Français estiment que l'accès aux soins s'est dégradé au cours des 10 dernières années</div>
          <div class="stat-card__source">IFOP&nbsp;/ Qare, avril&nbsp;2025</div>
        </div>
        <div class="stat-card stat-card--dark">
          <div class="stat-card__value">44 %</div>
          <div class="stat-card__label">des Français estiment vivre dans un désert médical, soit 6 à 8 millions de personnes</div>
          <div class="stat-card__source">Croix-Rouge&nbsp;/ CRÉDOC, 2025</div>
        </div>
        <div class="stat-card stat-card--cream">
          <div class="stat-card__value">× 2</div>
          <div class="stat-card__label">Le nombre de passages aux urgences a doublé en 25 ans — de 10 à 20 millions par an</div>
          <div class="stat-card__source">Données hospitalières</div>
        </div>
      </div>

      <!-- Stats secondaires -->
      <div class="stats-row">
        <div class="stat-row-item">
          <span class="stat-row-item__val">1 sur 3</span>
          <span class="stat-row-item__lbl">des Français a déjà renoncé à des soins</span>
          <span class="stat-row-item__src">Croix-Rouge&nbsp;/ CRÉDOC, 2025</span>
        </div>
        <div class="stats-row__sep"></div>
        <div class="stat-row-item">
          <span class="stat-row-item__val">70 %</span>
          <span class="stat-row-item__lbl">citent les délais d'attente trop longs comme principale difficulté</span>
          <span class="stat-row-item__src">IFOP&nbsp;/ Qare, avril&nbsp;2025</span>
        </div>
        <div class="stats-row__sep"></div>
        <div class="stat-row-item">
          <span class="stat-row-item__val">70 %</span>
          <span class="stat-row-item__lbl">jugent nécessaires les dispositifs mobiles de santé</span>
          <span class="stat-row-item__src">Croix-Rouge&nbsp;/ CRÉDOC, 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LE PARADOXE -->
  <section class="section section--alt" style="padding:64px 0;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:48px;">
        <span class="section__eyebrow">Le paradoxe</span>
        <h2>Des professionnels prêts à venir.<br/>Des espaces qui attendent.</h2>
      </header>

      <div class="paradox-grid">
        <!-- Côté espaces vides -->
        <div class="paradox-card paradox-card--space">
          <div class="paradox-card__icon" aria-hidden="true">🏢</div>
          <h3>Des espaces inoccupés</h3>
          <div class="paradox-big-stat">65 %</div>
          <p>des surfaces de bureaux, salles de réunion et locaux communaux sont vides la majeure partie du temps. Le pic d'occupation ne dépasse pas 63 % — les mardis et mercredis seulement.</p>
          <p class="paradox-card__source">Données occupation bureaux France, 2023</p>
        </div>

        <div class="paradox-arrow" aria-hidden="true">
          <svg viewBox="0 0 60 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 12 L50 12 M40 4 L50 12 L40 20" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Côté professionnels -->
        <div class="paradox-card paradox-card--pro">
          <div class="paradox-card__icon" aria-hidden="true">🩺</div>
          <h3>Des professionnels prêts</h3>
          <div class="paradox-big-stat">64 %</div>
          <p>des médecins généralistes seraient prêts à aller exercer en désert médical <strong>si un espace adapté était disponible sur place</strong>. 84 % n'ont jamais entendu parler d'une solution pour organiser cela.</p>
          <p class="paradox-card__source">Enquête MACSF, sept.&nbsp;2023</p>
        </div>
      </div>

      <div class="paradox-conclusion">
        <p>
          <strong>Le problème n'est donc pas un manque de professionnels.</strong>
          C'est un manque de mise en relation. Les espaces disponibles ne trouvent pas les praticiens qui en ont besoin —
          et inversement. MOB'SS est né pour combler exactement ce vide.
        </p>
      </div>
    </div>
  </section>

  <!-- DÉSERTS MÉDICAUX -->
  <section class="section section--white" style="padding:64px 0;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">La réalité du terrain</span>
        <h2>Les déserts médicaux, une urgence territoriale</h2>
      </header>
      <div class="desert-grid">
        <div class="desert-item">
          <div class="desert-item__num">N° 1</div>
          <p>La santé est la <strong>première préoccupation</strong> des Français, devant le pouvoir d'achat</p>
          <span class="desert-item__src">Croix-Rouge&nbsp;/ CRÉDOC, 2025</span>
        </div>
        <div class="desert-item">
          <div class="desert-item__num">1 sur 3</div>
          <p>des communes françaises est en désert médical, soit <strong>6 à 8 millions</strong> de personnes touchées</p>
          <span class="desert-item__src">Croix-Rouge&nbsp;/ CRÉDOC, 2025</span>
        </div>
        <div class="desert-item">
          <div class="desert-item__num">29 %</div>
          <p>évoquent une <strong>distance trop importante</strong> — ce chiffre monte à 36–37 % en commune rurale</p>
          <span class="desert-item__src">IFOP&nbsp;/ Qare, avril&nbsp;2025</span>
        </div>
        <div class="desert-item">
          <div class="desert-item__num">84 %</div>
          <p>des médecins n'ont <strong>jamais entendu parler</strong> d'une structure organisant des consultations ponctuelles hors cabinet</p>
          <span class="desert-item__src">MACSF, 2023</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    title="MOB'SS apporte une réponse concrète"
    subtitle="Une plateforme numérique qui connecte les espaces disponibles avec les professionnels qui en ont besoin — gratuitement, partout en France."
    primaryLabel="Voir la solution →"
    primaryHref="/notre-solution"
    secondaryLabel="Notre impact →"
    secondaryHref="/notre-impact"
  />

</BaseLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }
  .stat-card {
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stat-card--red   { background: var(--color-primary); color: #fff; }
  .stat-card--dark  { background: var(--color-text); color: #fff; }
  .stat-card--cream { background: var(--color-cream); color: var(--color-primary-dark); }
  .stat-card__value {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-card--red   .stat-card__value { color: #fff; }
  .stat-card--dark  .stat-card__value { color: var(--color-cream); }
  .stat-card--cream .stat-card__value { color: var(--color-primary); }
  .stat-card__label { font-size: 1rem; font-weight: 500; line-height: 1.4; opacity: .9; }
  .stat-card__source { font-size: 0.78rem; opacity: .6; margin-top: auto; }

  /* Stats row */
  .stats-row {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px 32px;
  }
  .stat-row-item { flex: 1; display: flex; flex-direction: column; gap: 4px; text-align: center; }
  .stat-row-item__val { font-size: 1.8rem; font-weight: 800; color: var(--color-primary); line-height: 1; }
  .stat-row-item__lbl { font-size: 0.88rem; color: var(--color-text); line-height: 1.4; }
  .stat-row-item__src { font-size: 0.75rem; color: var(--color-text-soft); }
  .stats-row__sep { width: 1px; height: 56px; background: var(--color-border); margin: 0 24px; flex-shrink: 0; }

  /* Paradox */
  .paradox-grid {
    display: grid;
    grid-template-columns: 1fr 60px 1fr;
    gap: 12px;
    align-items: center;
    margin-bottom: 32px;
  }
  .paradox-card {
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    border: 1px solid var(--color-border);
    background: #fff;
  }
  .paradox-card--space { border-top: 4px solid var(--color-text-soft); }
  .paradox-card--pro   { border-top: 4px solid var(--color-primary); }
  .paradox-card__icon { font-size: 2.2rem; margin-bottom: 12px; }
  .paradox-card h3 { font-size: 1.1rem; margin-bottom: 12px; }
  .paradox-card p { color: var(--color-text-soft); font-size: 0.95rem; line-height: 1.6; margin: 0 0 8px; }
  .paradox-card__source { font-size: 0.78rem; color: var(--color-text-soft); opacity: .7; }
  .paradox-big-stat {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 12px;
  }
  .paradox-arrow { display: flex; justify-content: center; align-items: center; }
  .paradox-arrow svg { width: 60px; height: 24px; }
  .paradox-conclusion {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    border-left: 4px solid var(--color-primary);
  }
  .paradox-conclusion p { margin: 0; font-size: 1.05rem; line-height: 1.65; color: var(--color-text); }

  /* Desert grid */
  .desert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .desert-item {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
  }
  .desert-item__num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 10px;
  }
  .desert-item p { font-size: 0.95rem; line-height: 1.6; color: var(--color-text-soft); margin: 0 0 8px; }
  .desert-item__src { font-size: 0.78rem; color: var(--color-text-soft); opacity: .65; }

  @media (max-width: 860px) {
    .stats-grid { grid-template-columns: 1fr; }
    .stats-row { flex-direction: column; gap: 20px; }
    .stats-row__sep { width: 100%; height: 1px; margin: 0; }
    .paradox-grid { grid-template-columns: 1fr; }
    .paradox-arrow { transform: rotate(90deg); }
    .desert-grid { grid-template-columns: 1fr; }
  }
</style>
