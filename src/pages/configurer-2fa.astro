---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Configurer la double authentification | MOB'SS"
  description="Sécurisez votre compte MOB'SS avec la double authentification."
>
  <section class="section">
    <div class="container" style="max-width:480px;">
      <div class="text-center" style="margin-bottom:32px;">
        <span class="section__eyebrow">Sécurité</span>
        <h1>Double authentification</h1>
        <p style="color:var(--color-text-soft);">Protégez votre compte avec une application d'authentification.</p>
      </div>

      <div class="form-card">
        <div id="setup-message" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:18px;font-size:0.95rem;"></div>

        <!-- Étape 1 : Scanner le QR code -->
        <div id="view-qr">
          <div style="text-align:center;margin-bottom:20px;">
            <div style="font-size:2rem;margin-bottom:8px;">📱</div>
            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin-bottom:8px;">Étape 1 — Scannez le QR code</h2>
            <p style="color:var(--color-text-soft);font-size:0.9rem;">
              Ouvrez <strong>Google Authenticator</strong>, <strong>Authy</strong> ou toute autre application compatible, puis scannez ce code.
            </p>
          </div>

          <!-- QR code -->
          <div id="qr-container" style="display:flex;flex-direction:column;align-items:center;gap:14px;margin:24px 0;">
            <div id="qr-loading" style="color:var(--color-text-soft);font-size:0.9rem;">Génération du QR code…</div>
            <img id="qr-image" src="" alt="QR code 2FA" style="display:none;width:200px;height:200px;border:2px solid var(--color-border);border-radius:var(--radius-md);padding:8px;background:#fff;" />
          </div>

          <!-- Code manuel (fallback) -->
          <details style="margin-bottom:20px;font-size:0.88rem;color:var(--color-text-soft);">
            <summary style="cursor:pointer;color:var(--color-primary);font-weight:600;">Impossible de scanner ? Entrez le code manuellement</summary>
            <div style="margin-top:10px;background:var(--color-bg-soft);border-radius:var(--radius-sm);padding:10px 14px;">
              <code id="secret-key" style="font-size:0.95rem;letter-spacing:0.1em;word-break:break-all;">—</code>
            </div>
          </details>

          <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:16px;text-align:center;">
            Une fois le compte ajouté dans l'application, passez à l'étape suivante.
          </p>

          <button type="button" id="btn-next" class="btn btn--primary btn--block" disabled>
            Suivant →
          </button>
        </div>

        <!-- Étape 2 : Confirmer avec le code -->
        <div id="view-confirm" style="display:none;">
          <div style="text-align:center;margin-bottom:20px;">
            <div style="font-size:2rem;margin-bottom:8px;">🔢</div>
            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin-bottom:8px;">Étape 2 — Confirmez le code</h2>
            <p style="color:var(--color-text-soft);font-size:0.9rem;">
              Saisissez le code à 6 chiffres affiché dans votre application pour finaliser la configuration.
            </p>
          </div>

          <form id="confirm-form" novalidate>
            <div class="field">
              <label for="confirm-code">Code de l'application</label>
              <input
                id="confirm-code"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{6}"
                maxlength="6"
                required
                autocomplete="one-time-code"
                placeholder="123456"
                style="letter-spacing:0.3em;font-size:1.4rem;text-align:center;"
              />
            </div>
            <button type="submit" class="btn btn--primary btn--block btn--lg">Activer la 2FA</button>
          </form>

          <div style="text-align:center;margin-top:16px;">
            <button type="button" id="back-qr" style="background:none;border:none;color:var(--color-primary);font-size:0.9rem;cursor:pointer;">
              ← Retour au QR code
            </button>
          </div>
        </div>

        <!-- Succès -->
        <div id="view-success" style="display:none;text-align:center;padding:12px 0;">
          <div style="font-size:3rem;margin-bottom:12px;">✅</div>
          <h2 style="font-size:1.2rem;font-family:var(--font-body);margin-bottom:8px;">Double authentification activée !</h2>
          <p style="color:var(--color-text-soft);font-size:0.95rem;margin-bottom:24px;">
            Votre compte est maintenant sécurisé. À chaque connexion, un code vous sera demandé.
          </p>
          <a href="/dashboard" class="btn btn--primary btn--block">Accéder à mon espace</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  import { showMessage, hideMessage } from '../lib/forms';

  const msgBox       = document.getElementById('setup-message') as HTMLDivElement;
  const viewQr       = document.getElementById('view-qr')       as HTMLDivElement;
  const viewConfirm  = document.getElementById('view-confirm')  as HTMLDivElement;
  const viewSuccess  = document.getElementById('view-success')  as HTMLDivElement;

  function showMsg(type: 'success' | 'error', text: string) { showMessage(msgBox, type, text); }
  function hideMsg() { hideMessage(msgBox); }

  function showView(view: HTMLDivElement) {
    hideMsg();
    [viewQr, viewConfirm, viewSuccess].forEach(v => v.style.display = 'none');
    view.style.display = '';
  }

  let enrollFactorId  = '';
  let enrollChallengeId = '';

  // ─── Vérifier la session ──────────────────────────────────────────────────────
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) {
    window.location.href = '/connexion?retour=/configurer-2fa';
  }

  // ─── Enrôlement TOTP ─────────────────────────────────────────────────────────
  async function startEnrollment() {
    const qrLoading = document.getElementById('qr-loading') as HTMLDivElement;
    const qrImage   = document.getElementById('qr-image')   as HTMLImageElement;
    const secretKey = document.getElementById('secret-key') as HTMLElement;
    const btnNext   = document.getElementById('btn-next')   as HTMLButtonElement;

    const { data, error } = await supabase.auth.mfa.enroll({ factorType: 'totp', friendlyName: "MOB'SS" });

    if (error || !data) {
      showMsg('error', "Impossible de générer le QR code. Réessayez.");
      return;
    }

    enrollFactorId = data.id;

    // Afficher le QR code
    qrLoading.style.display  = 'none';
    qrImage.src              = data.totp.qr_code;
    qrImage.style.display    = 'block';
    secretKey.textContent    = data.totp.secret;
    btnNext.disabled         = false;
  }

  startEnrollment();

  // Étape 1 → 2
  document.getElementById('btn-next')?.addEventListener('click', async () => {
    hideMsg();

    // Créer un challenge pour la confirmation
    const { data, error } = await supabase.auth.mfa.challenge({ factorId: enrollFactorId });
    if (error) {
      showMsg('error', 'Erreur lors de la vérification. Réessayez.');
      return;
    }
    enrollChallengeId = data.id;
    showView(viewConfirm);
    (document.getElementById('confirm-code') as HTMLInputElement)?.focus();
  });

  // Retour QR
  document.getElementById('back-qr')?.addEventListener('click', () => showView(viewQr));

  // ─── Confirmation du code ─────────────────────────────────────────────────────
  const confirmForm = document.getElementById('confirm-form') as HTMLFormElement;
  if (confirmForm) {
    confirmForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg();

      const code = (document.getElementById('confirm-code') as HTMLInputElement).value.trim();
      if (!code || code.length !== 6) {
        showMsg('error', 'Entrez le code à 6 chiffres.');
        return;
      }

      const btn = confirmForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Vérification…';

      const { error } = await supabase.auth.mfa.verify({
        factorId:    enrollFactorId,
        challengeId: enrollChallengeId,
        code,
      });

      btn.disabled    = false;
      btn.textContent = 'Activer la 2FA';

      if (error) {
        showMsg('error', 'Code incorrect. Vérifiez votre application et réessayez.');
        (document.getElementById('confirm-code') as HTMLInputElement).value = '';
        (document.getElementById('confirm-code') as HTMLInputElement).focus();
        return;
      }

      showView(viewSuccess);
    });

    // Auto-submit à 6 chiffres
    document.getElementById('confirm-code')?.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      input.value = input.value.replace(/\D/g, '').slice(0, 6);
      if (input.value.length === 6) confirmForm.requestSubmit();
    });
  }
</script>
