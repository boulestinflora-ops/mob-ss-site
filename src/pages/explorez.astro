---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const ALL_REGIONS = [
  "Auvergne-Rhône-Alpes","Bourgogne-Franche-Comté","Bretagne",
  "Centre-Val de Loire","Corse","Grand Est","Guadeloupe","Guyane",
  "Hauts-de-France","Île-de-France","La Réunion","Martinique","Mayotte",
  "Normandie","Nouvelle-Aquitaine","Occitanie","Pays de la Loire",
  "Provence-Alpes-Côte d'Azur"
];
const SPACE_TYPES = [
  "Salle communale","Cabinet paramédical","Studio bien-être",
  "Salle de sport","Espace entreprise","Espace extérieur"
];
---

<BaseLayout
  title="Explorez les espaces — MOB'SS"
  description="Trouvez un espace gratuit pour exercer : salles de sport, cabinets médicaux, gymnases mis à disposition par des collectivités et entreprises partout en France."
  currentPage="explorez"
>
  <!-- Hero -->
  <section class="explore-hero">
    <div class="container">
      <span class="section__eyebrow">Espaces disponibles</span>
      <h1>Où souhaitez-vous exercer ?</h1>
      <p>Des espaces mis à disposition gracieusement par des collectivités et des entreprises.</p>
    </div>
  </section>

  <!-- Barre de recherche rapide -->
  <div class="container" style="position:relative;">
    <div class="search-card" style="margin-top:-40px;">
      <form class="search-form" id="search-form">
        <div class="search-field">
          <Icon name="map-pin" width={20} height={20} />
          <input type="text" placeholder="Ville, code postal, région…" id="filter-loc" />
        </div>
        <div class="search-field">
          <Icon name="search" width={20} height={20} />
          <select id="filter-type">
            <option value="">Tous les types d'espace</option>
            {SPACE_TYPES.map(t => <option value={t}>{t}</option>)}
          </select>
        </div>
        <button type="button" class="btn btn--cream" id="search-btn">Rechercher</button>
      </form>
    </div>
  </div>

  <!-- Filtres avancés -->
  <div class="container" style="margin-top:16px;">
    <div class="filters-bar-panel" id="filters-bar-panel">

      <!-- Bouton toggle -->
      <button class="filters-bar-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-bar-body">
        <span style="font-size:1rem;">⚙️</span>
        <span>Filtres avancés</span>
        <span id="filters-active-count" class="filters-active-badge" style="display:none;">0</span>
        <svg class="filters-toggle__chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>

      <div class="filters-bar-body filters-bar-body--closed" id="filters-bar-body">
        <div class="filters-bar-inner">

          <!-- ── Ligne 1 : Localisation avancée ── -->
          <div class="filters-row">

            <div class="filter-h-group">
              <label class="filter-h-label" for="filter-region-h">Région</label>
              <select id="filter-region-h" class="filter-h-select">
                <option value="">Toutes les régions</option>
                {ALL_REGIONS.map(r => <option value={r}>{r}</option>)}
              </select>
            </div>

            <div class="filter-h-group">
              <label class="filter-h-label" for="filter-dept-h">Département</label>
              <select id="filter-dept-h" class="filter-h-select">
                <option value="">Tous les départements</option>
              </select>
            </div>

            <div class="filter-h-group">
              <label class="filter-h-label" for="filter-host-h">Proposé par</label>
              <select id="filter-host-h" class="filter-h-select">
                <option value="">Tous</option>
                <option value="collectivite">🏛 Collectivité</option>
                <option value="entreprise">🏢 Entreprise</option>
              </select>
            </div>

            <div class="filter-h-group">
              <label class="filter-h-label" for="filter-tarif">Tarif</label>
              <select id="filter-tarif" class="filter-h-select">
                <option value="">Tous</option>
                <option value="gratuit">✅ Gratuit</option>
                <option value="payant">💶 Payant</option>
              </select>
            </div>

            <div class="filter-h-group">
              <label class="filter-h-label" for="filter-capacite">Capacité</label>
              <select id="filter-capacite" class="filter-h-select">
                <option value="">Toutes</option>
                <option value="1">1–2 personnes</option>
                <option value="5">Jusqu'à 5</option>
                <option value="10">Jusqu'à 10</option>
                <option value="20">Jusqu'à 20</option>
                <option value="999">20+</option>
              </select>
            </div>

          </div>

          <!-- ── Ligne 2 : Distance ── -->
          <div class="filters-row filters-row--distance">
            <div class="filter-distance-group">
              <label class="filter-h-label">📍 Distance depuis ma ville</label>
              <div class="filter-distance-controls">
                <input type="text" id="filter-ref-city" class="filter-h-input" placeholder="Entrez votre ville de référence…" autocomplete="off" />
                <div class="filter-distance-slider-wrap">
                  <input type="range" id="filter-distance" min="5" max="200" step="5" value="50" class="filter-slider" disabled />
                  <div class="filter-distance-labels">
                    <span>5 km</span>
                    <span id="filter-distance-val" class="filter-distance-current">50 km</span>
                    <span>200 km</span>
                  </div>
                </div>
              </div>
              <p class="filter-hint" id="distance-hint">Entrez une ville pour activer le filtre par distance.</p>
            </div>
          </div>

          <!-- ── Ligne 3 : Superficie ── -->
          <div class="filters-row">
            <div class="filter-h-group filter-h-group--wide">
              <label class="filter-h-label">Superficie</label>
              <div class="filter-chips">
                <label class="filter-chip"><input type="radio" name="filter-superficie" class="filter-sup" value="" checked /> Toutes tailles</label>
                <label class="filter-chip"><input type="radio" name="filter-superficie" class="filter-sup" value="25" /> &lt; 25 m²</label>
                <label class="filter-chip"><input type="radio" name="filter-superficie" class="filter-sup" value="50" /> 25 – 50 m²</label>
                <label class="filter-chip"><input type="radio" name="filter-superficie" class="filter-sup" value="100" /> 50 – 100 m²</label>
                <label class="filter-chip"><input type="radio" name="filter-superficie" class="filter-sup" value="999" /> &gt; 100 m²</label>
              </div>
            </div>
          </div>

          <!-- ── Ligne 4 : Jours disponibles ── -->
          <div class="filters-row">
            <div class="filter-h-group filter-h-group--wide">
              <label class="filter-h-label">Jours disponibles</label>
              <div class="filter-chips">
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="lundi" /> Lun</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="mardi" /> Mar</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="mercredi" /> Mer</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="jeudi" /> Jeu</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="vendredi" /> Ven</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="samedi" /> Sam</label>
                <label class="filter-chip"><input type="checkbox" class="filter-jour" value="dimanche" /> Dim</label>
              </div>
            </div>
          </div>

          <!-- ── Ligne 5 : Équipements ── -->
          <div class="filters-row">
            <div class="filter-h-group filter-h-group--wide">
              <label class="filter-h-label">Équipements disponibles</label>
              <div class="filter-chips">
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Table de massage" /> 🛏 Table de massage</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Tapis" /> 🧘 Tapis</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Matériel sportif" /> 🏋 Matériel sportif</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Miroirs" /> 🪞 Miroirs</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Vestiaires" /> 🚪 Vestiaires</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Douches" /> 🚿 Douches</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Salle d'attente" /> 🪑 Salle d'attente</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Wi-Fi" /> 📶 Wi-Fi</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Parking" /> 🅿 Parking</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="PMR" /> ♿ Accessible PMR</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Sonorisation" /> 🔊 Sonorisation</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Climatisation" /> ❄ Climatisation</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Lumière naturelle" /> ☀ Lumière naturelle</label>
                <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Cuisine" /> 🍵 Cuisine / Kitchenette</label>
              </div>
            </div>
          </div>

          <!-- ── Actions ── -->
          <div class="filters-row filters-row--actions">
            <p id="filters-summary" class="filters-summary"></p>
            <button class="btn btn--outline" id="reset-filters" style="white-space:nowrap;">
              ✕ Tout effacer
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Note démo (visible uniquement quand aucune annonce réelle n'est publiée) -->
  <!-- Aucun espace -->
  <div id="empty-state" class="container" style="display:none;text-align:center;padding:60px 24px;">
    <div style="font-size:3rem;margin-bottom:16px;">🏟️</div>
    <h3>La plateforme démarre !</h3>
    <p style="color:var(--color-text-soft);margin-bottom:24px;">Aucun espace disponible pour le moment.<br/>Vous êtes gestionnaire d'espace ?</p>
    <a href="/deposer-annonce" class="btn btn--primary">Déposer votre espace →</a>
  </div>

  <!-- Erreur chargement -->
  <div id="error-state" class="container" style="display:none;text-align:center;padding:60px 24px;">
    <div style="font-size:3rem;margin-bottom:16px;">⚠️</div>
    <p style="color:var(--color-text-soft);margin-bottom:24px;">Impossible de charger les espaces.</p>
    <button class="btn btn--outline" onclick="(window as any).loadSpaces()">Réessayer</button>
  </div>


  <!-- Layout principal -->
  <section class="section" style="padding-top:16px;">
    <div class="container explore-container">

      <!-- ===== COLONNE GAUCHE : résultats ===== -->
      <div class="explore-left">

        <!-- En-tête résultats -->
        <div class="listing-results__head" style="margin-bottom:16px;">
          <p style="margin:0;color:var(--color-text-soft);">
            <strong id="results-count" style="color:var(--color-text);">… espaces</strong> correspondent à votre recherche
          </p>
          <select id="sort-select" style="padding:8px 12px;border-radius:var(--radius-pill);border:1px solid var(--color-border);font-family:inherit;font-size:0.9rem;background:var(--color-bg);">
            <option value="pertinence">Trier : pertinence</option>
            <option value="distance">📍 Le plus proche</option>
            <option value="superficie-desc">Surface décroissante</option>
            <option value="superficie-asc">Surface croissante</option>
            <option value="gratuit">Gratuit en premier</option>
            <option value="host-collec">Collectivités en premier</option>
            <option value="host-entrep">Entreprises en premier</option>
          </select>
        </div>

        <!-- État chargement -->
        <div id="spaces-loading" style="text-align:center;padding:60px 24px;color:var(--color-text-soft);">
          <div style="font-size:2rem;margin-bottom:10px;">⏳</div>
          <p>Chargement des espaces…</p>
        </div>

        <!-- Grille (remplie dynamiquement) — min-height évite le CLS au chargement -->
        <div class="listing-grid" id="listing-grid" style="display:none;min-height:600px;"></div>

        <!-- État vide filtres -->
        <div id="no-results" style="display:none;text-align:center;padding:56px 24px 40px;">
          <div style="font-size:3rem;margin-bottom:16px;" aria-hidden="true">🔍</div>
          <h3 style="font-size:1.2rem;margin-bottom:8px;">Aucun espace ne correspond à ces critères</h3>
          <p style="color:var(--color-text-soft);max-width:360px;margin:0 auto 28px;line-height:1.6;">
            Essayez d'élargir votre zone géographique, de retirer certains filtres,
            ou revenez plus tard — de nouveaux espaces s'ajoutent régulièrement.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
            <button id="empty-reset-filters" class="btn btn--primary">
              Réinitialiser les filtres
            </button>
            <a href="/deposer-annonce" class="btn btn--outline">
              Vous avez un espace à proposer ? →
            </a>
          </div>
          <p style="margin-top:24px;font-size:0.82rem;color:var(--color-text-soft);">
            <a href="/contact" style="color:var(--color-primary);">Nous contacter</a> si vous cherchez un type d'espace précis.
          </p>
        </div>

        <!-- Bouton charger plus -->
        <div id="load-more-wrap" style="display:none;text-align:center;margin:24px 0;">
          <button id="load-more-spaces" class="btn btn--outline" style="min-width:180px;">
            Charger plus d'espaces
          </button>
        </div>
      </div>

      <!-- Bouton visite guidée flottant -->
      <button class="tour-fab" id="tour-fab-explorez" onclick="window.startTour(window._exploreTourSteps,'mobss_tour_explorez')" aria-label="Lancer la visite guidée">
        🗺️ Visite guidée
      </button>

      <!-- ===== COLONNE DROITE : placeholder carte ===== -->
      <div class="explore-map-col">
        <div class="explore-map-sticky">
          <div class="map-placeholder">
            <div class="map-placeholder__inner">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              <p class="map-placeholder__title">Carte interactive</p>
              <p class="map-placeholder__sub">🚧 En cours de développement</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>


</BaseLayout>

<!-- Visite guidée : script système — defer = non-bloquant, s'exécute après le DOM -->
<script src="/scripts/tour.js" is:inline defer></script>

<!-- Étapes de la visite guidée + auto-lancement (is:inline = exécution immédiate, pas de bundling) -->
<script is:inline>
  window._exploreTourSteps = [
    {
      target: null,
      emoji: '🗺️',
      title: 'Bienvenue sur la page Explorez !',
      content: 'Cette page vous permet de trouver un espace disponible pour exercer votre activité. Laissez-nous vous guider en quelques étapes.',
    },
    {
      target: '.search-card',
      emoji: '🔍',
      title: 'La barre de recherche',
      content: "Tapez une ville, un code postal ou une région pour filtrer les espaces disponibles. Vous pouvez aussi filtrer par type d'espace (cabinet, salle de sport…)",
      position: 'bottom',
    },
    {
      target: '.filters-bar-panel',
      emoji: '⚙️',
      title: 'Filtres avancés',
      content: 'Cliquez sur "Affiner la recherche" pour accéder à des filtres supplémentaires : région, type de propriétaire, équipements disponibles (PMR, vestiaires, Wi-Fi…)',
      position: 'bottom',
    },
    {
      target: '.listing-grid',
      emoji: '🏠',
      title: 'Les espaces disponibles',
      content: 'Chaque carte présente un espace : type, localisation, équipements. Cliquez sur une carte pour voir tous les détails et envoyer une demande.',
      position: 'right',
    },
    {
      target: '.map-placeholder',
      emoji: '📍',
      title: 'La carte interactive',
      content: 'Une carte des espaces sera bientôt disponible pour visualiser les offres près de chez vous. Elle est en cours de développement !',
      position: 'left',
    },
  ];

  // Auto-lancement à la 1ère visite
  // On utilise window.load pour être sûr que tout est prêt (DOM + scripts)
  window.addEventListener('load', function () {
    if (!localStorage.getItem('mobss_tour_explorez')) {
      setTimeout(function () {
        if (typeof window.startTour === 'function') {
          window.startTour(window._exploreTourSteps, 'mobss_tour_explorez');
        }
      }, 600);
    }
  });
</script>

<script>
import { initExplorez } from '../lib/explorez';
initExplorez();
</script>

<style>
  /* ── Placeholder carte ─────────────────────────────────────────────────────── */
  .map-placeholder {
    width: 100%;
    height: calc(100vh - var(--header-h, 88px) - 80px);
    min-height: 400px;
    border-radius: var(--radius-md);
    border: 2px dashed var(--color-border);
    background: var(--color-bg-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-placeholder__inner {
    text-align: center;
    color: var(--color-text-soft);
  }
  .map-placeholder__inner svg {
    color: var(--color-border);
    margin-bottom: 12px;
  }
  .map-placeholder__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 6px;
  }
  .map-placeholder__sub {
    font-size: 0.88rem;
    margin: 0;
  }

  /* ── Tiroir filtres horizontal ─────────────────────────────────────────────── */
  .filters-bar-panel {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .filters-bar-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px 18px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: left;
  }
  .filters-bar-toggle:hover { background: var(--color-bg-soft); }
  .filters-toggle__chevron {
    margin-left: auto;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .filters-bar-body {
    border-top: 1px solid var(--color-border);
    display: block;
  }
  .filters-bar-body--closed {
    display: none;
  }
  .filters-bar-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
    padding: 16px 18px 18px;
  }
  .filter-h-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 140px;
  }
  .filter-h-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .filter-h-select {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    background: #fff;
    min-width: 160px;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: var(--color-cream-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s;
    white-space: nowrap;
  }
  .filter-chip:hover { background: var(--color-cream); border-color: var(--color-primary); }
  .filter-chip input[type="checkbox"],
  .filter-chip input[type="radio"]   { accent-color: var(--color-primary); cursor: pointer; }
  .filter-chip:has(input:checked) {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  /* ── Lignes de filtres ─────────────────────────────────────────────────────── */
  .filters-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: flex-start;
    width: 100%;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--color-border);
  }
  .filters-row:last-child { border-bottom: none; padding-bottom: 0; }

  .filters-row--distance { align-items: stretch; }
  .filters-row--actions  {
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 2px;
  }

  /* ── Groupe large (pleine largeur) ─────────────────────────────────────────── */
  .filter-h-group--wide {
    width: 100%;
    min-width: 0;
  }

  /* ── Input texte (ville de référence) ──────────────────────────────────────── */
  .filter-h-input {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    background: #fff;
    min-width: 200px;
    width: 100%;
    max-width: 280px;
    transition: border-color 0.15s;
  }
  .filter-h-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  /* ── Groupe distance ────────────────────────────────────────────────────────── */
  .filter-distance-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .filter-distance-controls {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .filter-distance-slider-wrap {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* ── Slider range ───────────────────────────────────────────────────────────── */
  .filter-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--color-border);
    outline: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .filter-slider:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .filter-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
    cursor: pointer;
    transition: transform 0.12s;
  }
  .filter-slider:not(:disabled)::-webkit-slider-thumb:hover { transform: scale(1.15); }
  .filter-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid #fff;
