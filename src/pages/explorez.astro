---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceCard from '../components/SpaceCard.astro';
import Icon from '../components/Icon.astro';
import spaces from '../data/spaces.json';

const regions = [...new Set(spaces.map(s => s.region))].sort();
const types   = [...new Set(spaces.map(s => s.type))].sort();
---

<BaseLayout
  title="Explorez les espaces — MOB'SS"
  description="Trouvez un espace gratuit pour exercer votre activité de sport ou de santé en Normandie — mis à disposition par des collectivités et entreprises."
  currentPage="explorez"
>
  <!-- Hero -->
  <section class="explore-hero">
    <div class="container">
      <span class="section__eyebrow">Espaces disponibles</span>
      <h1>Où souhaitez-vous exercer ?</h1>
      <p>Des espaces mis à disposition gracieusement par des collectivités et des entreprises.</p>
    </div>
  </section>

  <!-- Barre de recherche rapide -->
  <div class="container" style="position:relative;">
    <div class="search-card" style="margin-top:-40px;">
      <form class="search-form" id="search-form">
        <div class="search-field">
          <Icon name="map-pin" width={20} height={20} />
          <input type="text" placeholder="Ville, code postal, région…" id="filter-loc" />
        </div>
        <div class="search-field">
          <Icon name="search" width={20} height={20} />
          <select id="filter-type">
            <option value="">Tous les types d'espace</option>
            {types.map(t => <option value={t}>{t}</option>)}
          </select>
        </div>
        <button type="button" class="btn btn--cream" id="search-btn">Rechercher</button>
      </form>
    </div>
  </div>

  <!-- Filtres avancés — tiroir horizontal collapsible -->
  <div class="container" style="margin-top:16px;">
    <div class="filters-bar-panel" id="filters-bar-panel">
      <button class="filters-bar-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-bar-body">
        <span style="font-size:1rem;">⚙️</span>
        <span>Affiner la recherche</span>
        <svg class="filters-toggle__chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>

      <div class="filters-bar-body filters-bar-body--closed" id="filters-bar-body">
        <div class="filters-bar-inner">

          <div class="filter-h-group">
            <label class="filter-h-label" for="filter-region-h">Région</label>
            <select id="filter-region-h" class="filter-h-select">
              <option value="">Toutes</option>
              {regions.map(r => <option value={r}>{r}</option>)}
            </select>
          </div>

          <div class="filter-h-group">
            <label class="filter-h-label" for="filter-host-h">Proposé par</label>
            <select id="filter-host-h" class="filter-h-select">
              <option value="">Tous</option>
              <option value="collectivite">Collectivité</option>
              <option value="entreprise">Entreprise</option>
            </select>
          </div>

          <div class="filter-h-group">
            <label class="filter-h-label">Équipements</label>
            <div class="filter-chips">
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Table de massage" /> Table de massage</label>
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Tapis" /> Tapis</label>
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Vestiaires" /> Vestiaires</label>
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Wi-Fi" /> Wi-Fi</label>
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="Parking" /> Parking</label>
              <label class="filter-chip"><input type="checkbox" class="filter-equip" value="PMR" /> PMR</label>
            </div>
          </div>

          <button class="btn btn--outline" id="reset-filters" style="align-self:flex-end;white-space:nowrap;">
            Tout effacer
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Note exemples -->
  <div class="container" style="margin-top:8px;">
    <p style="font-size:0.82rem;color:var(--color-text-soft);font-style:italic;">
      ℹ️ Les espaces ci-dessous sont présentés à titre d'exemple pour illustrer le fonctionnement de la plateforme. Les annonces réelles seront disponibles dès l'ouverture.
    </p>
  </div>

  <!-- Layout principal -->
  <section class="section" style="padding-top:16px;">
    <div class="container explore-container">

      <!-- ===== COLONNE GAUCHE : résultats ===== -->
      <div class="explore-left">

        <!-- En-tête résultats -->
        <div class="listing-results__head" style="margin-bottom:16px;">
          <p style="margin:0;color:var(--color-text-soft);">
            <strong id="results-count" style="color:var(--color-text);">{spaces.length} espaces</strong> correspondent à votre recherche
          </p>
          <select id="sort-select" style="padding:8px 12px;border-radius:var(--radius-pill);border:1px solid var(--color-border);font-family:inherit;font-size:0.9rem;">
            <option value="pertinence">Trier par : pertinence</option>
            <option value="region">Région A → Z</option>
            <option value="type">Type d'espace</option>
            <option value="host-collec">Collectivités en premier</option>
            <option value="host-entrep">Entreprises en premier</option>
          </select>
        </div>

        <!-- Grille -->
        <div class="listing-grid" id="listing-grid">
          {spaces.map(space => <SpaceCard {...space} />)}
        </div>

        <p id="no-results" style="display:none;text-align:center;color:var(--color-text-soft);padding:40px 0;">
          Aucun espace ne correspond à ces critères. Essayez d'élargir votre recherche.
        </p>
      </div>

      <!-- Bouton visite guidée flottant -->
      <button class="tour-fab" id="tour-fab-explorez" onclick="window.startTour(window._exploreTourSteps,'mobss_tour_explorez')" aria-label="Lancer la visite guidée">
        🗺️ Visite guidée
      </button>

      <!-- ===== COLONNE DROITE : placeholder carte ===== -->
      <div class="explore-map-col">
        <div class="explore-map-sticky">
          <div class="map-placeholder">
            <div class="map-placeholder__inner">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              <p class="map-placeholder__title">Carte interactive</p>
              <p class="map-placeholder__sub">🚧 En cours de développement</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>


</BaseLayout>

<!-- Étapes de la visite guidée + auto-lancement (is:inline = exécution immédiate, pas de bundling) -->
<script is:inline>
  window._exploreTourSteps = [
    {
      target: null,
      emoji: '🗺️',
      title: 'Bienvenue sur la page Explorez !',
      content: 'Cette page vous permet de trouver un espace disponible pour exercer votre activité. Laissez-nous vous guider en quelques étapes.',
    },
    {
      target: '.search-card',
      emoji: '🔍',
      title: 'La barre de recherche',
      content: "Tapez une ville, un code postal ou une région pour filtrer les espaces disponibles. Vous pouvez aussi filtrer par type d'espace (cabinet, salle de sport…)",
      position: 'bottom',
    },
    {
      target: '.filters-bar-panel',
      emoji: '⚙️',
      title: 'Filtres avancés',
      content: 'Cliquez sur "Affiner la recherche" pour accéder à des filtres supplémentaires : région, type de propriétaire, équipements disponibles (PMR, vestiaires, Wi-Fi…)',
      position: 'bottom',
    },
    {
      target: '.listing-grid',
      emoji: '🏠',
      title: 'Les espaces disponibles',
      content: 'Chaque carte présente un espace : type, localisation, équipements. Cliquez sur une carte pour voir tous les détails et envoyer une demande.',
      position: 'right',
    },
    {
      target: '.map-placeholder',
      emoji: '📍',
      title: 'La carte interactive',
      content: 'Une carte des espaces sera bientôt disponible pour visualiser les offres près de chez vous. Elle est en cours de développement !',
      position: 'left',
    },
  ];

  // Auto-lancement à la 1ère visite
  // On utilise window.load pour être sûr que tout est prêt (DOM + scripts)
  window.addEventListener('load', function () {
    if (!localStorage.getItem('mobss_tour_explorez')) {
      setTimeout(function () {
        if (typeof window.startTour === 'function') {
          window.startTour(window._exploreTourSteps, 'mobss_tour_explorez');
        }
      }, 600);
    }
  });
</script>

<script>
// ─── Données des espaces (pour les filtres) ───────────────────────────────────
const SPACES = [
  { id: "salle-mairie-caen",       city: "Caen",                  department: "14", region: "Normandie", type: "Salle communale",     host: "collectivite", tags: ["50 m²","PMR","Vestiaires"] },
  { id: "cabinet-rouen-centre",    city: "Rouen",                 department: "76", region: "Normandie", type: "Cabinet paramédical", host: "entreprise",   tags: ["18 m²","Table de massage","PMR"] },
  { id: "studio-cherbourg",        city: "Cherbourg-en-Cotentin", department: "50", region: "Normandie", type: "Studio bien-être",    host: "collectivite", tags: ["22 m²","Tapis fournis","Wi-Fi"] },
  { id: "salle-sport-le-havre",    city: "Le Havre",              department: "76", region: "Normandie", type: "Salle de sport",      host: "entreprise",   tags: ["80 m²","Matériel inclus","Parking"] },
  { id: "salle-bayeux",            city: "Bayeux",                department: "14", region: "Normandie", type: "Salle communale",     host: "collectivite", tags: ["45 m²","PMR","Sonorisation"] },
  { id: "cabinet-evreux",          city: "Évreux",                department: "27", region: "Normandie", type: "Cabinet paramédical", host: "entreprise",   tags: ["20 m²","Table de massage","Wi-Fi"] },
  { id: "studio-yoga-alencon",     city: "Alençon",               department: "61", region: "Normandie", type: "Studio bien-être",    host: "collectivite", tags: ["30 m²","Tapis fournis","PMR"] },
  { id: "salle-omnisports-dieppe", city: "Dieppe",                department: "76", region: "Normandie", type: "Salle de sport",      host: "collectivite", tags: ["120 m²","Vestiaires","PMR"] },
];

// ─── Restaurer la recherche depuis sessionStorage ─────────────────────────────
(function restoreSearch() {
  const loc    = sessionStorage.getItem('search_loc')    || '';
  const metier = sessionStorage.getItem('search_metier') || '';
  const locInput = document.getElementById('filter-loc') as HTMLInputElement | null;
  if (locInput) {
    if (loc)         locInput.value = loc;
    else if (metier) locInput.value = metier;
  }
})();

// ─── Toggle filtres avancés ───────────────────────────────────────────────────
const toggleBtn   = document.getElementById('filters-toggle');
const filtersBody = document.getElementById('filters-bar-body');
toggleBtn?.addEventListener('click', () => {
  const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
  toggleBtn.setAttribute('aria-expanded', String(!isOpen));
  filtersBody?.classList.toggle('filters-bar-body--closed', isOpen);
  const chevron = toggleBtn.querySelector('.filters-toggle__chevron') as SVGElement | null;
  if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
});

// ─── Filtres liste ────────────────────────────────────────────────────────────
const grid         = document.getElementById('listing-grid') as HTMLElement;
const noResults    = document.getElementById('no-results')   as HTMLElement;
const resultsCount = document.getElementById('results-count') as HTMLElement;
const cards        = Array.from(grid.querySelectorAll('article.space-card')) as HTMLElement[];

function getActiveFilters() {
  return {
    loc:    (document.getElementById('filter-loc')      as HTMLInputElement  | null)?.value.toLowerCase().trim() || '',
    type:   (document.getElementById('filter-type')     as HTMLSelectElement | null)?.value || '',
    region: (document.getElementById('filter-region-h') as HTMLSelectElement | null)?.value || '',
    host:   (document.getElementById('filter-host-h')   as HTMLSelectElement | null)?.value || '',
    equip:  Array.from(document.querySelectorAll('.filter-equip:checked')).map((cb: any) => cb.value as string),
  };
}

function applyFilters() {
  const f = getActiveFilters();
  let visible = 0;
  SPACES.forEach((space, i) => {
    const card = cards[i];
    if (!card) return;
    const show =
      (!f.loc    || space.city.toLowerCase().includes(f.loc) || space.region.toLowerCase().includes(f.loc) || space.department.includes(f.loc)) &&
      (!f.type   || space.type === f.type) &&
      (!f.region || space.region === f.region) &&
      (!f.host   || space.host === f.host) &&
      (f.equip.length === 0 || f.equip.every((eq: string) => space.tags.some((tag: string) => tag.toLowerCase().includes(eq.toLowerCase()))));
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (resultsCount) resultsCount.textContent = `${visible} espace${visible > 1 ? 's' : ''}`;
  if (noResults)    noResults.style.display = visible === 0 ? 'block' : 'none';
  if (grid)         grid.style.display      = visible === 0 ? 'none'  : '';
}

['filter-loc', 'filter-type', 'filter-region-h', 'filter-host-h'].forEach(id => {
  document.getElementById(id)?.addEventListener('input', applyFilters);
  document.getElementById(id)?.addEventListener('change', applyFilters);
});
document.querySelectorAll('.filter-equip').forEach(el => el.addEventListener('change', applyFilters));
document.getElementById('search-btn')?.addEventListener('click', applyFilters);
document.getElementById('reset-filters')?.addEventListener('click', () => {
  (document.getElementById('filter-loc')      as HTMLInputElement  | null) && ((document.getElementById('filter-loc')      as HTMLInputElement).value  = '');
  (document.getElementById('filter-type')     as HTMLSelectElement | null) && ((document.getElementById('filter-type')     as HTMLSelectElement).value = '');
  (document.getElementById('filter-region-h') as HTMLSelectElement | null) && ((document.getElementById('filter-region-h') as HTMLSelectElement).value = '');
  (document.getElementById('filter-host-h')   as HTMLSelectElement | null) && ((document.getElementById('filter-host-h')   as HTMLSelectElement).value = '');
  document.querySelectorAll('.filter-equip').forEach((cb: any) => { cb.checked = false; });
  applyFilters();
});

// ─── Pré-remplissage depuis les query params de l'accueil ─────────────────────
const params = new URLSearchParams(window.location.search);
const metier = params.get('metier')?.trim() || '';
const loc    = params.get('loc')?.trim()    || '';
const type   = params.get('type')?.trim()   || '';
const locInput   = document.getElementById('filter-loc')  as HTMLInputElement  | null;
const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
let changed = false;
if (loc && locInput)                       { locInput.value = loc;    changed = true; }
if (metier && locInput && !locInput.value) { locInput.value = metier; changed = true; }
if (type && typeSelect) {
  const match = Array.from(typeSelect.options).find(o =>
    o.value.toLowerCase().includes(type.toLowerCase()) || o.text.toLowerCase().includes(type.toLowerCase())
  );
  if (match) { typeSelect.value = match.value; changed = true; }
}
if (changed) applyFilters();
</script>

<style>
  /* ── Placeholder carte ─────────────────────────────────────────────────────── */
  .map-placeholder {
    width: 100%;
    height: calc(100vh - var(--header-h, 88px) - 80px);
    min-height: 400px;
    border-radius: var(--radius-md);
    border: 2px dashed var(--color-border);
    background: var(--color-bg-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-placeholder__inner {
    text-align: center;
    color: var(--color-text-soft);
  }
  .map-placeholder__inner svg {
    color: var(--color-border);
    margin-bottom: 12px;
  }
  .map-placeholder__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 6px;
  }
  .map-placeholder__sub {
    font-size: 0.88rem;
    margin: 0;
  }

  /* ── Tiroir filtres horizontal ─────────────────────────────────────────────── */
  .filters-bar-panel {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .filters-bar-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px 18px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: left;
  }
  .filters-bar-toggle:hover { background: var(--color-bg-soft); }
  .filters-toggle__chevron {
    margin-left: auto;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .filters-bar-body {
    border-top: 1px solid var(--color-border);
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.25s ease;
    max-height: 500px;
    opacity: 1;
  }
  .filters-bar-body--closed {
    max-height: 0;
    opacity: 0;
    border-top: none;
  }
  .filters-bar-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
    padding: 16px 18px 18px;
  }
  .filter-h-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 140px;
  }
  .filter-h-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .filter-h-select {
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    background: #fff;
    min-width: 160px;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .filter-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: var(--color-cream-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s;
    white-space: nowrap;
  }
  .filter-chip:hover { background: var(--color-cream); border-color: var(--color-primary); }
  .filter-chip input[type="checkbox"] { accent-color: var(--color-primary); cursor: pointer; }
</style>
