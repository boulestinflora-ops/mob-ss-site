---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connexion — MOB'SS"
  description="Connectez-vous à votre espace MOB'SS."
>
  <section class="section">
    <div class="container" style="max-width:480px;">
      <div class="text-center" style="margin-bottom:32px;">
        <span class="section__eyebrow">Connexion</span>
        <h1>Heureux de vous revoir</h1>
        <p style="color:var(--color-text-soft);">Connectez-vous à votre espace MOB'SS</p>
      </div>

      <div class="form-card">
        <!-- Zone de message (erreur ou succès) -->
        <div id="login-message" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:18px;font-size:0.95rem;"></div>

        <!-- Vue : formulaire de connexion (par défaut) -->
        <div id="view-login">
          <form id="login-form" novalidate>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="username" placeholder="vous@exemple.fr" />
            </div>

            <div class="field">
              <label for="mdp">Mot de passe</label>
              <input id="mdp" name="password" type="password" required autocomplete="current-password" minlength="8" />
            </div>

            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:18px;font-size:0.9rem;">
              <label class="option" style="display:flex;gap:6px;margin:0;align-items:center;">
                <input type="checkbox" /> Se souvenir de moi
              </label>
              <div style="text-align:center;">
                <button type="button" id="show-reset" style="background:none;border:none;color:var(--color-primary);font-size:0.9rem;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px;">
                  Mot de passe oublié&nbsp;?
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn--primary btn--block btn--lg">Se connecter</button>
          </form>

          <div style="text-align:center;margin-top:24px;color:var(--color-text-soft);">
            Pas encore de compte&nbsp;? <a href="/inscription">Créer un compte</a>
          </div>
        </div>

        <!-- Vue : réinitialisation du mot de passe -->
        <div id="view-reset" style="display:none;">
          <h2 style="font-size:1.15rem;font-family:var(--font-body);margin-bottom:8px;">Réinitialiser le mot de passe</h2>
          <p style="color:var(--color-text-soft);font-size:0.95rem;margin-bottom:20px;">
            Entrez votre adresse email. Vous recevrez un lien pour choisir un nouveau mot de passe.
          </p>

          <form id="reset-form" novalidate>
            <div class="field">
              <label for="reset-email">Email</label>
              <input id="reset-email" type="email" required autocomplete="email" placeholder="vous@exemple.fr" />
            </div>
            <button type="submit" class="btn btn--primary btn--block">Envoyer le lien</button>
          </form>

          <div style="text-align:center;margin-top:16px;">
            <button type="button" id="back-login" style="background:none;border:none;color:var(--color-primary);font-size:0.9rem;cursor:pointer;">
              ← Retour à la connexion
            </button>
          </div>
        </div>

        <!-- Vue : renvoi de l'email de confirmation -->
        <div id="view-resend" style="display:none;">
          <h2 style="font-size:1.15rem;font-family:var(--font-body);margin-bottom:8px;">Renvoyer l'email de confirmation</h2>
          <p style="color:var(--color-text-soft);font-size:0.95rem;margin-bottom:20px;">
            Votre email n'a pas encore été confirmé. Entrez votre adresse et nous vous renvoyons le lien.
          </p>

          <form id="resend-form" novalidate>
            <div class="field">
              <label for="resend-email">Email</label>
              <input id="resend-email" type="email" required autocomplete="email" placeholder="vous@exemple.fr" />
            </div>
            <button type="submit" class="btn btn--primary btn--block">Renvoyer l'email</button>
          </form>

          <div style="text-align:center;margin-top:16px;">
            <button type="button" id="back-login-resend" style="background:none;border:none;color:var(--color-primary);font-size:0.9rem;cursor:pointer;">
              ← Retour à la connexion
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  import { showMessage, hideMessage, markError, clearErrors, validateEmail } from '../lib/forms';

  const messageBox  = document.getElementById('login-message') as HTMLDivElement;
  const viewLogin   = document.getElementById('view-login')   as HTMLDivElement;
  const viewReset   = document.getElementById('view-reset')   as HTMLDivElement;
  const viewResend  = document.getElementById('view-resend')  as HTMLDivElement;

  // Alias courts pour ce fichier
  function showMsg(type: 'success' | 'error', text: string) { showMessage(messageBox, type, text); }
  function hideMsg() { hideMessage(messageBox); }

  function showView(view: HTMLDivElement) {
    hideMsg();
    [viewLogin, viewReset, viewResend].forEach(v => v.style.display = 'none');
    view.style.display = '';
  }

  // ─── Bascule entre les vues ───────────────────────────────────────────────────
  document.getElementById('show-reset')?.addEventListener('click', () => showView(viewReset));
  document.getElementById('back-login')?.addEventListener('click', () => showView(viewLogin));
  document.getElementById('back-login-resend')?.addEventListener('click', () => showView(viewLogin));

  // ─── Connexion ────────────────────────────────────────────────────────────────
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg();

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const mdp   = (document.getElementById('mdp')   as HTMLInputElement).value;

      clearErrors('email', 'mdp');
      let hasError = false;
      if (!email)             { markError('email', 'L\'email est requis.'); hasError = true; }
      else if (!validateEmail(email)) { markError('email', 'Adresse email invalide.'); hasError = true; }
      if (!mdp)               { markError('mdp', 'Le mot de passe est requis.'); hasError = true; }
      if (hasError) return;

      const btn = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Connexion…';

      const { error } = await supabase.auth.signInWithPassword({ email, password: mdp });

      btn.disabled    = false;
      btn.textContent = 'Se connecter';

      if (error) {
        if (error.message.includes('Invalid login credentials') || error.message.includes('invalid_credentials')) {
          showMsg('error', 'Email ou mot de passe incorrect.');
        } else if (error.message.includes('Email not confirmed')) {
          // Pré-remplir le champ email dans la vue "renvoyer" et afficher celle-ci
          const resendEmailInput = document.getElementById('resend-email') as HTMLInputElement;
          if (resendEmailInput) resendEmailInput.value = email;
          showView(viewResend);
          showMessage(
            document.getElementById('login-message') as HTMLDivElement,
            'error',
            "Votre email n'a pas encore été confirmé. Renvoyez le lien ci-dessous."
          );
        } else {
          showMsg('error', `Erreur : ${error.message}`);
        }
        return;
      }

      // Redirige vers la page d'origine si ?retour= présent, sinon dashboard
      const retourParam = new URLSearchParams(window.location.search).get('retour');
      window.location.href = retourParam ? decodeURIComponent(retourParam) : '/dashboard';
    });
  }

  // ─── Réinitialisation du mot de passe ────────────────────────────────────────
  const resetForm = document.getElementById('reset-form') as HTMLFormElement;
  if (resetForm) {
    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg();

      const email = (document.getElementById('reset-email') as HTMLInputElement).value.trim();
      if (!email) { showMsg('error', 'Entrez votre adresse email.'); return; }

      const btn = resetForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Envoi…';

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/reset-password`,
      });

      btn.disabled    = false;
      btn.textContent = 'Envoyer le lien';

      if (error) {
        showMsg('error', `Erreur : ${error.message}`);
      } else {
        showMsg('success', `✓ Email envoyé à ${email}. Vérifiez votre boîte de réception (et vos spams).`);
        resetForm.reset();
      }
    });
  }

  // ─── Renvoi de l'email de confirmation ───────────────────────────────────────
  const resendForm = document.getElementById('resend-form') as HTMLFormElement;
  if (resendForm) {
    resendForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = (document.getElementById('resend-email') as HTMLInputElement).value.trim();
      if (!email) { showMsg('error', 'Entrez votre adresse email.'); return; }

      const btn = resendForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Envoi…';

      const { error } = await supabase.auth.resend({
        type: 'signup',
        email,
        options: { emailRedirectTo: `${window.location.origin}/completer-profil` },
      });

      btn.disabled    = false;
      btn.textContent = 'Renvoyer l\'email';

      if (error) {
        showMsg('error', `Erreur : ${error.message}`);
      } else {
        showMsg('success', \`✓ Email de confirmation renvoyé à ${email}. Vérifiez vos spams si besoin.\`);
      }
    });
  }
</script>
