            </div>
          </Panel>
          <Panel title="Notifications">
            <div style="display:flex;flex-direction:column;gap:16px;">
              <div class="toggle-row"><div><strong>Emails de confirmation</strong><p>Recevoir un email à chaque changement de statut</p></div><label class="toggle-switch"><input type="checkbox" id="notif-email" checked disabled /><span class="toggle-slider"></span></label></div>
              <p style="font-size:0.8rem;color:var(--color-text-soft);margin:0;">Les préférences de notification avancées seront disponibles prochainement.</p>
            </div>
          </Panel>
          <Panel style="border-color:#FCA5A5;">
            <div class="panel__head"><h3 style="color:#B91C1C;">Zone de danger</h3></div>
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:14px;">
              <div><strong style="display:block;font-size:0.92rem;">Supprimer mon compte</strong><span style="font-size:0.85rem;color:var(--color-text-soft);">Cette action est irréversible. Toutes vos données seront effacées.</span></div>
              <a href="/contact?sujet=suppression-compte" class="btn" style="background:#FEE2E2;color:#B91C1C;font-size:0.88rem;border:1px solid #FCA5A5;">Demander la suppression</a>
            </div>
            <hr style="border:none;border-top:1px solid #FCA5A5;margin:0 0 14px;" />
            <button id="btn-logout-param" class="btn btn--outline" style="color:var(--color-primary);font-size:0.9rem;">Se déconnecter</button>
          </Panel>
        </div>
      </div>

    </div><!-- /dash-main -->
  </div><!-- /dash-layout -->
</div><!-- /dash-praticien -->

