              <div class="param-row"><div class="param-row__label">Rôle</div><div id="param-role" class="param-row__value">—</div></div>
              <div class="param-row"><div class="param-row__label">Membre depuis</div><div id="param-date" class="param-row__value">—</div></div>
              <div class="param-row"><div class="param-row__label">Identifiant</div><div id="param-id" class="param-row__value" style="font-size:0.78rem;color:var(--color-text-soft);font-family:monospace;">—</div></div>
