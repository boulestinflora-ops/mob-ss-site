  .cal-detail-event--refused  { background:#FBE5E5; border-color:#A02323; }
  .cal-detail-event__space { font-weight:600; font-size:0.9rem; margin-bottom:4px; }
  .cal-detail-event__meta  { font-size:0.82rem; color:var(--color-text-soft); }
  .doc-tabs { display:flex; gap:4px; margin-bottom:20px; border-bottom:2px solid var(--color-border); }
  .doc-tab { background:none; border:none; padding:10px 18px; font-size:0.9rem; font-family:var(--font-body); font-weight:500; color:var(--color-text-soft); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; border-radius:var(--radius-sm) var(--radius-sm) 0 0; transition:color 0.15s,border-color 0.15s,background 0.15s; }
  .doc-tab:hover { background:var(--color-bg-soft); color:var(--color-text); }
  .doc-tab--active { color:var(--color-primary); border-bottom-color:var(--color-primary); font-weight:600; }
  .privacy-block { display:flex; gap:16px; padding:16px 0; border-bottom:1px solid var(--color-border); }
  .privacy-block:last-child { border-bottom:none; }
  .privacy-block__icon { font-size:1.5rem; flex-shrink:0; margin-top:2px; }
  .privacy-block strong { display:block; font-size:0.92rem; margin-bottom:6px; }
  .privacy-block p { margin:0; font-size:0.87rem; color:var(--color-text-soft); line-height:1.55; }
