  .doc-badge--ok      { background:#E8F4EA; color:#2D6E3F; border:1px solid #B8DBC0; }
  .doc-badge--missing { background:#FFF8DC; color:#6B5800; border:1px solid #E8D87A; }
  .doc-badge--expired { background:#FBE5E5; color:#A02323; border:1px solid #F0B8B8; }
  .pf-header { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:20px; flex-wrap:wrap; }
  .pf-avatar { border-radius:50%; background:var(--color-primary); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; overflow:hidden; border:3px solid var(--color-border); flex-shrink:0; }
  .pf-avatar img { width:100%; height:100%; object-fit:cover; }
  .pf-preview-card { padding:24px; }
  .pf-preview__hero { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
  .pf-preview__badges { display:flex; flex-direction:column; gap:6px; margin-left:auto; }
  .pf-badge-vis { font-size:0.75rem; padding:3px 9px; border-radius:20px; font-weight:600; white-space:nowrap; }
  .pf-badge-vis--on  { background:#D1FAE5; color:#065F46; }
  .pf-badge-vis--off { background:#F3F4F6; color:#6B7280; }
  .pf-preview__body { display:flex; flex-direction:column; gap:10px; }
  .pf-preview__row { display:flex; align-items:center; gap:10px; font-size:0.9rem; }
  .pf-preview__icon { width:20px; text-align:center; flex-shrink:0; }
  .pf-vis-tag { margin-left:auto; font-size:0.72rem; padding:2px 7px; border-radius:12px; font-weight:600; }
  .pf-completude__track { flex:1; height:6px; background:var(--color-border); border-radius:6px; overflow:hidden; min-width:60px; }
  .pf-completude__fill { height:100%; background:var(--color-primary); border-radius:6px; transition:width 0.4s ease,background 0.4s; width:0%; }
  .pf-modal { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px; }
  .pf-modal__backdrop { position:absolute; inset:0; background:rgba(0,0,0,0.45); backdrop-filter:blur(3px); }
  .pf-modal__panel { position:relative; z-index:1; background:var(--color-bg); border-radius:var(--radius-lg); width:100%; max-width:820px; max-height:90vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,0.2); overflow:hidden; }
  .pf-modal__header { display:flex; align-items:center; justify-content:space-between; padding:18px 24px; border-bottom:1px solid var(--color-border); flex-shrink:0; }
  .pf-modal__close { width:32px; height:32px; border-radius:50%; border:none; background:var(--color-border); color:var(--color-text); cursor:pointer; font-size:0.9rem; display:flex; align-items:center; justify-content:center; transition:background 0.15s; }
  .pf-modal__close:hover { background:#ccc; }
  .pf-modal__body { padding:24px; overflow-y:auto; flex:1; }
  .pf-modal__avatar-row { display:flex; align-items:center; gap:18px; }
  .pf-hero__avatar-wrap { position:relative; flex-shrink:0; }
  .pf-avatar__edit { position:absolute; bottom:-2px; right:-2px; width:26px; height:26px; border-radius:50%; background:var(--color-text); color:#fff; border:2px solid var(--color-bg); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.15s; }
  .pf-avatar__edit:hover { background:var(--color-primary); }
  .pf-modal__grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:4px; }
  .pf-col { display:flex; flex-direction:column; gap:20px; }
  .pf-modal__group { display:flex; flex-direction:column; gap:12px; }
  .pf-modal__group-title { margin:0; font-size:0.82rem; font-weight:700; color:var(--color-text-soft); text-transform:uppercase; letter-spacing:0.05em; padding-bottom:8px; border-bottom:1px solid var(--color-border); }
  .pf-fields { display:flex; flex-direction:column; gap:12px; }
  .pf-field { display:flex; flex-direction:column; gap:5px; }
  .pf-field label { font-size:0.82rem; font-weight:600; color:var(--color-text-soft); }
  .pf-field input, .pf-field textarea { padding:9px 12px; border:1.5px solid var(--color-border); border-radius:var(--radius-sm); font-size:0.9rem; background:var(--color-bg); color:var(--color-text); transition:border-color 0.15s; font-family:inherit; }
  .pf-field input:focus, .pf-field textarea:focus { outline:none; border-color:var(--color-primary); }
  .pf-hint { font-size:0.78rem; color:var(--color-text-soft); }
  .pf-modal__footer { display:flex; align-items:center; padding:16px 24px; border-top:1px solid var(--color-border); flex-shrink:0; background:var(--color-cream-soft); }
  .pf-doctolib { border:1.5px solid #E0F0FF; border-radius:var(--radius-md); padding:16px; }
  @media (max-width: 900px) {
    .dash-layout { grid-template-columns:1fr; }
    .dash-side { position:static; height:auto; flex-direction:row; flex-wrap:wrap; border-right:none; border-bottom:1px solid var(--color-border); padding:12px; gap:4px; }
    .dash-side__user { display:none; }
    .dash-main { padding:24px 16px; }
    .stat-grid { grid-template-columns:1fr 1fr; }
    .pf-modal__grid { grid-template-columns:1fr; }
    .pf-preview__badges { flex-direction:row; margin-left:0; }
    .pf-modal { padding:0; align-items:flex-end; }
    .pf-modal__panel { max-width:100%; border-radius:var(--radius-lg) var(--radius-lg) 0 0; max-height:95vh; }
    .cal-layout { grid-template-columns:1fr; }
  }
  @media (max-width: 540px) { .stat-grid { grid-template-columns:1fr; } }
</style>

<script src="/scripts/tour.js" is:inline defer></script>
<script is:inline>
  window._dashTourSteps = [
    { target:null, emoji:'🧭', title:"Bienvenue dans votre tableau de bord !", content:"C'est votre espace personnel MOB'SS. Gérez vos demandes, votre profil et suivez votre activité." },
    { target:'.dash-side', emoji:'🗂️', title:'Votre menu de navigation', content:"La barre latérale vous permet de passer d'une section à l'autre : Vue d'ensemble, Calendrier, Mes demandes, Mon profil.", position:'right' },
    { target:'#overview', emoji:'📊', title:"Vue d'ensemble", content:"Retrouvez ici un résumé de votre activité : demandes envoyées, acceptées, en attente, et votre visibilité.", position:'top' },
    { target:'.dash-side__user', emoji:'👤', title:'Votre profil', content:"Complétez votre profil pour apparaître dans l'annuaire des praticiens et être contacté par des hôtes.", position:'right' },
    { target:null, emoji:'✅', title:'Vous êtes prêt !', content:"Vous connaissez l'essentiel de MOB'SS. Relancez cette visite via le bouton 🧭 en bas à droite à tout moment." },
  ];
</script>

<script>
  import { supabase } from '../../lib/supabase';

  const loadingEl = document.getElementById('dash-loading') as HTMLElement;
  const anonEl    = document.getElementById('dash-anonymous') as HTMLElement;
  const pratEl    = document.getElementById('dash-praticien') as HTMLElement;
  const bannerEl  = document.getElementById('dash-incomplete-banner') as HTMLElement;

  const spacesMap: Record<string, string> = JSON.parse(
    (window as any).__MOBSS_SPACES_MAP || '{}'
  );

  function maybeLaunchTour() {
    const fab = document.getElementById('tour-fab-dash') as HTMLElement;
    if (fab) fab.style.display = '';
    if (!localStorage.getItem('mobss_tour_dashboard')) {
      setTimeout(function () { if (window.startTour) window.startTour(window._dashTourSteps, 'mobss_tour_dashboard'); }, 1200);
    }
  }

  function initNav(dashEl: HTMLElement) {
    const navBtns  = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-nav-btn[data-section]'));
    const sections = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-section'));
    function activate(id: string) {
      navBtns.forEach(b => { const a = b.dataset.section === id; b.classList.toggle('is-active', a); b.setAttribute('aria-current', a ? 'page' : 'false'); });
      sections.forEach(s => { s.style.display = s.id === id ? '' : 'none'; });
    }
    navBtns.forEach(btn => btn.addEventListener('click', () => activate(btn.dataset.section!)));
    dashEl.querySelectorAll<HTMLElement>('[data-goto]').forEach(btn => {
      btn.addEventListener('click', () => { activate(btn.dataset.goto!); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    });
  }

  function fmtDate(str: string | null): string {
    if (!str) return '—';
    try { return new Date(str).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); }
    catch { return str; }
  }

  function statutBadge(s: string): string {
    const map: Record<string, [string, string]> = { en_attente: ['attente', '⏳ En attente'], acceptee: ['acceptee', '✅ Acceptée'], refusee: ['refusee', '❌ Refusée'] };
    const [cls, label] = map[s] || ['attente', s];
    return `<span class="dem-statut dem-statut--${cls}">${label}</span>`;
  }

  function renderDemRow(d: any): string {
    const nom = spacesMap[d.space_id] || d.space_id || 'Espace';
    const horaire = d.heure_debut && d.heure_fin ? ` · ${d.heure_debut}–${d.heure_fin}` : '';
    const recur = d.recurrence && d.recurrence !== 'Une seule fois' ? ` · ${d.recurrence}` : '';
    return `<div class="dem-row" data-statut="${d.statut}"><div style="flex:1;min-width:0;"><strong style="display:block;font-size:0.9rem;">${nom}</strong><span style="font-size:0.8rem;color:var(--color-text-soft);">${fmtDate(d.date)}${horaire}${recur}</span></div>${statutBadge(d.statut)}</div>`;
  }

  async function loadDocuments(userId: string) {
    const { data: docs } = await supabase.from('documents').select('type, file_name, status, status_note, expires_at, uploaded_at').eq('user_id', userId);
    const diplome   = docs?.find((d: any) => d.type === 'diplome');
    const assurance = docs?.find((d: any) => d.type === 'assurance');

    const diplomeLabel = document.getElementById('doc-diplome-label') as HTMLElement;
    const diplomeBadge = document.getElementById('doc-diplome-badge') as HTMLElement;
    if (diplome) {
      let t = diplome.file_name;
      if (diplome.status === 'refuse' && diplome.status_note) t += ` — ${diplome.status_note}`;
      diplomeLabel.textContent = t;
      diplomeBadge.className = 'doc-badge ' + (diplome.status === 'verifie' ? 'doc-badge--ok' : diplome.status === 'refuse' ? 'doc-badge--expired' : 'doc-badge--missing');
      diplomeBadge.textContent = diplome.status === 'verifie' ? '✓ Vérifié' : diplome.status === 'refuse' ? '✕ Refusé' : '⏳ En vérification';
    } else { diplomeLabel.textContent = 'Non fourni'; diplomeBadge.className = 'doc-badge doc-badge--missing'; diplomeBadge.textContent = '⚠ Manquant'; }

    const assuranceLabel = document.getElementById('doc-assurance-label') as HTMLElement;
    const assuranceBadge = document.getElementById('doc-assurance-badge') as HTMLElement;
    if (assurance) {
      const today = new Date(); const expires = assurance.expires_at ? new Date(assurance.expires_at) : null;
      const isExpired = expires && expires < today;
      const expiresSoon = expires && !isExpired && (expires.getTime() - today.getTime()) < 30 * 24 * 60 * 60 * 1000;
      let t = assurance.file_name;
      if (expires) t += ` — expire le ${expires.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })}`;
      assuranceLabel.textContent = t;
      if (isExpired) { assuranceBadge.className = 'doc-badge doc-badge--expired'; assuranceBadge.textContent = '✕ Expirée'; }
      else if (expiresSoon) { assuranceBadge.className = 'doc-badge doc-badge--missing'; assuranceBadge.textContent = '⚠ Expire bientôt'; }
      else if (assurance.status === 'verifie') { assuranceBadge.className = 'doc-badge doc-badge--ok'; assuranceBadge.textContent = '✓ Vérifiée'; }
      else if (assurance.status === 'refuse') { assuranceBadge.className = 'doc-badge doc-badge--expired'; assuranceBadge.textContent = '✕ Refusée'; if (assurance.status_note) assuranceLabel.textContent += ` — ${assurance.status_note}`; }
      else { assuranceBadge.className = 'doc-badge doc-badge--missing'; assuranceBadge.textContent = '⏳ En vérification'; }
    } else { assuranceLabel.textContent = 'Non fournie'; assuranceBadge.className = 'doc-badge doc-badge--missing'; assuranceBadge.textContent = '⚠ Manquante'; }

    const bothPresent = !!diplome && !!assurance;
    const anyRefused = diplome?.status === 'refuse' || assurance?.status === 'refuse';
    const bothVerified = diplome?.status === 'verifie' && assurance?.status === 'verifie';
    const badgeDocs = document.getElementById('badge-docs') as HTMLElement;
    if (badgeDocs && bothPresent) {
      badgeDocs.style.display = '';
      if (anyRefused) { badgeDocs.style.background='#FBE5E5'; badgeDocs.style.color='#A02323'; badgeDocs.style.borderColor='#F0B8B8'; badgeDocs.textContent='✕'; }
      else if (bothVerified) { badgeDocs.style.background='#E8F4EA'; badgeDocs.style.color='#2D6E3F'; badgeDocs.style.borderColor='#B8DBC0'; badgeDocs.textContent='✓'; }
      else { badgeDocs.style.background='#FFF8E1'; badgeDocs.style.color='#92400E'; badgeDocs.style.borderColor='#F59E0B'; badgeDocs.textContent='⏳'; }
    }
    const alertEl   = document.getElementById('docs-alert')   as HTMLElement;
    const okEl      = document.getElementById('docs-ok')      as HTMLElement;
    const refusedEl = document.getElementById('docs-refused') as HTMLElement;
    if (alertEl)   alertEl.style.display   = bothPresent ? 'none' : 'block';
    if (refusedEl) refusedEl.style.display = anyRefused  ? 'block' : 'none';
    if (okEl) { okEl.style.display = bothPresent && !anyRefused ? 'block' : 'none'; okEl.innerHTML = bothVerified ? '✅ <strong>Dossier vérifié.</strong> Vos deux documents ont été validés par l\'équipe MOB\'SS.' : '📋 <strong>Documents reçus.</strong> Vos documents sont en cours de vérification.'; }
    const statVis = document.getElementById('stat-visibilite') as HTMLElement;
    if (statVis && bothPresent) statVis.innerHTML += '<br><span style="font-size:0.75rem;color:#2D6E3F;">📄 Docs vérifiés</span>';
  }

  // ── Calendrier ────────────────────────────────────────────────────────────────
  let calDemandes: any[] = [], calYear = new Date().getFullYear(), calMonth = new Date().getMonth(), calSelectedDate: string | null = null;
  const MOIS = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
  function calKey(d: Date) { return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }

  function buildCalendar() {
    const grid = document.getElementById('cal-grid') as HTMLElement;
    const label = document.getElementById('cal-month-label') as HTMLElement;
    if (!grid) return;
    label.textContent = `${MOIS[calMonth]} ${calYear}`;
    const byDate: Record<string, any[]> = {};
    calDemandes.forEach(d => { if (!d.date_debut) return; const k = d.date_debut.slice(0,10); if (!byDate[k]) byDate[k]=[]; byDate[k].push(d); });
    const mk = `${calYear}-${String(calMonth+1).padStart(2,'0')}`;
    let acc=0, pend=0; const days = new Set<string>();
    Object.entries(byDate).forEach(([k,arr]) => { if (!k.startsWith(mk)) return; arr.forEach(d => { if (d.statut==='acceptee'){acc++;days.add(k);} if(d.statut==='en_attente')pend++; }); });
    (document.getElementById('cal-count-accepted') as HTMLElement).textContent = String(acc);
    (document.getElementById('cal-count-pending')  as HTMLElement).textContent = String(pend);
    (document.getElementById('cal-count-days')     as HTMLElement).textContent = String(days.size);
    const first = new Date(calYear,calMonth,1), last = new Date(calYear,calMonth+1,0), today = calKey(new Date());
    let offset = first.getDay()-1; if(offset<0) offset=6;
    grid.innerHTML = '';
    for(let i=0;i<offset;i++){const el=document.createElement('div');el.className='cal-day cal-day--empty';grid.appendChild(el);}
    for(let d=1;d<=last.getDate();d++){
      const k=`${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      const events=byDate[k]||[]; const hasAcc=events.some(e=>e.statut==='acceptee'); const hasPend=events.some(e=>e.statut==='en_attente');
      const el=document.createElement('div'); el.className='cal-day';
      if(k===today) el.classList.add('cal-day--today');
      if(k===calSelectedDate) el.classList.add('cal-day--selected');
      if(hasAcc&&hasPend) el.classList.add('cal-day--has-both'); else if(hasAcc) el.classList.add('cal-day--has-accepted'); else if(hasPend) el.classList.add('cal-day--has-pending');
      el.innerHTML=`<span class="cal-day__num">${d}</span>${events.length>0?`<div class="cal-day__dots">${hasAcc?'<span class="cal-dot cal-dot--accepted"></span>':''}${hasPend?'<span class="cal-dot cal-dot--pending"></span>':''}</div>`:''}`;
      if(events.length>0){el.addEventListener('click',()=>showCalDay(k,events));}else{el.addEventListener('click',()=>{calSelectedDate=k;buildCalendar();clearCalDetail(k);});}
      grid.appendChild(el);
    }
  }

  function showCalDay(key: string, events: any[]) {
    calSelectedDate=key; buildCalendar();
    const title = document.getElementById('cal-detail-title') as HTMLElement;
    const content = document.getElementById('cal-detail-content') as HTMLElement;
    const [y,m,d]=key.split('-');
    title.textContent=`${parseInt(d)} ${MOIS[parseInt(m)-1]} ${y}`;
    content.innerHTML=events.map(e=>{
      const cls=e.statut==='acceptee'?'accepted':e.statut==='refusee'?'refused':'pending';
      const lbl=e.statut==='acceptee'?'✅ Confirmée':e.statut==='refusee'?'❌ Refusée':'⏳ En attente';
      const space=spacesMap[e.space_id]||'Espace';
      const horaire=e.heure_debut&&e.heure_fin?`${e.heure_debut} – ${e.heure_fin}`:'Horaires non renseignés';
      return `<div class="cal-detail-event cal-detail-event--${cls}"><div class="cal-detail-event__space">${space}</div><div class="cal-detail-event__meta">🕐 ${horaire}</div><div class="cal-detail-event__meta" style="margin-top:4px;">${lbl}</div>${e.message?`<div class="cal-detail-event__meta" style="margin-top:4px;font-style:italic;">"${e.message}"</div>`:''}</div>`;
    }).join('');
  }

  function clearCalDetail(key: string) {
    const [y,m,d]=key.split('-');
    (document.getElementById('cal-detail-title') as HTMLElement).textContent=`${parseInt(d)} ${MOIS[parseInt(m)-1]} ${y}`;
    (document.getElementById('cal-detail-content') as HTMLElement).innerHTML='<p style="color:var(--color-text-soft);font-size:0.88rem;text-align:center;padding:24px 0;">Aucune réservation ce jour.</p>';
  }

  function generateIcal(demandes: any[]): string {
    const lines=['BEGIN:VCALENDAR','VERSION:2.0',"PRODID:-//MOB'SS//Réservations//FR",'CALSCALE:GREGORIAN',"X-WR-CALNAME:MOB'SS — Mes réservations",'X-WR-TIMEZONE:Europe/Paris'];
    demandes.filter(d=>d.statut==='acceptee'&&d.date_debut).forEach(d=>{
      const space=spacesMap[d.space_id]||"Espace MOB'SS";
      const dtstart=d.date_debut.slice(0,10).replace(/-/g,'');
      const dtend=d.date_fin?d.date_fin.slice(0,10).replace(/-/g,''):dtstart;
      lines.push('BEGIN:VEVENT',`UID:mobss-${d.id}@mobss.fr`,`DTSTART;VALUE=DATE:${dtstart}`,`DTEND;VALUE=DATE:${dtend}`,`SUMMARY:Réservation — ${space}`,`DESCRIPTION:Espace : ${space}${d.heure_debut?` | Horaires : ${d.heure_debut}-${d.heure_fin}`:''}`,`STATUS:CONFIRMED`,'END:VEVENT');
    });
    lines.push('END:VCALENDAR'); return lines.join('\r\n');
  }

  function initCalendar(demandes: any[]) {
    calDemandes=demandes; buildCalendar();
    document.getElementById('cal-prev')?.addEventListener('click',()=>{ calMonth--; if(calMonth<0){calMonth=11;calYear--;} buildCalendar(); });
    document.getElementById('cal-next')?.addEventListener('click',()=>{ calMonth++; if(calMonth>11){calMonth=0;calYear++;} buildCalendar(); });
    document.getElementById('cal-export-ical')?.addEventListener('click',()=>{
      const blob=new Blob([generateIcal(calDemandes)],{type:'text/calendar;charset=utf-8'});
      const url=URL.createObjectURL(blob);
      const a=Object.assign(document.createElement('a'),{href:url,download:'mobss-reservations.ics'});
      a.click(); URL.revokeObjectURL(url);
    });
    document.getElementById('cal-google-btn')?.addEventListener('click',()=>{
      const inst=document.getElementById('cal-sync-instructions') as HTMLElement;
      inst.style.display=inst.style.display==='none'?'':'none';
    });
    document.getElementById('cal-copy-url')?.addEventListener('click',()=>{
      const url=`${window.location.origin}/api/calendar/${calDemandes[0]?.user_id||'moi'}.ics`;
      navigator.clipboard.writeText(url).catch(()=>{});
      const msg=document.getElementById('cal-copy-msg') as HTMLElement;
      msg.style.display='block'; setTimeout(()=>{msg.style.display='none';},2500);
    });
  }

  // ── Doc tabs ──────────────────────────────────────────────────────────────────
  const docTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.doc-tab'));
  function activateDocTab(tab: HTMLButtonElement) {
    docTabs.forEach(t => { const a=t===tab; t.classList.toggle('doc-tab--active',a); t.setAttribute('aria-selected',a?'true':'false'); t.setAttribute('tabindex',a?'0':'-1'); });
    document.querySelectorAll<HTMLElement>('.doc-tabpanel').forEach(p => { p.style.display=p.id===`doctab-${tab.dataset.doctab}`?'':'none'; });
  }
  docTabs.forEach((tab,idx) => {
    tab.addEventListener('click',()=>activateDocTab(tab));
    tab.addEventListener('keydown',(e:KeyboardEvent)=>{ if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=docTabs[(idx+(e.key==='ArrowRight'?1:-1)+docTabs.length)%docTabs.length];next.focus();activateDocTab(next);} });
  });

  // ── Dashboard Praticien ───────────────────────────────────────────────────────
  async function loadPraticien(session: any, profile: any) {
    pratEl.style.display = 'block';
    initNav(pratEl);
    maybeLaunchTour();
    loadDocuments(session.user.id);

    const prenom = profile?.prenom || session.user.email?.split('@')[0] || 'vous';
    const nom    = profile?.nom    || '';
    const init   = ((profile?.prenom?.[0]||'')+(profile?.nom?.[0]||'')).toUpperCase()||'?';

    (document.getElementById('side-avatar') as HTMLElement).textContent = init;
    (document.getElementById('side-nom')    as HTMLElement).textContent = `${prenom} ${nom}`.trim();
    (document.getElementById('prat-prenom') as HTMLElement).textContent = prenom;

    let currentProfile = { ...(profile||{}), email: session.user.email };

    function visTag(on: boolean, onL: string, offL: string) {
      return on ? `<span class="pf-vis-tag" style="background:#D1FAE5;color:#065F46;">${onL}</span>` : `<span class="pf-vis-tag" style="background:#F3F4F6;color:#6B7280;">${offL}</span>`;
    }

    function refreshProfilUI(data: any) {
      const p=data.prenom||''; const n=data.nom||'';
      const init2=((p[0]||'')+(n[0]||'')).toUpperCase()||'?';
      const sideAv=document.getElementById('side-avatar') as HTMLElement;
      const pfAv=document.getElementById('pf-avatar') as HTMLElement;
      const pfAvModal=document.getElementById('pf-avatar-modal') as HTMLElement;
      if(data.photo_url){
        const html=`<img src="${data.photo_url}" alt="Photo de profil" width="80" height="80" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">`;
        const htmlS=`<img src="${data.photo_url}" alt="" width="52" height="52" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">`;
        pfAv.innerHTML=html; sideAv.innerHTML=htmlS; if(pfAvModal) pfAvModal.innerHTML=html;
      } else { pfAv.textContent=init2; sideAv.textContent=init2; if(pfAvModal) pfAvModal.textContent=init2; }
      (document.getElementById('side-nom')             as HTMLElement).textContent=`${p} ${n}`.trim()||'—';
      (document.getElementById('pf-preview-nom')       as HTMLElement).textContent=`${p} ${n}`.trim()||'—';
      (document.getElementById('pf-preview-specialite')as HTMLElement).textContent=data.specialite||'Spécialité non renseignée';
      (document.getElementById('pf-preview-ville')     as HTMLElement).textContent='📍 '+(data.ville||'Non renseignée');
      (document.getElementById('pf-preview-email')     as HTMLElement).textContent=data.email||session.user.email||'—';
      (document.getElementById('pf-preview-tel')       as HTMLElement).textContent=data.telephone||'Non renseigné';
      const eV=document.getElementById('pf-email-vis') as HTMLElement; const tV=document.getElementById('pf-tel-vis') as HTMLElement;
      if(eV) eV.innerHTML=visTag(data.email_public,'👁 Public','🔒 Privé');
      if(tV) tV.innerHTML=visTag(data.tel_public,  '👁 Public','🔒 Privé');
      const bA=document.getElementById('badge-annuaire-preview') as HTMLElement;
      const bR=document.getElementById('badge-rempl-preview')    as HTMLElement;
      if(bA){bA.textContent=data.visible_annuaire?'✅ Visible annuaire':'❌ Hors annuaire';bA.className='pf-badge-vis '+(data.visible_annuaire?'pf-badge-vis--on':'pf-badge-vis--off');}
      if(bR){bR.textContent=data.disponible_remplacement?'🔄 Disponible rempl.':'⏸ Rempl. désactivé';bR.className='pf-badge-vis '+(data.disponible_remplacement?'pf-badge-vis--on':'pf-badge-vis--off');}
      const bioRow=document.getElementById('pf-row-bio') as HTMLElement;
      if(data.bio){bioRow.textContent=`"${data.bio}"`;bioRow.style.display='block';}else{bioRow.style.display='none';}
      const docRow=document.getElementById('pf-row-doctolib') as HTMLElement;
      const docLink=document.getElementById('pf-preview-doctolib') as HTMLAnchorElement;
      if(data.doctolib_url&&data.doctolib_url.startsWith('http')){docRow.style.display='flex';docLink.href=data.doctolib_url;}else{docRow.style.display='none';}
      const flds=[data.prenom,data.nom,data.specialite,data.ville,data.bio,data.telephone];
      const pct=Math.round((flds.filter(Boolean).length/flds.length)*100);
      const col=pct===100?'#065F46':pct>=60?'#92400E':'var(--color-primary)';
      const lbl=document.getElementById('pct-label') as HTMLElement; const bar=document.getElementById('pct-bar') as HTMLElement; const hint=document.getElementById('pct-hint') as HTMLElement;
      if(lbl){lbl.textContent=`${pct}%`;lbl.style.color=col;}
      if(bar){bar.style.width=`${pct}%`;bar.style.background=col;}
      if(hint){const miss=['Prénom','Nom','Spécialité','Ville','Bio','Téléphone'].filter((_,i)=>!flds[i]);hint.textContent=miss.length?`Manquant : ${miss.join(', ')}`:'✅ Profil complet !';}
      const sv=document.getElementById('stat-visibilite') as HTMLElement;
      if(sv) sv.textContent=data.visible_annuaire?'✅ Visible':'❌ Masqué';
    }

    function fillProfilForm(data: any, email: string) {
      (document.getElementById('pf-prenom')    as HTMLInputElement).value    = data.prenom       || '';
      (document.getElementById('pf-nom')       as HTMLInputElement).value    = data.nom          || '';
      (document.getElementById('pf-specialite')as HTMLInputElement).value    = data.specialite   || '';
      (document.getElementById('pf-ville')     as HTMLInputElement).value    = data.ville        || '';
      (document.getElementById('pf-bio')       as HTMLTextAreaElement).value = data.bio          || '';
      (document.getElementById('pf-email')     as HTMLInputElement).value    = email             || '';
      (document.getElementById('pf-tel')       as HTMLInputElement).value    = data.telephone    || '';
      (document.getElementById('pf-doctolib')  as HTMLInputElement).value    = data.doctolib_url || '';
      (document.getElementById('toggle-annuaire')     as HTMLInputElement).checked = data.visible_annuaire        ?? true;
      (document.getElementById('toggle-rempl')        as HTMLInputElement).checked = data.disponible_remplacement ?? false;
      (document.getElementById('toggle-tel-public')   as HTMLInputElement).checked = data.tel_public              ?? false;
      (document.getElementById('toggle-email-public') as HTMLInputElement).checked = data.email_public            ?? false;
      updateDoctolibPreview(data.doctolib_url || '');
    }

    function updateDoctolibPreview(url: string) {
      const p=document.getElementById('doctolib-preview') as HTMLElement;
      const l=document.getElementById('doctolib-link')    as HTMLAnchorElement;
      if(url&&url.startsWith('http')){p.style.display='block';l.href=url;}else{p.style.display='none';}
    }

    const modal = document.getElementById('profil-modal') as HTMLElement;
    function openModal() { fillProfilForm(currentProfile,session.user.email); modal.style.display='flex'; document.body.style.overflow='hidden'; const ma=document.getElementById('pf-avatar-modal') as HTMLElement; const pa=document.getElementById('pf-avatar') as HTMLElement; if(ma&&pa) ma.innerHTML=pa.innerHTML||pa.textContent||'?'; }
    function closeModal() { modal.style.display='none'; document.body.style.overflow=''; }
    document.getElementById('btn-edit-profil')?.addEventListener('click', openModal);
    document.getElementById('btn-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('btn-modal-cancel')?.addEventListener('click', closeModal);
    document.getElementById('modal-backdrop')?.addEventListener('click', closeModal);
    document.addEventListener('keydown',(e)=>{ if(e.key==='Escape') closeModal(); });
    document.getElementById('pf-doctolib')?.addEventListener('input',(e)=>{ updateDoctolibPreview((e.target as HTMLInputElement).value); });

    const avatarInput = document.getElementById('avatar-input') as HTMLInputElement;
    document.getElementById('btn-upload-avatar')?.addEventListener('click',()=>avatarInput.click());
    avatarInput.addEventListener('change', async () => {
      const file = avatarInput.files?.[0]; if(!file) return;
      if(file.size>5*1024*1024){showAvatarStatus('⚠️ Fichier trop lourd (max 5 Mo)','error');return;}
      showAvatarStatus('⏳ Upload en cours…','info');
      const ext=file.name.split('.').pop(); const path=`${session.user.id}/avatar.${ext}`;
      const {error:upErr}=await supabase.storage.from('avatars').upload(path,file,{upsert:true});
      if(upErr){showAvatarStatus('⚠️ Erreur upload','error');return;}
      const {data:urlData}=supabase.storage.from('avatars').getPublicUrl(path);
      const photoUrl=urlData.publicUrl+'?t='+Date.now();
      const {error:dbErr}=await supabase.from('profiles').update({photo_url:photoUrl}).eq('id',session.user.id);
      if(dbErr){showAvatarStatus('⚠️ Erreur mise à jour','error');return;}
      currentProfile.photo_url=photoUrl; refreshProfilUI(currentProfile);
      showAvatarStatus('✅ Photo mise à jour !','ok');
      setTimeout(()=>{(document.getElementById('pf-avatar-status') as HTMLElement).style.display='none';},3000);
    });
    function showAvatarStatus(msg: string, type: 'ok'|'error'|'info') {
      const el=document.getElementById('pf-avatar-status') as HTMLElement;
      el.textContent=msg; el.style.display='block';
      el.style.background=type==='ok'?'#D1FAE5':type==='error'?'#FEE2E2':'#FEF3C7';
      el.style.color=type==='ok'?'#065F46':type==='error'?'#991B1B':'#92400E';
    }

    document.getElementById('btn-save-profil')?.addEventListener('click', async () => {
      const saveMsg=document.getElementById('pf-save-msg') as HTMLElement;
      const btn=document.getElementById('btn-save-profil') as HTMLButtonElement;
      btn.disabled=true; btn.textContent='Sauvegarde…';
      const payload={
        prenom:                  (document.getElementById('pf-prenom')          as HTMLInputElement).value.trim(),
        nom:                     (document.getElementById('pf-nom')             as HTMLInputElement).value.trim(),
        specialite:              (document.getElementById('pf-specialite')      as HTMLInputElement).value.trim(),
        ville:                   (document.getElementById('pf-ville')           as HTMLInputElement).value.trim(),
        bio:                     (document.getElementById('pf-bio')             as HTMLTextAreaElement).value.trim(),
        telephone:               (document.getElementById('pf-tel')             as HTMLInputElement).value.trim(),
        doctolib_url:            (document.getElementById('pf-doctolib')        as HTMLInputElement).value.trim(),
        visible_annuaire:        (document.getElementById('toggle-annuaire')    as HTMLInputElement).checked,
        disponible_remplacement: (document.getElementById('toggle-rempl')       as HTMLInputElement).checked,
        tel_public:              (document.getElementById('toggle-tel-public')  as HTMLInputElement).checked,
        email_public:            (document.getElementById('toggle-email-public')as HTMLInputElement).checked,
      };
      try {
        const {error}=await supabase.from('profiles').update(payload).eq('id',session.user.id);
        if(error) throw error;
        currentProfile={...currentProfile,...payload};
        refreshProfilUI(currentProfile);
        const tR2=document.getElementById('toggle-rempl-2') as HTMLInputElement;
        if(tR2) tR2.checked=payload.disponible_remplacement;
        const ri=document.getElementById('remp-icon') as HTMLElement; const rt=document.getElementById('remp-text') as HTMLElement;
        if(ri) ri.textContent=payload.disponible_remplacement?'✅':'⏸️';
        if(rt) rt.textContent=payload.disponible_remplacement?'Vous êtes disponible pour des remplacements':"Vous n'êtes pas disponible pour des remplacements";
        if(payload.prenom&&payload.specialite) bannerEl.style.display='none';
        saveMsg.style.display='inline'; saveMsg.style.color='#065F46'; saveMsg.textContent='✅ Sauvegardé !';
        setTimeout(()=>{saveMsg.style.display='none';closeModal();},1200);
      } catch(e: any) {
        saveMsg.style.display='inline'; saveMsg.style.color='#991B1B';
        saveMsg.textContent='⚠️ '+(e?.message||'Erreur, réessayez');
      } finally { btn.disabled=false; btn.textContent='💾 Enregistrer'; }
    });

    const tR2=document.getElementById('toggle-rempl-2') as HTMLInputElement;
    if(tR2){
      tR2.checked=profile?.disponible_remplacement??false;
      tR2.addEventListener('change', async () => {
        const tR=document.getElementById('toggle-rempl') as HTMLInputElement; if(tR) tR.checked=tR2.checked;
        const ri=document.getElementById('remp-icon') as HTMLElement; const rt=document.getElementById('remp-text') as HTMLElement;
        if(ri) ri.textContent=tR2.checked?'✅':'⏸️';
        if(rt) rt.textContent=tR2.checked?'Vous êtes disponible pour des remplacements':"Vous n'êtes pas disponible pour des remplacements";
        await supabase.from('profiles').update({disponible_remplacement:tR2.checked}).eq('id',session.user.id);
      });
    }
    const ri=document.getElementById('remp-icon') as HTMLElement; const rt=document.getElementById('remp-text') as HTMLElement;
    if(ri) ri.textContent=(profile?.disponible_remplacement??false)?'✅':'⏸️';
    if(rt) rt.textContent=(profile?.disponible_remplacement??false)?'Vous êtes disponible pour des remplacements':"Vous n'êtes pas disponible pour des remplacements";

    if(!profile?.prenom||!profile?.specialite) bannerEl.style.display='block';

    (document.getElementById('param-email') as HTMLElement).textContent=session.user.email||'—';
    (document.getElementById('param-role')  as HTMLElement).textContent=profile?.role||'praticien';
    (document.getElementById('param-date')  as HTMLElement).textContent=fmtDate(session.user.created_at);
    (document.getElementById('param-id')    as HTMLElement).textContent=session.user.id;

    refreshProfilUI(currentProfile);

    document.getElementById('btn-reset-pwd')?.addEventListener('click', async () => {
      const msgEl=document.getElementById('pwd-msg') as HTMLElement;
      msgEl.style.display='block'; msgEl.style.background='#FEF3C7'; msgEl.style.color='#92400E'; msgEl.textContent='Envoi en cours…';
      try {
        const {error}=await supabase.auth.resetPasswordForEmail(session.user.email,{redirectTo:window.location.origin+'/connexion'});
        if(error) throw error;
        msgEl.style.background='#D1FAE5'; msgEl.style.color='#065F46';
        msgEl.textContent=`✅ Email envoyé à ${session.user.email}. Vérifiez votre boîte mail.`;
      } catch { msgEl.style.background='#FEE2E2'; msgEl.style.color='#991B1B'; msgEl.textContent="⚠️ Erreur lors de l'envoi. Réessayez ou contactez le support."; }
    });

    document.getElementById('btn-logout-param')?.addEventListener('click', async () => { await supabase.auth.signOut(); window.location.href='/'; });

    let allDemandes: any[] = [];
    try {
      const {data,error}=await supabase.from('demandes').select('*').eq('user_id',session.user.id).order('created_at',{ascending:false});
      if(!error&&data){
        allDemandes=data;
        const total=data.length; const acceptee=data.filter(d=>d.statut==='acceptee').length; const attente=data.filter(d=>d.statut==='en_attente').length;
        (document.getElementById('stat-total')    as HTMLElement).textContent=String(total);
        (document.getElementById('stat-acceptees')as HTMLElement).textContent=String(acceptee);
        (document.getElementById('stat-attente')  as HTMLElement).textContent=String(attente);
        if(attente>0){const badge=document.getElementById('badge-pending') as HTMLElement;badge.textContent=String(attente);badge.style.display='inline';}
        const overviewEl=document.getElementById('overview-demandes-list') as HTMLElement;
        overviewEl.innerHTML=total===0?`<p style="color:var(--color-text-soft);text-align:center;padding:32px;">Aucune demande. <a href="/explorez">Trouver un espace →</a></p>`:data.slice(0,5).map(renderDemRow).join('');
        renderDemandesList(data,'all');
        initCalendar(allDemandes);
      }
    } catch { ['stat-total','stat-acceptees','stat-attente'].forEach(id=>((document.getElementById(id) as HTMLElement).textContent='—')); }

    function renderDemandesList(data: any[], filter: string) {
      const listEl=document.getElementById('demandes-list') as HTMLElement;
      const filtered=filter==='all'?data:data.filter(d=>d.statut===filter);
      listEl.innerHTML=filtered.length===0?`<p style="color:var(--color-text-soft);text-align:center;padding:48px;">${filter==='all'?'Aucune demande. <a href="/explorez">Trouver un espace →</a>':'Aucune demande dans cette catégorie.'}</p>`:filtered.map(renderDemRow).join('');
    }

    pratEl.querySelectorAll<HTMLElement>('.dem-filter').forEach(btn=>{
      btn.addEventListener('click',()=>{
        pratEl.querySelectorAll('.dem-filter').forEach(b=>{b.classList.remove('btn--primary');b.classList.add('btn--outline');});
        btn.classList.add('btn--primary');btn.classList.remove('btn--outline');
        renderDemandesList(allDemandes,btn.dataset.filter!);
      });
    });
  }

  // ── Gestion expiration de session ─────────────────────────────────────────────
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_OUT') window.location.href = '/connexion';
  });

  // ── Point d'entrée ────────────────────────────────────────────────────────────
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session?.user) {
      loadingEl.style.display = 'none';
      anonEl.style.display = 'block';
      return;
    }
    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role, prenom, nom, specialite, ville, bio, telephone, visible_annuaire, disponible_remplacement, photo_url, email_public, tel_public, doctolib_url')
        .eq('id', session.user.id)
        .single();

      // Mauvais rôle → rediriger vers hôte
      if (profile?.role === 'collectivite' || profile?.role === 'entreprise') {
        window.location.replace('/dashboard/hote');
        return;
      }

      // Lien admin discret pour les admins
      const ADMIN_EMAILS = (import.meta.env.PUBLIC_ADMIN_EMAIL ?? '').split(',').map((e: string) => e.trim()).filter(Boolean);
      if (ADMIN_EMAILS.includes(session.user.email ?? '')) {
        const adminLink = document.createElement('a');
        adminLink.href = '/admin';
        adminLink.textContent = '⚙️ Administration';
        adminLink.style.cssText = 'display:block;text-align:center;font-size:0.8rem;color:var(--color-text-soft);margin-top:16px;text-decoration:none;opacity:0.6;';
        adminLink.onmouseenter = () => { adminLink.style.opacity = '1'; };
        adminLink.onmouseleave = () => { adminLink.style.opacity = '0.6'; };
        document.querySelector('.dash-side nav')?.appendChild(adminLink);
      }

      loadingEl.style.display = 'none';
      loadPraticien(session, profile);
    } catch {
      loadingEl.style.display = 'none';
      loadPraticien(session, null);
    }
  });
</script>
