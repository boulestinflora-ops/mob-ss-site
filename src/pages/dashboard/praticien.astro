  .cal-dot--pending  { background:#D97706; }
  .cal-legend { display:flex; gap:16px; margin-top:16px; padding-top:12px; border-top:1px solid var(--color-border); flex-wrap:wrap; }
  .cal-legend-item { display:flex; align-items:center; gap:6px; font-size:0.82rem; color:var(--color-text-soft); }
  .cal-detail-event { padding:12px 14px; border-radius:var(--radius-md); margin-bottom:10px; border-left:3px solid; }
  .cal-detail-event--accepted { background:#E8F4EA; border-color:#2D6E3F; }
