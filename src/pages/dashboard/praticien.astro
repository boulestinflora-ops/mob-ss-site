<div id="profil-modal" class="pf-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" style="display:none;">
  <div class="pf-modal__backdrop" id="modal-backdrop"></div>
  <div class="pf-modal__panel">
    <div class="pf-modal__header">
      <h2 id="modal-title" style="margin:0;font-size:1.15rem;">✏️ Modifier mon profil</h2>
      <button id="btn-modal-close" class="pf-modal__close" type="button" aria-label="Fermer">✕</button>
    </div>
    <div class="pf-modal__body">
      <div class="pf-modal__avatar-row">
        <div class="pf-hero__avatar-wrap">
          <div id="pf-avatar-modal" class="pf-avatar" style="width:80px;height:80px;font-size:1.8rem;">?</div>
          <button id="btn-upload-avatar" class="pf-avatar__edit" title="Changer la photo" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
          <input type="file" id="avatar-input" accept="image/jpeg,image/png,image/webp" style="display:none;">
        </div>
        <div style="flex:1;">
          <strong style="display:block;font-size:0.9rem;margin-bottom:4px;">Photo de profil</strong>
          <span style="font-size:0.82rem;color:var(--color-text-soft);">JPEG, PNG ou WebP · 5 Mo max</span>
          <div id="pf-avatar-status" style="display:none;margin-top:6px;font-size:0.82rem;padding:5px 9px;border-radius:var(--radius-sm);"></div>
        </div>
      </div>
      <hr style="border:none;border-top:1px solid var(--color-border);margin:18px 0 20px;">
      <div class="pf-modal__grid">
        <div class="pf-col">
          <div class="pf-modal__group">
            <h4 class="pf-modal__group-title">Identité</h4>
            <div class="pf-fields">
              <div class="pf-field"><label for="pf-prenom">Prénom</label><input type="text" id="pf-prenom" placeholder="Votre prénom" autocomplete="given-name"></div>
              <div class="pf-field"><label for="pf-nom">Nom</label><input type="text" id="pf-nom" placeholder="Votre nom" autocomplete="family-name"></div>
              <div class="pf-field"><label for="pf-specialite">Spécialité</label><input type="text" id="pf-specialite" placeholder="ex : Kinésithérapeute, Coach sportif…"></div>
              <div class="pf-field"><label for="pf-ville">Ville d'exercice</label><input type="text" id="pf-ville" placeholder="ex : Lyon, Paris, Bordeaux…"></div>
            </div>
          </div>
          <div class="pf-modal__group">
            <h4 class="pf-modal__group-title">Présentation</h4>
            <div class="pf-field"><label for="pf-bio">Quelques mots sur vous</label><textarea id="pf-bio" rows="4" placeholder="Décrivez votre approche, vos spécificités, votre expérience…" style="resize:vertical;"></textarea><span class="pf-hint">Affiché dans l'annuaire et sur votre fiche publique.</span></div>
          </div>
        </div>
        <div class="pf-col">
          <div class="pf-modal__group">
            <h4 class="pf-modal__group-title">Contact</h4>
            <div class="pf-fields">
              <div class="pf-field"><label for="pf-email">Email</label><div style="position:relative;"><input type="email" id="pf-email" disabled style="padding-right:110px;opacity:0.75;cursor:default;"><span style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:0.72rem;color:var(--color-text-soft);white-space:nowrap;background:var(--color-bg);padding:0 4px;">Non modifiable</span></div></div>
              <div class="pf-field"><label for="pf-tel">Téléphone</label><input type="tel" id="pf-tel" placeholder="06 XX XX XX XX" autocomplete="tel"></div>
            </div>
          </div>
          <div class="pf-modal__group">
            <h4 class="pf-modal__group-title">Visibilité</h4>
            <p style="font-size:0.82rem;color:var(--color-text-soft);margin:0 0 14px;">Ce que les autres voient sur votre fiche.</p>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <div class="toggle-row"><div><strong>Afficher le téléphone</strong><p>Visible sur votre fiche publique.</p></div><label class="toggle-switch"><input type="checkbox" id="toggle-tel-public"><span class="toggle-slider"></span></label></div>
              <hr style="border:none;border-top:1px solid var(--color-border);margin:0;">
              <div class="toggle-row"><div><strong>Afficher l'email</strong><p>Visible sur votre fiche publique.</p></div><label class="toggle-switch"><input type="checkbox" id="toggle-email-public"><span class="toggle-slider"></span></label></div>
              <hr style="border:none;border-top:1px solid var(--color-border);margin:0;">
              <div class="toggle-row"><div><strong>Visible dans l'annuaire</strong><p>Trouvable dans les recherches MOB'SS.</p></div><label class="toggle-switch"><input type="checkbox" id="toggle-annuaire"><span class="toggle-slider"></span></label></div>
              <hr style="border:none;border-top:1px solid var(--color-border);margin:0;">
              <div class="toggle-row"><div><strong>Disponible pour remplacements</strong><p>Vous apparaissez dans la page Remplacements.</p></div><label class="toggle-switch"><input type="checkbox" id="toggle-rempl"><span class="toggle-slider"></span></label></div>
            </div>
          </div>
          <div class="pf-modal__group pf-doctolib">
            <h4 class="pf-modal__group-title" style="display:flex;align-items:center;gap:8px;">🩺 Profil Doctolib</h4>
            <div class="pf-field"><label for="pf-doctolib">URL de votre page Doctolib</label><input type="url" id="pf-doctolib" placeholder="https://www.doctolib.fr/praticien/votre-nom"><span class="pf-hint">Permet aux patients de prendre rendez-vous depuis votre fiche.</span></div>
            <div id="doctolib-preview" style="display:none;margin-top:10px;padding:9px 13px;background:var(--color-cream-soft);border-radius:var(--radius-sm);"><a id="doctolib-link" href="#" target="_blank" rel="noopener noreferrer" style="color:var(--color-primary);font-weight:600;font-size:0.88rem;">🔗 Voir mon profil Doctolib →</a></div>
          </div>
        </div>
      </div>
    </div>
    <div class="pf-modal__footer">
      <span id="pf-save-msg" role="status" aria-live="polite" aria-atomic="true" style="display:none;font-size:0.85rem;"></span>
      <div style="display:flex;gap:10px;margin-left:auto;">
        <button id="btn-modal-cancel" class="btn btn--ghost" type="button">Annuler</button>
        <button id="btn-save-profil" class="btn btn--primary" type="button">💾 Enregistrer</button>
      </div>
    </div>
  </div>
</div>

