---
// ============================================================
// /dashboard/hote — Tableau de bord Hôte
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
---

<BaseLayout title="Mon espace Hôte — MOB'SS" description="Votre tableau de bord hôte MOB'SS.">

<!-- CHARGEMENT -->
<div id="dash-loading" style="text-align:center;padding:120px 24px;color:var(--color-text-soft);">
  <div style="font-size:2rem;margin-bottom:12px;">⏳</div>
  <p style="font-size:1.05rem;">Chargement de votre espace…</p>
</div>

<!-- NON CONNECTÉ -->
<div id="dash-anonymous" style="display:none;text-align:center;padding:120px 24px;">
  <div style="font-size:3rem;margin-bottom:16px;">🔐</div>
  <h1>Connectez-vous pour accéder à votre espace</h1>
  <p style="color:var(--color-text-soft);margin-bottom:24px;">Votre tableau de bord MOB'SS vous attend.</p>
  <a href="/connexion" class="btn btn--primary btn--lg">Se connecter</a>
</div>

<!-- ═══════════ DASHBOARD HÔTE ═══════════ -->
<div id="dash-hote" style="display:none;">
  <div class="dash-layout">
    <aside class="dash-side">
      <div class="dash-side__user">
        <div id="hote-side-avatar" class="dash-side__avatar">?</div>
        <div>
          <strong id="hote-side-nom" style="display:block;font-size:0.95rem;">—</strong>
          <span id="hote-side-role" style="font-size:0.78rem;color:var(--color-text-soft);">Hôte</span>
        </div>
      </div>

      <nav aria-label="Navigation tableau de bord hôte">
        <button class="dash-nav-btn is-active" data-section="hote-overview">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          Vue d'ensemble
        </button>
        <button class="dash-nav-btn" data-section="hote-espaces">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/></svg>
          Mes espaces
        </button>
        <button class="dash-nav-btn" data-section="hote-demandes">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Demandes reçues
          <span id="hote-badge-pending" style="display:none;background:var(--color-primary);color:#fff;border-radius:20px;padding:1px 7px;font-size:0.72rem;font-weight:700;margin-left:auto;">0</span>
        </button>
        <a href="/annuaire" class="dash-nav-btn" style="text-decoration:none;">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          Trouver un praticien
        </a>
        <button class="dash-nav-btn" data-section="hote-impact">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          Impact territorial
        </button>
        <button class="dash-nav-btn" data-section="hote-parametres">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Paramètres
        </button>
      </nav>
    </aside>

    <div class="dash-main">
      <div class="dash-head">
        <div>
          <h1 style="font-size:clamp(1.4rem,3vw,1.9rem);">Bonjour <span id="hote-prenom">—</span> 👋</h1>
          <p style="margin:0;color:var(--color-text-soft);">Activité de votre structure sur MOB'SS.</p>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
          <button id="notif-bell-hote" class="notif-bell" aria-label="Notifications" style="display:none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span id="notif-count-hote" class="notif-bell__badge" style="display:none;">0</span>
          </button>
          <a href="/deposer-annonce" class="btn btn--primary">+ Déposer un espace</a>
        </div>
      </div>

      <!-- Vue d'ensemble hôte -->
      <div class="dash-section" id="hote-overview">
        <div class="stat-grid">
          <div class="stat">
            <div class="stat__icon" style="background:#DBEAFE;">🏢</div>
            <div class="stat__label">Espaces référencés</div>
            <p class="stat__value">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:#D1FAE5;">📨</div>
            <div class="stat__label">Demandes reçues</div>
            <p class="stat__value">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:#FEE2E2;">🩺</div>
            <div class="stat__label">Praticiens accueillis</div>
            <p class="stat__value">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:var(--color-cream-soft);">⏱️</div>
            <div class="stat__label">Heures mises à dispo</div>
            <p class="stat__value">—</p>
          </div>
        </div>

        <div class="grid grid--2" style="gap:20px;margin-top:24px;">
          <Panel title="Prochaine étape">
            <div style="text-align:center;padding:20px 16px 24px;">
              <div style="font-size:2.5rem;margin-bottom:12px;">🏢</div>
              <h3 style="margin-bottom:8px;">Déposez votre premier espace</h3>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
                Référencez une salle, un gymnase ou tout local pour permettre à des praticiens d'exercer près de chez vous.
              </p>
              <a href="/deposer-annonce" class="btn btn--primary">Déposer un espace →</a>
            </div>
          </Panel>
          <Panel title="Parcourir l'annuaire">
            <div style="text-align:center;padding:20px 16px 24px;">
              <div style="font-size:2.5rem;margin-bottom:12px;">🩺</div>
              <h3 style="margin-bottom:8px;">Trouvez un praticien</h3>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
                Découvrez les professionnels du sport et de la santé inscrits et disponibles pour intervenir dans votre structure.
              </p>
              <a href="/annuaire" class="btn btn--outline">Voir l'annuaire →</a>
            </div>
          </Panel>
        </div>
      </div>

      <!-- Mes espaces hôte -->
      <div class="dash-section" id="hote-espaces" style="display:none;">
        <Panel title="Vos espaces">
            <a slot="actions" href="/deposer-annonce" class="btn btn--primary" style="font-size:0.88rem;">+ Nouvel espace</a>
          <div style="text-align:center;padding:48px 24px;">
            <div style="font-size:3rem;margin-bottom:12px;">🏢</div>
            <h3 style="margin-bottom:8px;">Aucun espace référencé</h3>
            <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:24px;max-width:400px;margin-left:auto;margin-right:auto;">
              Déposez votre premier espace pour le rendre visible aux praticiens inscrits sur MOB'SS.
            </p>
            <a href="/deposer-annonce" class="btn btn--primary">Déposer un espace →</a>
          </div>
        </Panel>
      </div>

      <!-- Demandes reçues hôte -->
      <div class="dash-section" id="hote-demandes" style="display:none;">
        <Panel title="Demandes reçues">
            <div slot="actions" style="display:flex;gap:8px;flex-wrap:wrap;">
              <button class="hote-dem-filter btn btn--primary" data-filter="all" style="font-size:0.85rem;padding:7px 16px;">Toutes</button>
              <button class="hote-dem-filter btn btn--outline" data-filter="en_attente" style="font-size:0.85rem;padding:7px 16px;">⏳ En attente</button>
              <button class="hote-dem-filter btn btn--outline" data-filter="acceptee" style="font-size:0.85rem;padding:7px 16px;">✅ Acceptées</button>
              <button class="hote-dem-filter btn btn--outline" data-filter="refusee" style="font-size:0.85rem;padding:7px 16px;">❌ Refusées</button>
            </div>
          <div id="hote-demandes-list">
            <p style="color:var(--color-text-soft);text-align:center;padding:48px;">Chargement…</p>
          </div>
        </Panel>
      </div>

      <!-- Impact territorial hôte -->
      <div class="dash-section" id="hote-impact" style="display:none;">
        <Panel title="Votre impact territorial" style="margin-bottom:24px;">
          <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
            En mettant vos espaces à disposition, vous contribuez directement à l'accès aux soins et au sport sur votre territoire.
          </p>
          <div class="grid grid--3" style="gap:16px;">
            <div style="text-align:center;padding:20px;background:var(--color-cream-soft);border-radius:var(--radius-md);">
              <div style="font-size:2rem;margin-bottom:8px;">👥</div>
              <strong style="display:block;margin-bottom:6px;">Accès aux soins</strong>
              <p style="color:var(--color-text-soft);font-size:0.85rem;margin:0;">Plus de praticiens près de vos habitants, déserts médicaux réduits.</p>
            </div>
            <div style="text-align:center;padding:20px;background:var(--color-cream-soft);border-radius:var(--radius-md);">
              <div style="font-size:2rem;margin-bottom:8px;">🌱</div>
              <strong style="display:block;margin-bottom:6px;">Territoire attractif</strong>
              <p style="color:var(--color-text-soft);font-size:0.85rem;margin:0;">Valorisez vos espaces sous-utilisés et renforcez votre attractivité.</p>
            </div>
            <div style="text-align:center;padding:20px;background:var(--color-cream-soft);border-radius:var(--radius-md);">
              <div style="font-size:2rem;margin-bottom:8px;">💰</div>
              <strong style="display:block;margin-bottom:6px;">Avantage fiscal</strong>
              <p style="color:var(--color-text-soft);font-size:0.85rem;margin:0;">Entreprises : 60 % de réduction d'impôt mécénat (art. 238 bis CGI).</p>
            </div>
          </div>
        </Panel>
        <Panel style="background:var(--color-primary);color:#fff;border:none;">
          <h3 style="color:#fff;margin-bottom:8px;">Générez votre rapport d'impact</h3>
          <p style="color:rgba(255,255,255,0.85);font-size:0.9rem;margin-bottom:16px;">
            Un rapport complet sera disponible depuis ce tableau de bord une fois votre premier espace référencé.
          </p>
          <a href="/deposer-annonce" class="btn btn--cream">Déposer un espace →</a>
        </Panel>
      </div>

      <!-- Paramètres hôte -->
      <div class="dash-section" id="hote-parametres" style="display:none;">
        <div style="max-width:600px;display:flex;flex-direction:column;gap:20px;">

          <Panel title="Informations du compte">
            <div style="display:flex;flex-direction:column;gap:0;">
              <div class="param-row">
                <div class="param-row__label">Adresse email</div>
                <div id="hote-param-email" class="param-row__value">—</div>
              </div>
              <div class="param-row">
                <div class="param-row__label">Type de structure</div>
                <div id="hote-param-role" class="param-row__value">—</div>
              </div>
              <div class="param-row">
                <div class="param-row__label">Membre depuis</div>
                <div id="hote-param-date" class="param-row__value">—</div>
              </div>
            </div>
          </Panel>

          <Panel title="Sécurité">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
              <div>
                <strong style="display:block;font-size:0.92rem;">Mot de passe</strong>
                <span style="font-size:0.85rem;color:var(--color-text-soft);">Modifiez votre mot de passe de connexion</span>
              </div>
              <button id="hote-btn-reset-pwd" class="btn btn--outline" style="font-size:0.88rem;">Changer le mot de passe</button>
            </div>
            <div id="hote-pwd-msg" role="status" aria-live="polite" aria-atomic="true" style="display:none;margin-top:12px;padding:10px 14px;border-radius:var(--radius-md);font-size:0.88rem;"></div>
          </Panel>

          <Panel style="border-color:#FCA5A5;">
            <div class="panel__head"><h3 style="color:#B91C1C;">Zone de danger</h3></div>
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:14px;">
              <div>
                <strong style="display:block;font-size:0.92rem;">Supprimer mon compte</strong>
                <span style="font-size:0.85rem;color:var(--color-text-soft);">Action irréversible. Toutes vos données seront effacées.</span>
              </div>
              <a href="/contact?sujet=suppression-compte" class="btn" style="background:#FEE2E2;color:#B91C1C;font-size:0.88rem;border:1px solid #FCA5A5;">Demander la suppression</a>
            </div>
            <hr style="border:none;border-top:1px solid #FCA5A5;margin:0 0 14px;" />
            <button id="hote-btn-logout" class="btn btn--outline" style="font-size:0.9rem;">Se déconnecter</button>
          </Panel>
        </div>
      </div>

    </div>
  </div>
</div><!-- /dash-hote -->

<!-- Bouton visite guidée flottant -->
<button class="tour-fab" id="tour-fab-dash" style="display:none;"
  onclick="window.startTour(window._dashTourSteps,'mobss_tour_dashboard')"
  aria-label="Lancer la visite guidée du tableau de bord">
  🧭 Visite guidée
</button>


<!-- Toast container -->
<div id="notif-toast-container" aria-live="polite" aria-atomic="false"></div>

</BaseLayout>

<style>
  /* ── Layout ──────────────────────────────────────────────────────────────────── */
  .dash-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--header-h, 88px));
    align-items: start;
  }
  .dash-side {
    position: sticky;
    top: var(--header-h, 88px);
    height: calc(100vh - var(--header-h, 88px));
    overflow-y: auto;
    background: #fff;
    border-right: 1px solid var(--color-border);
    padding: 20px 12px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dash-side__user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 16px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 8px;
  }
  .dash-side__avatar {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
    flex-shrink: 0;
  }
  .dash-main {
    padding: 32px 36px;
    max-width: 900px;
  }
  .dash-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  /* ── Sidebar nav ─────────────────────────────────────────────────────────────── */
  .dash-nav-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    background: transparent;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-soft);
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, color 0.15s;
    text-decoration: none;
  }
  .dash-nav-btn:hover { background: var(--color-cream-soft); color: var(--color-text); }
  .dash-nav-btn.is-active { background: var(--color-primary); color: #fff; }
  .dash-nav-btn.is-active .icon { stroke: #fff; }
  .dash-nav-btn .icon { width: 17px; height: 17px; flex-shrink: 0; }
  /* ── Stats ───────────────────────────────────────────────────────────────────── */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stat {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .stat__icon {
    width: 36px; height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    margin-bottom: 12px;
  }
  .stat__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .stat__value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
    line-height: 1;
  }
  /* ── Panels ──────────────────────────────────────────────────────────────────── */
  .panel {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 22px 24px;
  }
  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    gap: 12px;
  }
  .panel__head h3 { margin: 0; font-size: 1rem; }
  /* ── Demandes ────────────────────────────────────────────────────────────────── */
  .dem-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .dem-row:last-child { border-bottom: none; }
  .dem-statut {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .dem-statut--attente  { background: #FEF3C7; color: #92400E; }
  .dem-statut--acceptee { background: #D1FAE5; color: #065F46; }
  .dem-statut--refusee  { background: #FEE2E2; color: #991B1B; }
  /* ── Paramètres rows ─────────────────────────────────────────────────────────── */
  .param-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .param-row:last-child { border-bottom: none; }
  .param-row__label { font-size: 0.85rem; color: var(--color-text-soft); font-weight: 500; }
  .param-row__value { font-weight: 600; font-size: 0.92rem; text-align: right; }
  /* ── Responsive ──────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .dash-layout { grid-template-columns: 1fr; }
    .dash-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid var(--color-border); padding: 12px; gap: 4px; }
    .dash-side__user { display: none; }
    .dash-main { padding: 24px 16px; }
    .stat-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .stat-grid { grid-template-columns: 1fr; }
  }

  /* ── Notification Bell ───────────────────────────────────────────────────── */
  .notif-bell {
    position:relative; background:none;
    border:1.5px solid var(--color-border,#e5e0d8);
    border-radius:var(--radius-md); padding:7px 9px;
    cursor:pointer; color:var(--color-text-soft);
    display:flex; align-items:center;
    transition:border-color .2s, color .2s;
  }
  .notif-bell:hover { border-color:var(--color-primary); color:var(--color-primary); }
  .notif-bell.has-new { animation:bell-ring .6s ease; color:var(--color-primary); border-color:var(--color-primary); }
  .notif-bell__badge {
    position:absolute; top:-6px; right:-6px;
    background:var(--color-primary); color:#fff;
    border-radius:10px; padding:1px 5px;
    font-size:.68rem; font-weight:700; min-width:16px; text-align:center;
    border:2px solid #fff;
  }
  @keyframes bell-ring {
    0%,100%{transform:rotate(0)} 20%{transform:rotate(12deg)}
    40%{transform:rotate(-10deg)} 60%{transform:rotate(8deg)} 80%{transform:rotate(-6deg)}
  }
  /* ── Toasts ──────────────────────────────────────────────────────────────── */
  #notif-toast-container {
    position:fixed; bottom:24px; right:24px; z-index:9999;
    display:flex; flex-direction:column; gap:10px;
    pointer-events:none; max-width:340px; width:calc(100vw - 48px);
  }
  .notif-toast {
    background:#fff; border-radius:var(--radius-md);
    box-shadow:0 4px 20px rgba(0,0,0,.13);
    padding:14px 16px; display:flex; align-items:flex-start; gap:12px;
    pointer-events:all; border-left:4px solid var(--color-primary);
    animation:toast-in .3s cubic-bezier(.34,1.56,.64,1) forwards;
  }
  .notif-toast--success{border-left-color:#22c55e}
  .notif-toast--warning{border-left-color:#f59e0b}
  .notif-toast--error  {border-left-color:#ef4444}
  .notif-toast__icon  {font-size:1.3rem;flex-shrink:0;margin-top:1px}
  .notif-toast__body  {flex:1;min-width:0}
  .notif-toast__title {font-weight:600;font-size:.9rem;margin-bottom:2px}
  .notif-toast__msg   {font-size:.82rem;color:var(--color-text-soft);line-height:1.4}
  .notif-toast__close {flex-shrink:0;background:none;border:none;cursor:pointer;color:var(--color-text-soft);font-size:1.1rem;padding:0;opacity:.6}
  .notif-toast__close:hover{opacity:1}
  .notif-toast.is-leaving{animation:toast-out .25s ease forwards}
  @keyframes toast-in  {from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:none}}
  @keyframes toast-out {from{opacity:1;transform:none}to{opacity:0;transform:translateX(40px)}}
  @media(max-width:480px){#notif-toast-container{bottom:16px;right:16px;left:16px;max-width:none;width:auto}}

</style>

<!-- Visite guidée — defer = non-bloquant -->
<script src="/scripts/tour.js" defer></script>
<script is:inline>
  window._dashTourSteps = [
    {
      target: null,
      emoji: '🧭',
      title: 'Bienvenue dans votre espace hôte !',
      content: "C'est votre tableau de bord MOB'SS. Gérez vos espaces et suivez les demandes des praticiens.",
    },
    {
      target: '.dash-side',
      emoji: '🗂️',
      title: 'Votre menu de navigation',
      content: "La barre latérale vous permet de passer d'une section à l'autre : Vue d'ensemble, vos espaces, les demandes reçues.",
      position: 'right',
    },
    {
      target: '#hote-overview',
      emoji: '📊',
      title: "Vue d'ensemble",
      content: "Retrouvez ici un résumé de votre activité : espaces référencés, demandes reçues, praticiens accueillis.",
      position: 'top',
    },
    {
      target: null,
      emoji: '✅',
      title: 'Vous êtes prêt !',
      content: "Déposez votre premier espace pour commencer à recevoir des demandes de praticiens. N'hésitez pas à relancer cette visite via le bouton 🧭 en bas à droite.",
    },
  ];
</script>

<script>
import type { DbDemande } from '../../types/supabase';
  import { supabase } from '../../lib/supabase';

  // ── Toast & Bell helpers ───────────────────────────────────────────────────
  type ToastType = 'info'|'success'|'warning'|'error';
  const TOAST_ICONS:Record<ToastType,string> = {info:'🔔',success:'✅',warning:'⏳',error:'❌'};

  function showToast(type:ToastType, title:string, msg:string, duration=6000) {
    const c = document.getElementById('notif-toast-container');
    if (!c) return;
    const t = document.createElement('div');
    t.className = `notif-toast notif-toast--${type}`;
    t.innerHTML = `<span class="notif-toast__icon" aria-hidden="true">${TOAST_ICONS[type]}</span>
      <div class="notif-toast__body"><div class="notif-toast__title">${title}</div>${msg?`<div class="notif-toast__msg">${msg}</div>`:''}</div>
      <button class="notif-toast__close" aria-label="Fermer">×</button>`;
    c.appendChild(t);
    const dismiss = () => { t.classList.add('is-leaving'); t.addEventListener('animationend',()=>t.remove(),{once:true}); };
    t.querySelector('.notif-toast__close')?.addEventListener('click', dismiss);
    if (duration>0) setTimeout(dismiss, duration);
  }

  function updateBell(bellId:string, badgeId:string, count:number) {
    const bell  = document.getElementById(bellId);
    const badge = document.getElementById(badgeId);
    if (!bell||!badge) return;
    bell.style.display = 'flex';
    if (count>0) {
      badge.textContent = count>99?'99+':String(count);
      badge.style.display = 'block';
      bell.classList.add('has-new');
      setTimeout(()=>bell.classList.remove('has-new'), 800);
    } else {
      badge.style.display = 'none';
    }
  }

  function subscribeHoteRealtime(spaceIds:string[]) {
    if (!spaceIds.length) return;
    supabase.channel(`hote-dem-${spaceIds[0]}`)
      .on('postgres_changes',{event:'INSERT',schema:'public',table:'demandes'},
        (payload:any) => {
          if (!spaceIds.includes(payload.new?.space_id)) return;
          const praticien = payload.new?.praticien_nom||'Un praticien';
          const space = payload.new?.space_id||'votre espace';
          showToast('info','Nouvelle demande !',`${praticien} souhaite réserver ${space}.`);
          const badge = document.getElementById('hote-badge-pending');
          const n = parseInt(badge?.textContent||'0')+1;
          if (badge){badge.textContent=String(n);badge.style.display='inline';}
          updateBell('notif-bell-hote','notif-count-hote',n);
        })
      .subscribe();
  }

  // Toast de bienvenue post-inscription
  if (new URLSearchParams(window.location.search).get('welcome') === '1') {
    setTimeout(() => showToast('success', `Bienvenue sur MOB'SS ! 🎉`, 'Déposez votre premier espace pour commencer.', 8000), 800);
    history.replaceState(null,'', window.location.pathname);
  }

  const loadingEl = document.getElementById('dash-loading') as HTMLElement;
  const anonEl    = document.getElementById('dash-anonymous') as HTMLElement;
  const hoteEl    = document.getElementById('dash-hote') as HTMLElement;

  // ── Visite guidée ─────────────────────────────────────────────────────────────
  function maybeLaunchTour() {
    const fabDash = document.getElementById('tour-fab-dash') as HTMLElement;
    if (fabDash) fabDash.style.display = '';
    if (!localStorage.getItem('mobss_tour_dashboard')) {
      setTimeout(function () { if (window.startTour) window.startTour(window._dashTourSteps, 'mobss_tour_dashboard'); }, 1200);
    }
  }

  // ── Navigation sidebar ────────────────────────────────────────────────────────
  function initNav(dashEl: HTMLElement) {
    const navBtns  = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-nav-btn[data-section]'));
    const sections = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-section'));

    function activate(targetId: string) {
      navBtns.forEach(b => {
        const active = b.dataset.section === targetId;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-current', active ? 'page' : 'false');
      });
      sections.forEach(s => {
        s.style.display = s.id === targetId ? '' : 'none';
      });
    }

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => activate(btn.dataset.section!));
    });
  }

  // ── Formatage date ────────────────────────────────────────────────────────────
  function fmtDate(str: string | null): string {
    if (!str) return '—';
    try { return new Date(str).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); }
    catch { return str; }
  }

  // ── Badge statut demande ──────────────────────────────────────────────────────
  function statutBadge(s: string): string {
    const map: Record<string, [string, string]> = {
      en_attente: ['attente',  '⏳ En attente'],
      acceptee:   ['acceptee', '✅ Acceptée'],
      refusee:    ['refusee',  '❌ Refusée'],
    };
    const [cls, label] = map[s] || ['attente', s];
    return `<span class="dem-statut dem-statut--${cls}">${label}</span>`;
  }

  // ── Dashboard Hôte ────────────────────────────────────────────────────────────
  async function loadHote(session: any, profile: any) {
    hoteEl.style.display = 'block';
    initNav(hoteEl);
    maybeLaunchTour();

    const prenom    = profile?.prenom || session.user.email?.split('@')[0] || 'vous';
    const initiales = ((profile?.prenom?.[0] || '') + (profile?.nom?.[0] || '')).toUpperCase() || '?';
    const roleLabel = profile?.role === 'entreprise' ? 'Entreprise' : 'Collectivité';

    (document.getElementById('hote-side-avatar') as HTMLElement).textContent = initiales;
    (document.getElementById('hote-side-nom')    as HTMLElement).textContent = prenom;
    (document.getElementById('hote-side-role')   as HTMLElement).textContent = roleLabel;
    (document.getElementById('hote-prenom')      as HTMLElement).textContent = prenom;
    updateBell('notif-bell-hote','notif-count-hote',0);

    (document.getElementById('hote-param-email') as HTMLElement).textContent = session.user.email || '—';
    (document.getElementById('hote-param-role')  as HTMLElement).textContent = roleLabel;
    (document.getElementById('hote-param-date')  as HTMLElement).textContent = fmtDate(session.user.created_at);

    // Reset password
    document.getElementById('hote-btn-reset-pwd')?.addEventListener('click', async () => {
      const msgEl = document.getElementById('hote-pwd-msg') as HTMLElement;
      msgEl.style.display = 'block';
      msgEl.style.background = '#FEF3C7'; msgEl.style.color = '#92400E';
      msgEl.textContent = 'Envoi en cours…';
      try {
        const { error } = await supabase.auth.resetPasswordForEmail(session.user.email, {
          redirectTo: window.location.origin + '/connexion'
        });
        if (error) throw error;
        msgEl.style.background = '#D1FAE5'; msgEl.style.color = '#065F46';
        msgEl.textContent = `✅ Email envoyé à ${session.user.email}.`;
      } catch {
        msgEl.style.background = '#FEE2E2'; msgEl.style.color = '#991B1B';
        msgEl.textContent = "⚠️ Erreur lors de l'envoi.";
      }
    });

    // Déconnexion
    document.getElementById('hote-btn-logout')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    // ── Demandes reçues hôte ──────────────────────────────────────────────────
    let allHoteDemandes: DbDemande[] = [];
    let annoncesMap: Record<string, string> = {};

    async function loadHoteDemandes() {
      const listEl = document.getElementById('hote-demandes-list') as HTMLElement;
      try {
        const { data: annonces, error: errA } = await supabase
          .from('annonces')
          .select('id, titre')
          .eq('host_id', session.user.id);

        if (errA || !annonces || annonces.length === 0) {
          listEl.innerHTML = `
            <div style="text-align:center;padding:48px 24px;">
              <div style="font-size:2.5rem;margin-bottom:12px;">📭</div>
              <h3 style="margin-bottom:8px;">Aucun espace référencé</h3>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;max-width:360px;margin-left:auto;margin-right:auto;">
                Déposez un espace pour commencer à recevoir des demandes de praticiens.
              </p>
              <a href="/deposer-annonce" class="btn btn--primary">Déposer un espace →</a>
            </div>`;
          return;
        }

        annonces.forEach(a => { annoncesMap[a.id] = a.titre || a.id; });
        const spaceIds = annonces.map(a => a.id);

        const { data: demandes, error: errD } = await supabase
          .from('demandes')
          .select('*')
          .in('space_id', spaceIds)
          .order('created_at', { ascending: false });

        if (errD) throw errD;
        allHoteDemandes = demandes || [];

        const pending = allHoteDemandes.filter(d => d.statut === 'en_attente').length;
        const badgeEl = document.getElementById('hote-badge-pending') as HTMLElement;
        if (pending > 0) {
          badgeEl.textContent = String(pending);
          badgeEl.style.display = 'inline';
        }

        renderHoteDemandes(allHoteDemandes, 'all');
      } catch {
        listEl.innerHTML = `<p style="color:#991B1B;padding:24px;text-align:center;">⚠️ Erreur de chargement. Réessayez plus tard.</p>`;
      }
    }

    function renderHoteDemRow(d: DbDemande): string {
      const spaceName = annoncesMap[d.space_id] || d.space_id || 'Espace';
      const horaire   = d.heure_debut && d.heure_fin ? ` · ${d.heure_debut}–${d.heure_fin}` : '';
      const recur     = d.recurrence && d.recurrence !== 'Une seule fois' ? ` · ${d.recurrence}` : '';
      const praticien = d.praticien_nom || d.user_email || 'Praticien';
      const actions   = d.statut === 'en_attente'
        ? `<div style="display:flex;gap:8px;flex-shrink:0;">
             <button class="btn btn--outline hote-action-btn" data-id="${d.id}" data-action="acceptee"
               style="font-size:0.8rem;padding:6px 12px;color:#065F46;border-color:#6EE7B7;">
               ✅ Accepter
             </button>
             <button class="btn btn--outline hote-action-btn" data-id="${d.id}" data-action="refusee"
               style="font-size:0.8rem;padding:6px 12px;color:#991B1B;border-color:#FCA5A5;">
               ❌ Refuser
             </button>
           </div>`
        : '';
      return `
        <div class="dem-row" data-id="${d.id}" data-statut="${d.statut}">
          <div style="flex:1;min-width:0;">
            <strong style="display:block;font-size:0.9rem;">${spaceName}</strong>
            <span style="font-size:0.8rem;color:var(--color-text-soft);">
              👤 ${praticien} · ${fmtDate(d.date)}${horaire}${recur}
            </span>
            ${d.message ? `<p style="margin:6px 0 0;font-size:0.82rem;color:var(--color-text-soft);font-style:italic;">"${d.message}"</p>` : ''}
          </div>
          ${statutBadge(d.statut)}
          ${actions}
        </div>`;
    }

    function renderHoteDemandes(data: DbDemande[], filter: string) {
      const listEl   = document.getElementById('hote-demandes-list') as HTMLElement;
      const filtered = filter === 'all' ? data : data.filter(d => d.statut === filter);
      if (filtered.length === 0) {
        listEl.innerHTML = `<p style="color:var(--color-text-soft);text-align:center;padding:48px;">
          ${filter === 'all' ? 'Aucune demande reçue pour le moment.' : 'Aucune demande dans cette catégorie.'}
        </p>`;
        return;
      }
      listEl.innerHTML = filtered.map(renderHoteDemRow).join('');
      listEl.querySelectorAll<HTMLButtonElement>('.hote-action-btn').forEach(btn => {
        btn.addEventListener('click', () => updateHoteDemandeStatut(btn.dataset.id!, btn.dataset.action as string));
      });
    }

    async function updateHoteDemandeStatut(id: string, statut: string) {
      const row = document.querySelector(`.dem-row[data-id="${id}"]`) as HTMLElement;
      if (row) row.querySelectorAll('button').forEach(b => { (b as HTMLButtonElement).disabled = true; });
      try {
        const { error } = await supabase.from('demandes').update({ statut }).eq('id', id);
        if (error) throw error;
        const idx = allHoteDemandes.findIndex(d => d.id === id);
        if (idx !== -1) allHoteDemandes[idx].statut = statut;
        const pending = allHoteDemandes.filter(d => d.statut === 'en_attente').length;
        const badgeEl = document.getElementById('hote-badge-pending') as HTMLElement;
        badgeEl.textContent = String(pending);
        badgeEl.style.display = pending > 0 ? 'inline' : 'none';
        const activeFilter = (hoteEl.querySelector('.hote-dem-filter.btn--primary') as HTMLElement)?.dataset.filter || 'all';
        renderHoteDemandes(allHoteDemandes, activeFilter);
      } catch {
        if (row) row.querySelectorAll('button').forEach(b => { (b as HTMLButtonElement).disabled = false; });
        alert('⚠️ Erreur lors de la mise à jour. Réessayez.');
      }
    }

    hoteEl.querySelectorAll<HTMLElement>('.hote-dem-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        hoteEl.querySelectorAll('.hote-dem-filter').forEach(b => {
          b.classList.remove('btn--primary'); b.classList.add('btn--outline');
        });
        btn.classList.add('btn--primary'); btn.classList.remove('btn--outline');
        renderHoteDemandes(allHoteDemandes, btn.dataset.filter!);
      });
    });

    loadHoteDemandes();
  }

  // ── Gestion expiration de session ─────────────────────────────────────────────
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_OUT') window.location.href = '/connexion';
  });

  // ── Point d'entrée ────────────────────────────────────────────────────────────
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session?.user) {
      loadingEl.style.display = 'none';
      anonEl.style.display = 'block';
      return;
    }
    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role, prenom, nom')
        .eq('id', session.user.id)
        .single();

      // Mauvais rôle → rediriger vers praticien
      if (profile?.role !== 'collectivite' && profile?.role !== 'entreprise') {
        window.location.replace('/dashboard/praticien');
        return;
      }

      loadingEl.style.display = 'none';
      loadHote(session, profile);
    } catch {
      loadingEl.style.display = 'none';
      loadHote(session, null);
    }
  });
</script>
