---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Complétez votre profil — MOB'SS"
  description="Finalisez votre profil MOB'SS pour apparaître dans l'annuaire et accéder à toutes les fonctionnalités."
>
  <!-- État : chargement -->
  <div id="cp-loading" style="text-align:center;padding:120px 24px;color:var(--color-text-soft);">
    <p>Vérification de votre accès…</p>
  </div>

  <!-- État : non connecté -->
  <div id="cp-anon" style="display:none;text-align:center;padding:120px 24px;">
    <div style="font-size:3rem;margin-bottom:16px;">🔒</div>
    <h1>Lien expiré ou invalide</h1>
    <p style="color:var(--color-text-soft);margin-bottom:24px;">
      Le lien de connexion a expiré (valable 1 heure).<br/>
      Entrez votre email pour recevoir un nouveau lien.
    </p>
    <div style="max-width:360px;margin:0 auto;">
      <div class="field">
        <input id="relink-email" type="email" placeholder="votre@email.fr" autocomplete="email" />
      </div>
      <button id="relink-btn" class="btn btn--primary btn--block">Recevoir un nouveau lien</button>
      <div id="relink-msg" style="margin-top:12px;font-size:0.9rem;color:var(--color-text-soft);"></div>
    </div>
  </div>

  <!-- ═══════════ ÉTAPE 1 : Profil ═══════════ -->
  <div id="cp-form-wrap" style="display:none;">
    <section class="section" style="padding-top:32px;">
      <div class="container" style="max-width:640px;">

        <div style="text-align:center;margin-bottom:32px;">
          <div style="font-size:3rem;margin-bottom:12px;">👋</div>
          <span class="section__eyebrow">Bienvenue sur MOB'SS</span>
          <h1 style="margin-top:12px;">Complétez votre profil</h1>
          <p style="color:var(--color-text-soft);">
            Ces informations vous permettront d'apparaître dans l'annuaire
            et de recevoir les offres de remplacement dans votre ville.
          </p>
        </div>

        <div id="cp-msg" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:20px;font-size:0.95rem;"></div>

        <div class="form-card">

          <!-- Barre de progression étape 1/2 -->
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:28px;">
            <div style="flex:1;height:6px;border-radius:3px;background:var(--color-primary);"></div>
            <div style="flex:1;height:6px;border-radius:3px;background:var(--color-border);"></div>
            <span style="font-size:0.82rem;color:var(--color-text-soft);white-space:nowrap;">Étape 1 / 2</span>
          </div>

          <form id="cp-form" novalidate>

            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin-bottom:16px;">Votre identité</h2>
            <div class="field-row">
              <div class="field">
                <label for="cp-prenom">Prénom *</label>
                <input id="cp-prenom" type="text" required autocomplete="given-name" />
              </div>
              <div class="field">
                <label for="cp-nom">Nom *</label>
                <input id="cp-nom" type="text" required autocomplete="family-name" />
              </div>
            </div>
            <div class="field">
              <label for="cp-tel">Téléphone professionnel</label>
              <input id="cp-tel" type="tel" autocomplete="tel" placeholder="06 12 34 56 78" />
              <p class="form-help">Visible uniquement par les hôtes qui confirment vos demandes.</p>
            </div>

            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin:28px 0 16px;">Votre activité</h2>
            <div class="field-row">
              <div class="field">
                <label for="cp-specialite">Spécialité *</label>
                <select id="cp-specialite" required>
                  <option value="">Sélectionner</option>
                  <option>Kinésithérapeute</option>
                  <option>Ostéopathe</option>
                  <option>Coach sportif</option>
                  <option>Diététicien / nutritionniste</option>
                  <option>Professeur de yoga / Pilates</option>
                  <option>Sophrologue</option>
                  <option>Professionnel APA</option>
                  <option>Infirmier libéral</option>
                  <option>Médecin</option>
                  <option>Psychomotricien</option>
                  <option>Ergothérapeute</option>
                  <option>Autre</option>
                </select>
              </div>
              <div class="field">
                <label for="cp-ville">Ville principale *</label>
                <input id="cp-ville" type="text" required autocomplete="address-level2" placeholder="Lyon" />
              </div>
            </div>

            <!-- Numéro RPPS — affiché uniquement pour les professions réglementées -->
            <div class="field" id="field-rpps" style="display:none;">
              <label for="cp-rpps">
                Numéro RPPS
                <span style="font-weight:400;color:var(--color-text-soft);font-size:0.85rem;">(recommandé)</span>
              </label>
              <div style="display:flex;gap:8px;align-items:center;">
                <input id="cp-rpps" type="text" maxlength="11" pattern="\d{11}" placeholder="11 chiffres" autocomplete="off"
                  style="max-width:200px;letter-spacing:0.08em;" />
                <button type="button" id="btn-verify-rpps" class="btn btn--outline" style="white-space:nowrap;padding:8px 14px;font-size:0.9rem;">
                  Vérifier ✓
                </button>
              </div>
              <div id="rpps-result" style="display:none;margin-top:8px;padding:10px 14px;border-radius:var(--radius-sm);font-size:0.88rem;"></div>
              <p class="form-help">Votre numéro RPPS est visible sur votre carte professionnelle ou sur <a href="https://annuaire.sante.fr" target="_blank" rel="noopener">annuaire.sante.fr</a>. Il permet de confirmer votre inscription au répertoire national.</p>
            </div>

            <div class="field">
              <label for="cp-bio">Présentation courte</label>
              <textarea id="cp-bio" placeholder="Ex : Kinésithérapeute libéral spécialisé en sport, je cherche des espaces pour recevoir mes patients en dehors de mon cabinet principal…" style="min-height:90px;"></textarea>
              <p class="form-help">Apparaît sur votre fiche dans l'annuaire. Facultatif mais recommandé.</p>
            </div>

            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin:28px 0 16px;">Remplacements</h2>
            <div style="background:var(--color-cream-soft);border-radius:var(--radius-md);padding:20px;display:flex;align-items:flex-start;gap:14px;">
              <input type="checkbox" id="cp-remplacement" style="margin-top:3px;width:18px;height:18px;flex-shrink:0;accent-color:var(--color-primary);" />
              <label for="cp-remplacement" style="cursor:pointer;">
                <strong style="display:block;margin-bottom:4px;">Je suis disponible pour des remplacements</strong>
                <span style="font-size:0.9rem;color:var(--color-text-soft);">
                  Vous apparaîtrez dans les résultats quand un confrère cherche un remplaçant dans votre spécialité et votre région.
                </span>
              </label>
            </div>

            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin:28px 0 16px;">Sécurisez votre compte</h2>
            <div class="field-row">
              <div class="field">
                <label for="cp-mdp">Choisissez un mot de passe</label>
                <input id="cp-mdp" type="password" autocomplete="new-password" minlength="8" placeholder="8 caractères minimum" />
              </div>
              <div class="field">
                <label for="cp-mdp2">Confirmer</label>
                <input id="cp-mdp2" type="password" autocomplete="new-password" minlength="8" />
              </div>
            </div>
            <p class="form-help" style="margin-top:-8px;">Optionnel — vous pouvez toujours vous connecter par magic link.</p>

            <button type="submit" id="cp-btn" class="btn btn--primary btn--block btn--lg" style="margin-top:28px;">
              Continuer → Documents professionnels
            </button>
          </form>
        </div>

        <p style="text-align:center;margin-top:16px;font-size:0.85rem;color:var(--color-text-soft);">
          Vous pourrez modifier ces informations à tout moment depuis votre tableau de bord.
        </p>
      </div>
    </section>
  </div>

  <!-- ═══════════ ÉTAPE 2 : Documents ═══════════ -->
  <div id="cp-docs-wrap" style="display:none;">
    <section class="section" style="padding-top:32px;">
      <div class="container" style="max-width:640px;">

        <div style="text-align:center;margin-bottom:32px;">
          <div style="font-size:3rem;margin-bottom:12px;">📄</div>
          <span class="section__eyebrow">Documents professionnels</span>
          <h1 style="margin-top:12px;">Justificatifs légaux</h1>
          <p style="color:var(--color-text-soft);">
            Ces documents sont requis pour exercer légalement et rassurer les hôtes.
            Ils sont stockés de façon sécurisée et ne sont jamais partagés publiquement.
          </p>
        </div>

        <div id="cp-docs-msg" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:20px;font-size:0.95rem;"></div>

        <div class="form-card">

          <!-- Barre de progression étape 2/2 -->
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:28px;">
            <div style="flex:1;height:6px;border-radius:3px;background:var(--color-primary);"></div>
            <div style="flex:1;height:6px;border-radius:3px;background:var(--color-primary);"></div>
            <span style="font-size:0.82rem;color:var(--color-text-soft);white-space:nowrap;">Étape 2 / 2</span>
          </div>

          <!-- Zone upload : Diplôme -->
          <div style="margin-bottom:28px;">
            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin-bottom:6px;">
              🎓 Diplôme / Titre professionnel
            </h2>
            <p style="font-size:0.88rem;color:var(--color-text-soft);margin-bottom:12px;">
              Diplôme d'État, titre RNCP ou certificat officiel reconnaissant votre qualité de professionnel.
            </p>
            <label class="upload-zone" id="zone-diplome" for="file-diplome">
              <input type="file" id="file-diplome" accept=".pdf,.jpg,.jpeg,.png,.webp" style="display:none;" />
              <div class="upload-zone__icon">📁</div>
              <div class="upload-zone__text">
                <strong>Cliquez pour sélectionner un fichier</strong>
                <span>PDF, JPG ou PNG — 10 Mo max</span>
              </div>
            </label>
            <div id="status-diplome" class="doc-status" style="display:none;"></div>
          </div>

          <!-- Zone upload : Assurance RC Pro -->
          <div style="margin-bottom:28px;">
            <h2 style="font-size:1.1rem;font-family:var(--font-body);margin-bottom:6px;">
              🛡️ Assurance Responsabilité Civile Professionnelle
            </h2>
            <p style="font-size:0.88rem;color:var(--color-text-soft);margin-bottom:12px;">
              Attestation RC Pro en cours de validité. Elle est obligatoire pour exercer en France.
            </p>
            <label class="upload-zone" id="zone-assurance" for="file-assurance">
              <input type="file" id="file-assurance" accept=".pdf,.jpg,.jpeg,.png,.webp" style="display:none;" />
              <div class="upload-zone__icon">📁</div>
              <div class="upload-zone__text">
                <strong>Cliquez pour sélectionner un fichier</strong>
                <span>PDF, JPG ou PNG — 10 Mo max</span>
              </div>
            </label>
            <div class="field" style="margin-top:10px;">
              <label for="assurance-expiry" style="font-size:0.88rem;">Date d'expiration de votre RC Pro</label>
              <input type="date" id="assurance-expiry" style="max-width:220px;" />
              <p class="form-help">Vous recevrez un rappel avant l'échéance.</p>
            </div>
            <div id="status-assurance" class="doc-status" style="display:none;"></div>
          </div>

          <!-- Note légale -->
          <div style="background:var(--color-cream-soft);border-radius:var(--radius-md);padding:16px;font-size:0.85rem;color:var(--color-text-soft);margin-bottom:24px;">
            🔒 Vos documents sont chiffrés et stockés de façon privée sur nos serveurs. Seule l'équipe MOB'SS peut les consulter dans le cadre d'une vérification manuelle. Conformément au RGPD, vous pouvez demander leur suppression à tout moment.
          </div>

          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <button id="docs-skip-btn" class="btn btn--outline" style="flex:1;">
              Passer cette étape →
            </button>
            <button id="docs-save-btn" class="btn btn--primary" style="flex:2;">
              Enregistrer les documents →
            </button>
          </div>

        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .upload-zone {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .upload-zone:hover,
  .upload-zone--active {
    border-color: var(--color-primary);
    background: var(--color-cream-soft);
  }
  .upload-zone--done {
    border-color: #2D6E3F;
    background: #E8F4EA;
  }
  .upload-zone__icon {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .upload-zone__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.9rem;
    color: var(--color-text-soft);
  }
  .upload-zone__text strong {
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .doc-status {
    margin-top: 8px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }
  .doc-status--uploading {
    background: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
  }
  .doc-status--ok {
    background: #E8F4EA;
    color: #2D6E3F;
    border: 1px solid #B8DBC0;
  }
  .doc-status--error {
    background: #FBE5E5;
    color: #A02323;
    border: 1px solid #F0B8B8;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const loadingEl  = document.getElementById('cp-loading')   as HTMLElement;
  const anonEl     = document.getElementById('cp-anon')      as HTMLElement;
  const formWrapEl = document.getElementById('cp-form-wrap') as HTMLElement;
  const docsWrapEl = document.getElementById('cp-docs-wrap') as HTMLElement;
  const msgBox     = document.getElementById('cp-msg')       as HTMLDivElement;
  const docsMsgBox = document.getElementById('cp-docs-msg')  as HTMLDivElement;

  let currentUserId = '';

  function showMsg(box: HTMLDivElement, type: 'success' | 'error', text: string) {
    box.style.display = 'block';
    box.textContent   = text;
    if (type === 'success') {
      box.style.background = '#E8F4EA';
      box.style.color      = '#2D6E3F';
      box.style.border     = '1px solid #B8DBC0';
    } else {
      box.style.background = '#FBE5E5';
      box.style.color      = '#A02323';
      box.style.border     = '1px solid #F0B8B8';
    }
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ─── Professions pour lesquelles le RPPS est pertinent ──────────────────────
  const RPPS_SPECIALITES = new Set([
    'Kinésithérapeute', 'Ostéopathe', 'Infirmier libéral', 'Médecin',
    'Psychomotricien', 'Ergothérapeute', 'Diététicien / nutritionniste',
  ]);

  function updateRppsVisibility(specialite: string) {
    const fieldRpps = document.getElementById('field-rpps') as HTMLElement;
    if (fieldRpps) fieldRpps.style.display = RPPS_SPECIALITES.has(specialite) ? '' : 'none';
  }

  document.getElementById('cp-specialite')?.addEventListener('change', (e) => {
    updateRppsVisibility((e.target as HTMLSelectElement).value);
  });

  // ─── Vérification RPPS ───────────────────────────────────────────────────────
  let rppsVerifie = false;

  document.getElementById('btn-verify-rpps')?.addEventListener('click', async () => {
    const rppsInput  = document.getElementById('cp-rpps')   as HTMLInputElement;
    const resultDiv  = document.getElementById('rpps-result') as HTMLElement;
    const btn        = document.getElementById('btn-verify-rpps') as HTMLButtonElement;
    const rpps       = rppsInput.value.replace(/\s/g, '');

    if (!/^\d{11}$/.test(rpps)) {
      resultDiv.style.display    = 'block';
      resultDiv.style.background = '#FBE5E5';
      resultDiv.style.color      = '#A02323';
      resultDiv.style.border     = '1px solid #F0B8B8';
      resultDiv.textContent      = '⚠️ Le numéro RPPS doit contenir exactement 11 chiffres.';
      return;
    }

    btn.disabled    = true;
    btn.textContent = '…';
    resultDiv.style.display    = 'block';
    resultDiv.style.background = '#EFF6FF';
    resultDiv.style.color      = '#1D4ED8';
    resultDiv.style.border     = '1px solid #BFDBFE';
    resultDiv.textContent      = '⏳ Vérification en cours via l\'annuaire national…';

    try {
      const { data: { session } } = await supabase.auth.getSession();
      const res = await fetch(
        `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/verify-rpps`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session?.access_token ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY}`,
          },
          body: JSON.stringify({ rpps }),
        }
      );
      const json = await res.json();

      if (json.ok) {
        rppsVerifie = true;
        resultDiv.style.background = '#E8F4EA';
        resultDiv.style.color      = '#2D6E3F';
        resultDiv.style.border     = '1px solid #B8DBC0';
        const parts = ['✅ Numéro RPPS confirmé dans l\'annuaire national.'];
        if (json.nom)       parts.push(`Praticien : ${json.prenom} ${json.nom}`);
        if (json.specialite)parts.push(`Spécialité : ${json.specialite}`);
        if (json.mode === 'non_verifie') {
          resultDiv.style.background = '#FFFBEB';
          resultDiv.style.color      = '#92400E';
          resultDiv.style.border     = '1px solid #FDE68A';
          parts[0] = '⚠️ Numéro enregistré (vérification API non activée).';
        }
        resultDiv.textContent = parts.join(' · ');
      } else {
        rppsVerifie = false;
        resultDiv.style.background = '#FBE5E5';
        resultDiv.style.color      = '#A02323';
        resultDiv.style.border     = '1px solid #F0B8B8';
        resultDiv.textContent      = `❌ ${json.error}`;
      }
    } catch {
      resultDiv.style.background = '#FBE5E5';
      resultDiv.style.color      = '#A02323';
      resultDiv.style.border     = '1px solid #F0B8B8';
      resultDiv.textContent      = '❌ Service temporairement indisponible.';
    }

    btn.disabled    = false;
    btn.textContent = 'Vérifier ✓';
  });

  // ─── Vérification de session ──────────────────────────────────────────────────
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    loadingEl.style.display = 'none';

    if (!session?.user) {
      anonEl.style.display = 'block';
      return;
    }

    currentUserId = session.user.id;
    formWrapEl.style.display = 'block';

    // Pré-remplir depuis les metadata de l'inscription rapide
    const meta = session.user.user_metadata || {};
    const specialiteEl = document.getElementById('cp-specialite') as HTMLSelectElement;
    const villeEl      = document.getElementById('cp-ville')      as HTMLInputElement;

    if (meta.specialite && specialiteEl) {
      Array.from(specialiteEl.options).forEach(opt => {
        if (opt.value === meta.specialite || opt.text === meta.specialite) opt.selected = true;
      });
    }
    if (meta.ville && villeEl) villeEl.value = meta.ville;

    // Charger le profil existant
    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('prenom, nom, telephone, specialite, ville, bio, disponible_remplacement, rpps_numero, rpps_verifie')
        .eq('id', session.user.id)
        .single();

      if (profile) {
        const set = (id: string, val: string | null | undefined) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el && val) el.value = val;
        };
        set('cp-prenom', profile.prenom);
        set('cp-nom', profile.nom);
        set('cp-tel', profile.telephone);
        set('cp-bio', profile.bio);
        set('cp-rpps', profile.rpps_numero);
        if (profile.ville) villeEl.value = profile.ville;
        if (profile.specialite && specialiteEl) {
          Array.from(specialiteEl.options).forEach(opt => {
            if (opt.text === profile.specialite) opt.selected = true;
          });
          updateRppsVisibility(profile.specialite);
        }
        const rempl = document.getElementById('cp-remplacement') as HTMLInputElement;
        if (rempl) rempl.checked = !!profile.disponible_remplacement;
        // Afficher le statut RPPS déjà vérifié
        if (profile.rpps_verifie && profile.rpps_numero) {
          rppsVerifie = true;
          const resultDiv = document.getElementById('rpps-result') as HTMLElement;
          if (resultDiv) {
            resultDiv.style.display    = 'block';
            resultDiv.style.background = '#E8F4EA';
            resultDiv.style.color      = '#2D6E3F';
            resultDiv.style.border     = '1px solid #B8DBC0';
            resultDiv.textContent      = '✅ Numéro RPPS précédemment vérifié.';
          }
        }
      }
    } catch (_) { /* Pas de profil existant */ }
  });

  // ─── Étape 1 : Soumission du formulaire profil ────────────────────────────────
  const cpForm = document.getElementById('cp-form') as HTMLFormElement;
  if (cpForm) {
    cpForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      msgBox.style.display = 'none';

      const prenom      = (document.getElementById('cp-prenom')      as HTMLInputElement).value.trim();
      const nom         = (document.getElementById('cp-nom')         as HTMLInputElement).value.trim();
      const tel         = (document.getElementById('cp-tel')         as HTMLInputElement).value.trim();
      const specialite  = (document.getElementById('cp-specialite')  as HTMLSelectElement).value;
      const ville       = (document.getElementById('cp-ville')       as HTMLInputElement).value.trim();
      const bio         = (document.getElementById('cp-bio')         as HTMLTextAreaElement).value.trim();
      const remplacement= (document.getElementById('cp-remplacement') as HTMLInputElement).checked;
      const mdp         = (document.getElementById('cp-mdp')         as HTMLInputElement).value;
      const mdp2        = (document.getElementById('cp-mdp2')        as HTMLInputElement).value;

      if (!prenom || !nom || !specialite || !ville) {
        showMsg(msgBox, 'error', 'Veuillez remplir les champs obligatoires (*).');
        return;
      }
      if (mdp && mdp !== mdp2) {
        showMsg(msgBox, 'error', 'Les deux mots de passe ne correspondent pas.');
        return;
      }
      if (mdp && mdp.length < 8) {
        showMsg(msgBox, 'error', 'Le mot de passe doit faire au moins 8 caractères.');
        return;
      }

      const btn = document.getElementById('cp-btn') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Enregistrement…';

      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        showMsg(msgBox, 'error', 'Session expirée. Veuillez vous reconnecter.');
        btn.disabled    = false;
        btn.textContent = 'Continuer → Documents professionnels';
        return;
      }

      if (mdp) {
        const { error: pwError } = await supabase.auth.updateUser({ password: mdp });
        if (pwError) {
          showMsg(msgBox, 'error', `Erreur mot de passe : ${pwError.message}`);
          btn.disabled    = false;
          btn.textContent = 'Continuer → Documents professionnels';
          return;
        }
      }

      const rppsNum = (document.getElementById('cp-rpps') as HTMLInputElement)?.value.trim() || null;

      const { error: profileError } = await supabase.from('profiles').upsert({
        id: session.user.id,
        prenom,
        nom,
        telephone: tel || null,
        specialite,
        ville,
        bio: bio || null,
        disponible_remplacement: remplacement,
        role: 'praticien',
        rpps_numero:  rppsNum,
        rpps_verifie: rppsVerifie,
        updated_at: new Date().toISOString(),
      });

      btn.disabled    = false;
      btn.textContent = 'Continuer → Documents professionnels';

      if (profileError) {
        showMsg(msgBox, 'error', `Erreur : ${profileError.message}`);
        return;
      }

      // Passer à l'étape 2 documents
      formWrapEl.style.display = 'none';
      docsWrapEl.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // ─── Étape 2 : Upload de fichiers ─────────────────────────────────────────────

  function setupUploadZone(
    zoneId: string,
    fileInputId: string,
    statusId: string,
    docType: 'diplome' | 'assurance'
  ) {
    const zone      = document.getElementById(zoneId)      as HTMLLabelElement;
    const fileInput = document.getElementById(fileInputId) as HTMLInputElement;
    const statusEl  = document.getElementById(statusId)    as HTMLElement;

    if (!zone || !fileInput || !statusEl) return;

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      // Validation taille
      if (file.size > 10 * 1024 * 1024) {
        statusEl.style.display = 'block';
        statusEl.className     = 'doc-status doc-status--error';
        statusEl.textContent   = '⚠️ Fichier trop lourd (10 Mo maximum).';
        return;
      }

      // Affichage : en cours
      zone.classList.add('upload-zone--active');
      statusEl.style.display = 'block';
      statusEl.className     = 'doc-status doc-status--uploading';
      statusEl.textContent   = `⏳ Upload de "${file.name}" en cours…`;

      const filePath = `${currentUserId}/${docType}/${Date.now()}_${file.name}`;

      // Upload dans Supabase Storage
      const { error: uploadError } = await supabase.storage
        .from('documents')
        .upload(filePath, file, { upsert: true });

      if (uploadError) {
        zone.classList.remove('upload-zone--active');
        statusEl.className   = 'doc-status doc-status--error';
        statusEl.textContent = `❌ Erreur d'upload : ${uploadError.message}`;
        return;
      }

      // Récupérer la date d'expiration si assurance
      let expiresAt: string | null = null;
      if (docType === 'assurance') {
        const expInput = document.getElementById('assurance-expiry') as HTMLInputElement;
        expiresAt = expInput?.value || null;
      }

      // Insérer les métadonnées dans la table documents
      // (supprimer l'ancien document du même type s'il existe)
      await supabase
        .from('documents')
        .delete()
        .eq('user_id', currentUserId)
        .eq('type', docType);

      const { error: dbError } = await supabase.from('documents').insert({
        user_id:   currentUserId,
        type:      docType,
        file_path: filePath,
        file_name: file.name,
        file_size: file.size,
        mime_type: file.type,
        expires_at: expiresAt || null,
      });

      if (dbError) {
        statusEl.className   = 'doc-status doc-status--error';
        statusEl.textContent = `❌ Erreur enregistrement : ${dbError.message}`;
        return;
      }

      // Récupérer l'id du document qu'on vient d'insérer
      const { data: docRow } = await supabase
        .from('documents')
        .select('id')
        .eq('user_id', currentUserId)
        .eq('type', docType)
        .order('uploaded_at', { ascending: false })
        .limit(1)
        .single();

      // Succès visuel immédiat
      zone.classList.remove('upload-zone--active');
      zone.classList.add('upload-zone--done');
      zone.querySelector('.upload-zone__icon')!.textContent = '✅';
      (zone.querySelector('.upload-zone__text strong') as HTMLElement).textContent = file.name;
      (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = 'Document enregistré — analyse en cours…';

      statusEl.className   = 'doc-status doc-status--uploading';
      statusEl.textContent = `⏳ Analyse automatique du document en cours…`;

      // ── Appel analyse IA ───────────────────────────────────────
      if (docRow?.id) {
        try {
          const { data: { session } } = await supabase.auth.getSession();
          const analyseRes = await fetch(
            `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/analyze-document`,
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: `Bearer ${session?.access_token ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY}`,
              },
              body: JSON.stringify({
                document_id: docRow.id,
                file_path:   filePath,
                doc_type:    docType,
              }),
            }
          );
          const analyseData = await analyseRes.json();
          const a = analyseData.analyse;

          if (a?.conforme === true) {
            (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = '✅ Document analysé — conforme';
            statusEl.className   = 'doc-status doc-status--ok';
            const msgs = [`✅ "${file.name}" enregistré et analysé.`];
            if (a.assureur)        msgs.push(`Assureur : ${a.assureur}`);
            if (a.date_fin)        msgs.push(`Expire le : ${new Date(a.date_fin).toLocaleDateString('fr-FR')}`);
            if (a.intitule)        msgs.push(`Diplôme : ${a.intitule}`);
            if (a.anomalies?.length) msgs.push(`Attention : ${a.anomalies.join(', ')}`);
            statusEl.textContent = msgs.join(' · ');
          } else if (a?.conforme === false) {
            (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = '⚠️ Document enregistré — à vérifier';
            statusEl.className   = 'doc-status doc-status--error';
            const anomalies = a.anomalies?.length ? a.anomalies.join(', ') : 'Document non reconnu ou illisible';
            statusEl.textContent = `⚠️ "${file.name}" enregistré mais l'analyse signale : ${anomalies}`;
          } else {
            // Clé API absente → pas d'analyse, mais upload OK
            (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = 'Document enregistré avec succès';
            statusEl.className   = 'doc-status doc-status--ok';
            statusEl.textContent = `✓ "${file.name}" enregistré. (Analyse IA non activée)`;
          }
        } catch {
          (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = 'Document enregistré avec succès';
          statusEl.className   = 'doc-status doc-status--ok';
          statusEl.textContent = `✓ "${file.name}" enregistré.`;
        }
      } else {
        (zone.querySelector('.upload-zone__text span') as HTMLElement).textContent = 'Document enregistré avec succès';
        statusEl.className   = 'doc-status doc-status--ok';
        statusEl.textContent = `✓ "${file.name}" enregistré.`;
      }
    });
  }

  setupUploadZone('zone-diplome',   'file-diplome',   'status-diplome',   'diplome');
  setupUploadZone('zone-assurance', 'file-assurance', 'status-assurance', 'assurance');

  // Bouton "Passer" → aller au dashboard sans documents
  document.getElementById('docs-skip-btn')?.addEventListener('click', () => {
    window.location.href = '/dashboard';
  });

  // Bouton "Enregistrer les documents" → aller au dashboard
  document.getElementById('docs-save-btn')?.addEventListener('click', () => {
    const diplomeOk   = document.getElementById('zone-diplome')?.classList.contains('upload-zone--done');
    const assuranceOk = document.getElementById('zone-assurance')?.classList.contains('upload-zone--done');

    if (!diplomeOk && !assuranceOk) {
      showMsg(docsMsgBox, 'error', 'Ajoutez au moins un document, ou cliquez sur "Passer cette étape".');
      return;
    }

    showMsg(docsMsgBox, 'success', '✓ Documents enregistrés ! Redirection vers votre tableau de bord…');
    setTimeout(() => { window.location.href = '/dashboard'; }, 1500);
  });

  // ─── Renvoi du magic link ──────────────────────────────────────────────────────
  const relinkBtn = document.getElementById('relink-btn') as HTMLButtonElement;
  if (relinkBtn) {
    relinkBtn.addEventListener('click', async () => {
      const email = (document.getElementById('relink-email') as HTMLInputElement).value.trim();
      const msgEl = document.getElementById('relink-msg') as HTMLElement;
      if (!email) { msgEl.textContent = 'Entrez votre email.'; return; }

      relinkBtn.disabled    = true;
      relinkBtn.textContent = 'Envoi…';

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${window.location.origin}/completer-profil` },
      });

      relinkBtn.disabled    = false;
      relinkBtn.textContent = 'Recevoir un nouveau lien';

      msgEl.textContent = error
        ? `Erreur : ${error.message}`
        : `✓ Lien envoyé à ${email} — vérifiez vos emails.`;
    });
  }
</script>
