---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Contact — MOB'SS"
  description="Contactez l'équipe MOB'SS pour toute demande, démo ou partenariat."
  currentPage="contact"
>
  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="gap:48px;align-items:start;">

        <div>
          <span class="section__eyebrow">Contact</span>
          <h1>Parlons de votre projet</h1>
          <p style="color:var(--color-text-soft);font-size:1.05rem;">
            Une question, une démo, un partenariat&nbsp;? Écrivez-nous, nous vous répondrons rapidement.
          </p>

          <div class="stack-24" style="margin-top:32px;">
            <div style="display:flex;gap:16px;align-items:flex-start;">
              <div class="card__icon" style="margin:0;flex:none;">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
                </svg>
              </div>
              <div>
                <strong>Email</strong><br />
                <a href="mailto:bonjour@mobss.fr">bonjour@mobss.fr</a><br />
                <span style="color:var(--color-text-soft);font-size:0.9rem;">Pour toute demande générale</span>
              </div>
            </div>
          </div>

          <div style="background:var(--color-cream-soft);border-radius:var(--radius-md);padding:20px;margin-top:32px;">
            <strong>🚀 Site en cours de création</strong>
            <p style="margin:6px 0 0;color:var(--color-text-soft);font-size:0.95rem;">
              MOB'SS est en phase de développement. Vos messages seront traités dès l'ouverture officielle de la plateforme.
            </p>
          </div>

          <div style="background:var(--color-cream-soft);border-radius:var(--radius-md);padding:20px;margin-top:16px;">
            <strong>💡 Vous êtes une collectivité&nbsp;?</strong>
            <p style="margin:6px 0 0;color:var(--color-text-soft);font-size:0.95rem;">
              Demandez une présentation personnalisée pour découvrir comment MOB'SS peut s'intégrer à votre stratégie territoriale.
            </p>
          </div>
        </div>

        <div class="form-card">
          <h2 style="margin-bottom:8px;font-size:1.4rem;">Envoyez-nous un message</h2>
          <p style="color:var(--color-text-soft);margin-bottom:24px;">Nous revenons vers vous dès que possible.</p>

          <!-- Zone de retour (succès / erreur) -->
          <div id="contact-msg" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:18px;font-size:0.95rem;"></div>

          <form id="contact-form" novalidate>
            <div class="field">
              <label for="motif">Vous êtes…</label>
              <select id="motif" required>
                <option value="">Sélectionner</option>
                <option>Praticien sport ou santé</option>
                <option>Collectivité / commune</option>
                <option>Entreprise</option>
                <option>Presse, partenaire, autre</option>
              </select>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="prenom">Prénom *</label>
                <input id="prenom" type="text" required autocomplete="given-name" />
              </div>
              <div class="field">
                <label for="nom">Nom *</label>
                <input id="nom" type="text" required autocomplete="family-name" />
              </div>
            </div>

            <div class="field">
              <label for="email">Email *</label>
              <input id="email" type="email" required autocomplete="email" />
            </div>

            <div class="field">
              <label for="organisation">Organisation (facultatif)</label>
              <input id="organisation" type="text" autocomplete="organization" placeholder="Mairie, cabinet, entreprise…" />
            </div>

            <div class="field">
              <label for="message">Votre message *</label>
              <textarea id="message" required placeholder="Décrivez votre besoin ou votre question…"></textarea>
            </div>

            <label class="option" style="display:flex;gap:8px;align-items:flex-start;font-size:0.9rem;color:var(--color-text-soft);margin-bottom:18px;">
              <input type="checkbox" id="rgpd-check" required style="margin-top:4px;" />
              <span>J'accepte que mes données soient traitées pour répondre à ma demande, conformément à la <a href="/confidentialite">politique de confidentialité</a>.</span>
            </label>

            <button type="submit" class="btn btn--primary btn--block btn--lg">Envoyer le message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const msgBox  = document.getElementById('contact-msg') as HTMLDivElement | null;

  function showMsg(type: 'success' | 'error', text: string) {
    if (!msgBox) return;
    msgBox.style.display = 'block';
    msgBox.textContent   = text;
    if (type === 'success') {
      msgBox.style.background = '#E8F4EA';
      msgBox.style.color      = '#2D6E3F';
      msgBox.style.border     = '1px solid #B8DBC0';
    } else {
      msgBox.style.background = '#FBE5E5';
      msgBox.style.color      = '#A02323';
      msgBox.style.border     = '1px solid #F0B8B8';
    }
    msgBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const motif  = (document.getElementById('motif')   as HTMLSelectElement).value;
      const prenom = (document.getElementById('prenom')  as HTMLInputElement).value.trim();
      const nom    = (document.getElementById('nom')     as HTMLInputElement).value.trim();
      const email  = (document.getElementById('email')   as HTMLInputElement).value.trim();
      const orga   = (document.getElementById('organisation') as HTMLInputElement).value.trim();
      const msg    = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
      const rgpd   = (document.getElementById('rgpd-check') as HTMLInputElement).checked;

      // Validation basique
      if (!prenom || !nom || !email || !msg) {
        showMsg('error', 'Veuillez remplir tous les champs obligatoires (*).');
        return;
      }
      if (!rgpd) {
        showMsg('error', 'Veuillez accepter la politique de confidentialité avant d\'envoyer.');
        return;
      }

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled    = true;
      btn.textContent = 'Envoi en cours…';

      // Sauvegarde dans Supabase (table contact_messages)
      const { error } = await supabase.from('contact_messages').insert({
        motif,
        prenom,
        nom,
        email,
        organisation: orga || null,
        message: msg,
      }).then(r => r).catch(() => ({ error: { message: 'network' } }));

      btn.disabled    = false;
      btn.textContent = 'Envoyer le message';

      // Qu'il y ait une erreur Supabase ou non (table peut ne pas encore exister),
      // on affiche le message de confirmation et on cache le formulaire.
      if (error && !error.message?.includes('does not exist') && error.message !== 'network') {
        showMsg('error', `Une erreur est survenue : ${error.message}`);
      } else {
        showMsg('success', `✓ Message envoyé ! Nous vous répondrons à l'adresse ${email} dès que possible.`);
        form.style.display = 'none';
      }
    });
  }
</script>
