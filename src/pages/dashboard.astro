---
import BaseLayout from '../layouts/BaseLayout.astro';
import spaces from '../data/spaces.json';

const spacesMapJson = JSON.stringify(
  Object.fromEntries(spaces.map((s: any) => [s.id, s.title]))
);
---

<BaseLayout title="Mon espace — MOB'SS" description="Votre tableau de bord MOB'SS.">
<script type="application/json" id="spaces-map-data" set:html={spacesMapJson}></script>

<!-- CHARGEMENT -->
<div id="dash-loading" style="text-align:center;padding:120px 24px;color:var(--color-text-soft);">
  <div style="font-size:2rem;margin-bottom:12px;">⏳</div>
  <p style="font-size:1.05rem;">Chargement de votre espace…</p>
</div>

<!-- NON CONNECTÉ -->
<div id="dash-anonymous" style="display:none;text-align:center;padding:120px 24px;">
  <div style="font-size:3rem;margin-bottom:16px;">🔐</div>
  <h1>Connectez-vous pour accéder à votre espace</h1>
  <p style="color:var(--color-text-soft);margin-bottom:24px;">Votre tableau de bord MOB'SS vous attend.</p>
  <a href="/connexion" class="btn btn--primary btn--lg">Se connecter</a>
</div>

<!-- BANNIÈRE PROFIL INCOMPLET -->
<div id="dash-incomplete-banner" style="display:none;background:#FFF8DC;border-bottom:2px solid #E8D87A;padding:14px 24px;">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <span style="color:#6B5800;font-size:0.95rem;">
      ✏️ <strong>Votre profil est incomplet.</strong> Complétez-le pour apparaître dans l'annuaire.
    </span>
    <a href="/completer-profil" class="btn btn--primary" style="white-space:nowrap;">Compléter mon profil →</a>
  </div>
</div>

<!-- ═══════════ DASHBOARD PRATICIEN ═══════════ -->
<div id="dash-praticien" style="display:none;">
  <div class="dash-layout">

    <!-- Sidebar -->
    <aside class="dash-side">
      <div class="dash-side__user">
        <div id="side-avatar" class="dash-side__avatar">?</div>
        <div>
          <strong id="side-nom" style="display:block;font-size:0.95rem;">—</strong>
          <span id="side-role" style="font-size:0.78rem;color:var(--color-text-soft);">Praticien·ne</span>
        </div>
      </div>

      <nav aria-label="Navigation du tableau de bord">
        <button class="dash-nav-btn is-active" data-section="overview">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          Vue d'ensemble
        </button>
        <button class="dash-nav-btn" data-section="calendrier">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><circle cx="8" cy="15" r="1" fill="currentColor"/><circle cx="12" cy="15" r="1" fill="currentColor"/><circle cx="16" cy="15" r="1" fill="currentColor"/></svg>
          Calendrier
        </button>
        <button class="dash-nav-btn" data-section="demandes">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Mes demandes
          <span id="badge-pending" style="display:none;background:var(--color-primary);color:#fff;border-radius:20px;padding:1px 7px;font-size:0.72rem;font-weight:700;margin-left:auto;">0</span>
        </button>
        <button class="dash-nav-btn" data-section="profil">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          Mon profil
        </button>
        <button class="dash-nav-btn" data-section="remplacements">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          Remplacements
        </button>
        <button class="dash-nav-btn" data-section="documents">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
          Mes documents
          <span id="badge-docs" style="display:none;background:#E8F4EA;color:#2D6E3F;border:1px solid #B8DBC0;border-radius:20px;padding:1px 7px;font-size:0.72rem;font-weight:700;margin-left:auto;">✓</span>
        </button>
        <a href="/explorez" class="dash-nav-btn" style="text-decoration:none;">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 7-8 13-8 13S4 17 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Trouver un espace
        </a>
        <button class="dash-nav-btn" data-section="parametres">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Paramètres
        </button>
      </nav>
    </aside>

    <!-- Contenu principal -->
    <div class="dash-main">

      <div class="dash-head">
        <div>
          <h1 style="font-size:clamp(1.4rem,3vw,1.9rem);">Bonjour <span id="prat-prenom">—</span> 👋</h1>
          <p style="margin:0;color:var(--color-text-soft);">Voici votre activité sur MOB'SS.</p>
        </div>
        <a href="/explorez" class="btn btn--primary">+ Réserver un espace</a>
      </div>

      <!-- ── Vue d'ensemble ── -->
      <div class="dash-section" id="overview">

        <div class="stat-grid">
          <div class="stat">
            <div class="stat__icon" style="background:#FEE2E2;">📋</div>
            <div class="stat__label">Demandes envoyées</div>
            <p class="stat__value" id="stat-total">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:#D1FAE5;">✅</div>
            <div class="stat__label">Acceptées</div>
            <p class="stat__value" id="stat-acceptees" style="color:#2D6E3F;">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:#FEF3C7;">⏳</div>
            <div class="stat__label">En attente</div>
            <p class="stat__value" id="stat-attente" style="color:#92400E;">—</p>
          </div>
          <div class="stat">
            <div class="stat__icon" style="background:var(--color-cream-soft);">👁️</div>
            <div class="stat__label">Visibilité annuaire</div>
            <p class="stat__value" id="stat-visibilite" style="font-size:1rem;padding-top:4px;">—</p>
          </div>
        </div>

        <!-- Dernières demandes -->
        <div class="panel" style="margin-top:24px;">
          <div class="panel__head">
            <h3>Dernières demandes</h3>
            <button class="btn btn--ghost" data-goto="demandes" style="font-size:0.88rem;">Tout voir →</button>
          </div>
          <div id="overview-demandes-list">
            <p style="color:var(--color-text-soft);text-align:center;padding:32px;">Chargement…</p>
          </div>
        </div>

        <!-- Actions rapides -->
        <div class="grid grid--3" style="margin-top:20px;gap:16px;">
          <div class="quick-action" data-goto="profil">
            <span style="font-size:1.6rem;">👤</span>
            <div>
              <strong>Mon profil</strong>
              <p>Complétez votre fiche pour être visible dans l'annuaire</p>
            </div>
          </div>
          <a href="/explorez" class="quick-action" style="text-decoration:none;color:inherit;">
            <span style="font-size:1.6rem;">🗺️</span>
            <div>
              <strong>Trouver un espace</strong>
              <p>Parcourez les espaces disponibles près de chez vous</p>
            </div>
          </a>
          <div class="quick-action" data-goto="remplacements">
            <span style="font-size:1.6rem;">🔄</span>
            <div>
              <strong>Remplacements</strong>
              <p>Indiquez vos disponibilités pour remplacer des confrères</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Calendrier ── -->
      <div class="dash-section" id="calendrier" style="display:none;">

        <div class="cal-layout">

          <!-- Colonne gauche : calendrier -->
          <div class="cal-main">
            <div class="panel">

              <!-- En-tête navigation mois -->
              <div class="cal-header">
                <button id="cal-prev" class="cal-nav-btn" aria-label="Mois précédent">‹</button>
                <h3 id="cal-month-label" style="margin:0;font-size:1.1rem;"></h3>
                <button id="cal-next" class="cal-nav-btn" aria-label="Mois suivant">›</button>
              </div>

              <!-- Jours de la semaine -->
              <div class="cal-weekdays">
                <span>Lun</span><span>Mar</span><span>Mer</span>
                <span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
              </div>

              <!-- Grille des jours -->
              <div class="cal-grid" id="cal-grid"></div>

              <!-- Légende -->
              <div class="cal-legend">
                <span class="cal-legend-item"><span class="cal-dot cal-dot--accepted"></span>Réservation confirmée</span>
                <span class="cal-legend-item"><span class="cal-dot cal-dot--pending"></span>En attente</span>
              </div>
            </div>

            <!-- Synchronisation agenda -->
            <div class="panel" style="margin-top:16px;">
              <div class="panel__head"><h3>Synchroniser avec votre agenda</h3></div>
              <p style="font-size:0.88rem;color:var(--color-text-soft);margin-bottom:16px;">
                Exportez vos réservations dans Google Calendar, Apple Calendar ou tout agenda compatible iCal.
              </p>
              <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <button id="cal-export-ical" class="btn btn--outline" style="display:flex;align-items:center;gap:8px;font-size:0.88rem;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Télécharger .ics
                </button>
                <button id="cal-google-btn" class="btn btn--outline" style="display:flex;align-items:center;gap:8px;font-size:0.88rem;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                  Ajouter à Google Calendar
                </button>
              </div>
              <div id="cal-sync-instructions" style="display:none;margin-top:16px;background:var(--color-cream-soft);border-radius:var(--radius-md);padding:16px;font-size:0.85rem;">
                <strong style="display:block;margin-bottom:8px;">📋 Comment synchroniser :</strong>
                <ol style="margin:0;padding-left:20px;line-height:1.8;">
                  <li>Cliquez sur <strong>Télécharger .ics</strong></li>
                  <li>Dans Google Calendar : <em>Autres agendas → Importer</em></li>
                  <li>Dans Apple Calendar : <em>Fichier → Importer</em></li>
                  <li>Pour une <strong>synchronisation automatique</strong>, ouvrez Google Calendar sur ordinateur → <em>Autres agendas → +</em> → <em>À partir d'une URL</em> et collez l'URL de votre agenda MOB'SS</li>
                </ol>
                <button id="cal-copy-url" class="btn btn--primary btn--sm" style="margin-top:12px;">
                  📋 Copier l'URL de synchronisation
                </button>
                <div id="cal-copy-msg" role="status" aria-live="polite" aria-atomic="true" style="display:none;font-size:0.82rem;color:#2D6E3F;margin-top:6px;">✓ URL copiée !</div>
              </div>
            </div>
          </div>

          <!-- Colonne droite : détail du jour sélectionné -->
          <div class="cal-aside">
            <div class="panel" id="cal-detail-panel">
              <div class="panel__head"><h3 id="cal-detail-title">Sélectionnez une date</h3></div>
              <div id="cal-detail-content">
                <p style="color:var(--color-text-soft);font-size:0.88rem;text-align:center;padding:24px 0;">
                  Cliquez sur une journée du calendrier pour voir les détails de votre réservation.
                </p>
              </div>
            </div>

            <!-- Mini résumé du mois -->
            <div class="panel" style="margin-top:16px;">
              <div class="panel__head"><h3>Ce mois-ci</h3></div>
              <div style="display:flex;flex-direction:column;gap:10px;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:0.88rem;color:var(--color-text-soft);">Réservations confirmées</span>
                  <strong id="cal-count-accepted" style="color:#2D6E3F;">0</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:0.88rem;color:var(--color-text-soft);">En attente de réponse</span>
                  <strong id="cal-count-pending" style="color:#92400E;">0</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="font-size:0.88rem;color:var(--color-text-soft);">Jours réservés</span>
                  <strong id="cal-count-days">0</strong>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- ── Mes demandes ── -->
      <div class="dash-section" id="demandes" style="display:none;">
        <div class="panel">
          <div class="panel__head">
            <h3>Mes demandes d'espace</h3>
            <a href="/explorez" class="btn btn--primary" style="font-size:0.88rem;">+ Nouvelle demande</a>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
            <button class="dem-filter btn btn--primary" data-filter="all" style="font-size:0.85rem;padding:7px 16px;">Toutes</button>
            <button class="dem-filter btn btn--outline" data-filter="en_attente" style="font-size:0.85rem;padding:7px 16px;">⏳ En attente</button>
            <button class="dem-filter btn btn--outline" data-filter="acceptee" style="font-size:0.85rem;padding:7px 16px;">✅ Acceptées</button>
            <button class="dem-filter btn btn--outline" data-filter="refusee" style="font-size:0.85rem;padding:7px 16px;">❌ Refusées</button>
          </div>
          <div id="demandes-list">
            <p style="color:var(--color-text-soft);text-align:center;padding:48px;">Chargement…</p>
          </div>
        </div>
      </div>

      <!-- ── Mon profil ── -->
      <div class="dash-section" id="profil" style="display:none;">

        <div class="pf-header">
          <div>
            <h2 style="margin:0 0 4px;font-size:1.4rem;">Mon profil</h2>
            <p style="margin:0;color:var(--color-text-soft);font-size:0.9rem;">Voici ce que les hôtes et confrères voient sur votre fiche.</p>
          </div>
          <button id="btn-edit-profil" class="btn btn--primary" type="button">✏️ Modifier mon profil</button>
        </div>

        <!-- Carte aperçu public -->
        <div class="panel pf-preview-card">

          <!-- Hero -->
          <div class="pf-preview__hero">
            <div id="pf-avatar" class="pf-avatar" style="width:80px;height:80px;font-size:1.8rem;flex-shrink:0;">?</div>
            <div style="flex:1;min-width:0;">
              <div id="pf-preview-nom" style="font-size:1.2rem;font-weight:700;">—</div>
              <div id="pf-preview-specialite" style="color:var(--color-primary);font-weight:600;font-size:0.95rem;margin-top:2px;">—</div>
              <div id="pf-preview-ville" style="font-size:0.83rem;color:var(--color-text-soft);margin-top:4px;">📍 —</div>
            </div>
            <div class="pf-preview__badges">
              <span id="badge-annuaire-preview" class="pf-badge-vis"></span>
              <span id="badge-rempl-preview" class="pf-badge-vis"></span>
            </div>
          </div>

          <hr style="border:none;border-top:1px solid var(--color-border);margin:18px 0;">

          <!-- Infos contact + bio -->
          <div class="pf-preview__body">
            <div class="pf-preview__row" id="pf-row-email">
              <span class="pf-preview__icon">📧</span>
              <span id="pf-preview-email" style="color:var(--color-text-soft);">—</span>
              <span id="pf-email-vis" class="pf-vis-tag"></span>
            </div>
            <div class="pf-preview__row" id="pf-row-tel">
              <span class="pf-preview__icon">📱</span>
              <span id="pf-preview-tel" style="color:var(--color-text-soft);">—</span>
              <span id="pf-tel-vis" class="pf-vis-tag"></span>
            </div>
            <div class="pf-preview__row" id="pf-row-doctolib" style="display:none;">
              <span class="pf-preview__icon">🩺</span>
              <a id="pf-preview-doctolib" href="#" target="_blank" rel="noopener noreferrer" style="color:var(--color-primary);font-weight:600;font-size:0.9rem;">Voir mon profil Doctolib →</a>
            </div>
            <div id="pf-row-bio" style="margin-top:14px;padding:14px;background:var(--color-cream-soft);border-radius:var(--radius-sm);font-size:0.88rem;font-style:italic;color:var(--color-text-soft);display:none;"></div>
          </div>

          <!-- Complétude -->
          <div style="margin-top:18px;padding-top:16px;border-top:1px solid var(--color-border);">
            <div style="display:flex;align-items:center;gap:10px;">
              <div class="pf-completude__track" style="flex:1;">
                <div id="pct-bar" class="pf-completude__fill"></div>
              </div>
              <span id="pct-label" style="font-size:0.82rem;font-weight:700;white-space:nowrap;"></span>
            </div>
            <p id="pct-hint" style="margin:6px 0 0;font-size:0.8rem;color:var(--color-text-soft);"></p>
          </div>

        </div>
      </div>

      <!-- ── Remplacements ── -->
      <div class="dash-section" id="remplacements" style="display:none;">
        <div class="grid grid--2" style="gap:24px;align-items:start;">

          <div class="panel">
            <div class="panel__head"><h3>Ma disponibilité</h3></div>
            <div style="text-align:center;padding:20px 16px 28px;">
              <div id="remp-icon" style="font-size:3rem;margin-bottom:12px;">⏸️</div>
              <p id="remp-text" style="font-size:1rem;font-weight:600;margin-bottom:6px;color:var(--color-text);">Chargement…</p>
              <p style="color:var(--color-text-soft);font-size:0.88rem;margin-bottom:24px;max-width:280px;margin-left:auto;margin-right:auto;">
                Activez pour apparaître dans la page Remplacements et être contacté par des confrères.
              </p>
              <label class="toggle-switch" style="margin:0 auto 16px;display:block;width:fit-content;">
                <input type="checkbox" id="toggle-rempl-2" />
                <span class="toggle-slider"></span>
              </label>
              <p style="font-size:0.78rem;color:var(--color-text-soft);">Synchronisé avec le paramètre dans "Mon profil"</p>
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:20px;">
            <div class="panel">
              <div class="panel__head"><h3>Trouver un remplaçant</h3></div>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:16px;">
                Cherchez un confrère disponible dans votre spécialité pour vous remplacer ponctuellement.
              </p>
              <a href="/remplacements" class="btn btn--primary btn--block">Voir les remplaçants disponibles →</a>
            </div>

            <div class="panel" style="background:var(--color-cream-soft);border-color:transparent;">
              <strong style="display:block;margin-bottom:8px;font-size:0.92rem;">💡 Comment ça marche</strong>
              <p style="margin:0;font-size:0.85rem;color:var(--color-text-soft);">
                MOB'SS vous met en relation directement. Échangez vos coordonnées et organisez le remplacement entre vous — gratuitement, sans intermédiaire.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Mes documents ── -->
      <div class="dash-section" id="documents" style="display:none;">
        <div style="max-width:640px;">

          <!-- Onglets -->
          <div class="doc-tabs" role="tablist">
            <button id="doctab-btn-mes-docs" class="doc-tab doc-tab--active" role="tab" data-doctab="mes-docs" aria-selected="true" aria-controls="doctab-mes-docs" tabindex="0">
              <span aria-hidden="true">📄</span> Mes documents
            </button>
            <button id="doctab-btn-confidentialite" class="doc-tab" role="tab" data-doctab="confidentialite" aria-selected="false" aria-controls="doctab-confidentialite" tabindex="-1">
              <span aria-hidden="true">🔒</span> Confidentialité &amp; stockage
            </button>
          </div>

          <!-- Panneau : Mes documents -->
          <div id="doctab-mes-docs" class="doc-tabpanel" role="tabpanel" aria-labelledby="doctab-btn-mes-docs" tabindex="0">

            <div class="panel" style="margin-bottom:20px;">
              <div class="panel__head">
                <h3>Documents professionnels</h3>
