---
import BaseLayout from '../layouts/BaseLayout.astro';
import spaces from '../data/spaces.json';

// Table de correspondance id → titre des espaces (pour afficher le nom dans les demandes)
const spacesMap = Object.fromEntries(spaces.map((s: any) => [s.id, s.title]));
---

<BaseLayout title="Mon espace — MOB'SS" description="Votre tableau de bord MOB'SS.">

  <!-- ÉTAT DE CHARGEMENT -->
  <div id="dash-loading" style="text-align:center;padding:120px 24px;color:var(--color-text-soft);">
    <p style="font-size:1.05rem;">Chargement de votre espace…</p>
  </div>

  <!-- ÉTAT NON CONNECTÉ -->
  <div id="dash-anonymous" style="display:none;text-align:center;padding:120px 24px;">
    <div style="font-size:3rem;margin-bottom:16px;">🔐</div>
    <h1>Connectez-vous pour accéder à votre espace</h1>
    <p style="color:var(--color-text-soft);margin-bottom:24px;">Votre tableau de bord MOB'SS vous attend.</p>
    <a href="/connexion" class="btn btn--primary btn--lg">Se connecter</a>
  </div>

  <!-- BANNIÈRE PROFIL INCOMPLET -->
  <div id="dash-incomplete-banner" style="display:none;background:#FFF8DC;border-bottom:2px solid #E8D87A;padding:14px 24px;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <span style="color:#6B5800;font-size:0.95rem;">
        ✏️ <strong>Votre profil est incomplet.</strong> Complétez-le pour apparaître dans l'annuaire et recevoir des demandes de remplacement.
      </span>
      <a href="/completer-profil" class="btn btn--primary" style="white-space:nowrap;">Compléter mon profil →</a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       DASHBOARD PRATICIEN
       ═══════════════════════════════════════════════════════════ -->
  <div id="dash-praticien" style="display:none;">
    <div class="dash-layout">

      <!-- Sidebar -->
      <aside class="dash-side">
        <nav aria-label="Navigation du tableau de bord">
          <button class="dash-nav-btn is-active" data-section="overview" aria-current="page">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
            Vue d'ensemble
          </button>
          <button class="dash-nav-btn" data-section="demandes">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Mes demandes
            <span id="badge-pending" style="display:none;background:var(--color-primary);color:#fff;border-radius:20px;padding:1px 7px;font-size:0.72rem;font-weight:700;margin-left:auto;">0</span>
          </button>
          <button class="dash-nav-btn" data-section="profil">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Mon profil
          </button>
          <button class="dash-nav-btn" data-section="remplacements">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            Remplacements
          </button>
          <a href="/explorez" class="dash-nav-btn" style="text-decoration:none;">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 7-8 13-8 13S4 17 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Trouver un espace
          </a>
          <button class="dash-nav-btn" data-section="parametres">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            Paramètres
          </button>
        </nav>
      </aside>

      <!-- Contenu principal -->
      <div class="dash-main">

        <!-- En-tête -->
        <div class="dash-head">
          <div>
            <h1>Bonjour <span id="prat-prenom">—</span> 👋</h1>
            <p style="margin:0;color:var(--color-text-soft);" id="prat-subtitle">Voici votre activité sur MOB'SS.</p>
          </div>
          <a href="/explorez" class="btn btn--primary">+ Réserver un espace</a>
        </div>

        <!-- ── SECTION : Vue d'ensemble ── -->
        <div class="dash-section is-active" id="section-overview">

          <div class="stat-grid">
            <div class="stat">
              <div class="stat__label">Demandes envoyées</div>
              <p class="stat__value" id="stat-total">—</p>
              <div class="stat__delta">Total depuis l'inscription</div>
            </div>
            <div class="stat">
              <div class="stat__label">Demandes acceptées</div>
              <p class="stat__value" id="stat-acceptees" style="color:#2D6E3F;">—</p>
              <div class="stat__delta">Par les propriétaires d'espace</div>
            </div>
            <div class="stat">
              <div class="stat__label">En attente de réponse</div>
              <p class="stat__value" id="stat-attente" style="color:var(--color-primary);">—</p>
              <div class="stat__delta">Demandes en cours de traitement</div>
            </div>
            <div class="stat">
              <div class="stat__label">Visibilité annuaire</div>
              <p class="stat__value" id="stat-visibilite" style="font-size:1.4rem;">—</p>
              <div class="stat__delta">Profil public MOB'SS</div>
            </div>
          </div>

          <!-- Dernières demandes -->
          <div class="panel" style="margin-top:28px;">
            <div class="panel__head">
              <h3>Dernières demandes</h3>
              <button class="btn btn--ghost" data-section="demandes" style="font-size:0.9rem;">Tout voir →</button>
            </div>
            <div id="overview-demandes-list">
              <p style="color:var(--color-text-soft);text-align:center;padding:32px 24px;">Chargement…</p>
            </div>
          </div>

          <!-- Actions rapides -->
          <div class="grid grid--3" style="margin-top:24px;gap:16px;">
            <div class="card" style="padding:20px;cursor:pointer;" onclick="document.querySelector('[data-section=profil]').click()">
              <div style="font-size:1.8rem;margin-bottom:8px;">👤</div>
              <strong>Compléter mon profil</strong>
              <p style="margin:4px 0 0;font-size:0.88rem;color:var(--color-text-soft);">Augmentez votre visibilité dans l'annuaire</p>
            </div>
            <a href="/explorez" class="card" style="padding:20px;text-decoration:none;color:inherit;display:block;">
              <div style="font-size:1.8rem;margin-bottom:8px;">🗺️</div>
              <strong>Trouver un espace</strong>
              <p style="margin:4px 0 0;font-size:0.88rem;color:var(--color-text-soft);">Consultez les espaces disponibles près de chez vous</p>
            </a>
            <div class="card" style="padding:20px;cursor:pointer;" onclick="document.querySelector('[data-section=remplacements]').click()">
              <div style="font-size:1.8rem;margin-bottom:8px;">🔄</div>
              <strong>Remplacements</strong>
              <p style="margin:4px 0 0;font-size:0.88rem;color:var(--color-text-soft);">Gérez votre disponibilité pour des remplacements</p>
            </div>
          </div>
        </div>

        <!-- ── SECTION : Mes demandes ── -->
        <div class="dash-section" id="section-demandes" style="display:none;">
          <div class="panel">
            <div class="panel__head">
              <h3>Mes demandes d'espace</h3>
              <a href="/explorez" class="btn btn--primary" style="font-size:0.9rem;">+ Nouvelle demande</a>
            </div>

            <!-- Filtres statut -->
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
              <button class="btn btn--primary dem-filter" data-filter="all" style="font-size:0.85rem;padding:6px 16px;">Toutes</button>
              <button class="btn btn--outline dem-filter" data-filter="en_attente" style="font-size:0.85rem;padding:6px 16px;">En attente</button>
              <button class="btn btn--outline dem-filter" data-filter="acceptee" style="font-size:0.85rem;padding:6px 16px;">Acceptées</button>
              <button class="btn btn--outline dem-filter" data-filter="refusee" style="font-size:0.85rem;padding:6px 16px;">Refusées</button>
            </div>

            <div id="demandes-list">
              <p style="color:var(--color-text-soft);text-align:center;padding:48px 24px;">Chargement…</p>
            </div>
          </div>
        </div>

        <!-- ── SECTION : Mon profil ── -->
        <div class="dash-section" id="section-profil" style="display:none;">

          <!-- Carte profil -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;" class="profil-grid">

            <!-- Aperçu -->
            <div class="panel">
              <div class="panel__head">
                <h3>Aperçu public</h3>
                <a href="/completer-profil" class="btn btn--ghost" style="font-size:0.88rem;">✏️ Modifier</a>
              </div>
              <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;">
                <div id="profil-avatar" style="width:60px;height:60px;border-radius:14px;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.4rem;flex-shrink:0;">?</div>
                <div>
                  <strong id="profil-nom" style="font-size:1.1rem;display:block;">—</strong>
                  <span id="profil-specialite" style="color:var(--color-primary);font-size:0.9rem;font-weight:600;">—</span>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:8px;font-size:0.9rem;color:var(--color-text-soft);">
                <div>📍 <span id="profil-ville">Non renseignée</span></div>
                <div>📧 <span id="profil-email">—</span></div>
              </div>
              <div id="profil-bio" style="margin-top:12px;font-size:0.88rem;color:var(--color-text-soft);font-style:italic;display:none;"></div>
              <div style="margin-top:16px;">
                <span id="profil-completude" style="font-size:0.85rem;"></span>
              </div>
            </div>

            <!-- Paramètres de visibilité -->
            <div class="panel">
              <div class="panel__head"><h3>Visibilité & disponibilités</h3></div>

              <div style="display:flex;flex-direction:column;gap:20px;">

                <!-- Toggle annuaire -->
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;">
                  <div>
                    <strong style="display:block;font-size:0.95rem;">Visible dans l'annuaire</strong>
                    <p style="margin:2px 0 0;font-size:0.85rem;color:var(--color-text-soft);">Votre profil apparaît dans la page /annuaire et peut être trouvé par les collectivités.</p>
                  </div>
                  <label class="toggle-switch" aria-label="Visibilité dans l'annuaire">
                    <input type="checkbox" id="toggle-annuaire" />
                    <span class="toggle-slider"></span>
                  </label>
                </div>

                <hr style="border:none;border-top:1px solid var(--color-border);margin:0;" />

                <!-- Toggle remplacements -->
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;">
                  <div>
                    <strong style="display:block;font-size:0.95rem;">Disponible pour remplacements</strong>
                    <p style="margin:2px 0 0;font-size:0.85rem;color:var(--color-text-soft);">Vous apparaissez dans la page /remplacements et pouvez être contacté par des confrères.</p>
                  </div>
                  <label class="toggle-switch" aria-label="Disponible pour remplacements">
                    <input type="checkbox" id="toggle-rempl" />
                    <span class="toggle-slider"></span>
                  </label>
                </div>

              </div>

              <div id="toggle-msg" style="display:none;margin-top:16px;padding:10px 14px;border-radius:var(--radius-md);font-size:0.88rem;"></div>
            </div>
          </div>

          <div style="margin-top:20px;text-align:center;">
            <a href="/completer-profil" class="btn btn--primary btn--lg">✏️ Modifier mon profil complet</a>
          </div>
        </div>

        <!-- ── SECTION : Remplacements ── -->
        <div class="dash-section" id="section-remplacements" style="display:none;">
          <div class="grid grid--2" style="gap:24px;align-items:start;">

            <div class="panel">
              <div class="panel__head"><h3>Ma disponibilité</h3></div>
              <div style="text-align:center;padding:24px 16px;">
                <div id="remp-status-icon" style="font-size:3rem;margin-bottom:12px;">⏸️</div>
                <p id="remp-status-text" style="font-size:1.05rem;font-weight:600;margin-bottom:8px;">Chargement…</p>
                <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:24px;">
                  Activez votre disponibilité pour apparaître dans la page Remplacements et être contacté par des confrères.
                </p>
                <label class="toggle-switch" aria-label="Disponible pour remplacements" style="margin:0 auto 20px;display:block;width:fit-content;">
                  <input type="checkbox" id="toggle-rempl-2" />
                  <span class="toggle-slider"></span>
                </label>
                <p style="font-size:0.82rem;color:var(--color-text-soft);">Modifie également le paramètre dans "Mon profil"</p>
              </div>
            </div>

            <div class="panel">
              <div class="panel__head"><h3>Trouver un remplaçant</h3></div>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
                Vous cherchez un confrère disponible pour vous remplacer ? Consultez l'annuaire des praticiens disponibles.
              </p>
              <a href="/remplacements" class="btn btn--primary" style="width:100%;text-align:center;display:block;">Voir les remplaçants disponibles →</a>
              <div class="card" style="margin-top:16px;padding:16px;background:var(--color-cream-soft);">
                <strong style="font-size:0.9rem;">💡 Comment ça marche</strong>
                <p style="margin:6px 0 0;font-size:0.85rem;color:var(--color-text-soft);">
                  MOB'SS vous met en relation directement. Échangez vos coordonnées et organisez le remplacement entre vous. Gratuit, sans intermédiaire.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ── SECTION : Paramètres ── -->
        <div class="dash-section" id="section-parametres" style="display:none;">
          <div class="panel" style="max-width:520px;">
            <div class="panel__head"><h3>Paramètres du compte</h3></div>
            <div style="display:flex;flex-direction:column;gap:16px;">
              <div>
                <label style="font-size:0.88rem;color:var(--color-text-soft);display:block;margin-bottom:4px;">Adresse email</label>
                <div id="param-email" style="font-weight:600;">—</div>
              </div>
              <hr style="border:none;border-top:1px solid var(--color-border);" />
              <div>
                <label style="font-size:0.88rem;color:var(--color-text-soft);display:block;margin-bottom:4px;">Rôle sur la plateforme</label>
                <div id="param-role" style="font-weight:600;text-transform:capitalize;">—</div>
              </div>
              <hr style="border:none;border-top:1px solid var(--color-border);" />
              <div>
                <p style="font-size:0.9rem;color:var(--color-text-soft);margin-bottom:12px;">
                  Vous souhaitez modifier votre email ou supprimer votre compte ? Contactez-nous.
                </p>
                <a href="/contact" class="btn btn--outline">Contacter MOB'SS</a>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /dash-main -->
    </div><!-- /dash-layout -->
  </div><!-- /dash-praticien -->


  <!-- ═══════════════════════════════════════════════════════════
       DASHBOARD HÔTE (collectivité / entreprise)
       ═══════════════════════════════════════════════════════════ -->
  <div id="dash-hote" style="display:none;">
    <div class="dash-layout">
      <aside class="dash-side">
        <nav aria-label="Navigation du tableau de bord">
          <button class="dash-nav-btn is-active" data-section="hote-overview">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
            Vue d'ensemble
          </button>
          <button class="dash-nav-btn" data-section="hote-espaces">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/></svg>
            Mes espaces
          </button>
          <a href="/annuaire" class="dash-nav-btn" style="text-decoration:none;">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Trouver un praticien
          </button>
          <button class="dash-nav-btn" data-section="hote-impact">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            Impact territorial
          </button>
        </nav>
      </aside>

      <div class="dash-main">
        <div class="dash-head">
          <div>
            <h1>Bonjour <span id="hote-prenom">—</span> 👋</h1>
            <p style="margin:0;color:var(--color-text-soft);">Voici l'activité de votre structure sur MOB'SS.</p>
          </div>
          <a href="/deposer-annonce" class="btn btn--primary">+ Déposer un espace</a>
        </div>

        <!-- Vue d'ensemble hôte -->
        <div class="dash-section is-active" id="hote-overview">
          <div class="stat-grid">
            <div class="stat">
              <div class="stat__label">Espaces référencés</div>
              <p class="stat__value">—</p>
              <div class="stat__delta">Publiés sur la plateforme</div>
            </div>
            <div class="stat">
              <div class="stat__label">Demandes reçues</div>
              <p class="stat__value">—</p>
              <div class="stat__delta">Depuis votre inscription</div>
            </div>
            <div class="stat">
              <div class="stat__label">Praticiens accueillis</div>
              <p class="stat__value">—</p>
              <div class="stat__delta">Estimation</div>
            </div>
            <div class="stat">
              <div class="stat__label">Heures mises à dispo</div>
              <p class="stat__value">—</p>
              <div class="stat__delta">Depuis votre inscription</div>
            </div>
          </div>

          <div class="grid grid--2" style="gap:20px;margin-top:24px;">
            <div class="panel">
              <div class="panel__head"><h3>Prochaine étape</h3></div>
              <div style="text-align:center;padding:24px 16px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">🏢</div>
                <h3 style="margin-bottom:8px;">Déposez votre premier espace</h3>
                <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
                  Mettez à disposition une salle, un gymnase ou tout espace adapté pour permettre à des praticiens du sport et de la santé d'exercer près de chez vous.
                </p>
                <a href="/deposer-annonce" class="btn btn--primary">Déposer un espace →</a>
              </div>
            </div>
            <div class="panel">
              <div class="panel__head"><h3>Trouver un praticien</h3></div>
              <div style="text-align:center;padding:24px 16px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">🩺</div>
                <h3 style="margin-bottom:8px;">Parcourez l'annuaire</h3>
                <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;">
                  Découvrez les praticiens du sport et de la santé inscrits sur MOB'SS et disponibles pour intervenir dans votre structure.
                </p>
                <a href="/annuaire" class="btn btn--outline">Voir l'annuaire →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Mes espaces hôte -->
        <div class="dash-section" id="hote-espaces" style="display:none;">
          <div class="panel">
            <div class="panel__head">
              <h3>Vos espaces</h3>
              <a href="/deposer-annonce" class="btn btn--primary" style="font-size:0.9rem;">+ Nouvel espace</a>
            </div>
            <p style="color:var(--color-text-soft);text-align:center;padding:48px 24px;">
              La gestion des espaces sera disponible prochainement depuis ce tableau de bord.<br />
              En attendant, <a href="/deposer-annonce">référencez votre espace</a> et consultez les <a href="/annuaire">praticiens disponibles</a>.
            </p>
          </div>
        </div>

        <!-- Impact territorial hôte -->
        <div class="dash-section" id="hote-impact" style="display:none;">
          <div class="grid grid--3" style="gap:20px;">
            <div class="card" style="padding:24px;text-align:center;">
              <div style="font-size:2.5rem;margin-bottom:12px;">👥</div>
              <h3 style="margin-bottom:6px;">Accès aux soins</h3>
              <p style="color:var(--color-text-soft);font-size:0.88rem;">En mettant vos espaces à disposition, vous favorisez l'accès aux soins et au sport pour vos administrés.</p>
            </div>
            <div class="card" style="padding:24px;text-align:center;">
              <div style="font-size:2.5rem;margin-bottom:12px;">🌱</div>
              <h3 style="margin-bottom:6px;">Territoire attractif</h3>
              <p style="color:var(--color-text-soft);font-size:0.88rem;">Attirer des praticiens de santé renforce l'attractivité de votre territoire et valorise vos espaces sous-utilisés.</p>
            </div>
            <div class="card" style="padding:24px;text-align:center;">
              <div style="font-size:2.5rem;margin-bottom:12px;">🤝</div>
              <h3 style="margin-bottom:6px;">Collaboration gagnant-gagnant</h3>
              <p style="color:var(--color-text-soft);font-size:0.88rem;">Les praticiens bénéficient d'espaces gratuits, votre structure valorise son patrimoine immobilier.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div><!-- /dash-hote -->

</BaseLayout>

<!-- ─────────────────────────────────────────────────────────────────────
     Styles spécifiques au dashboard
     ───────────────────────────────────────────────────────────────────── -->
<style>
  /* Navigation sidebar — boutons */
  .dash-nav-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border: none;
    background: transparent;
    border-radius: var(--radius-md);
    font-family: var(--font);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-soft);
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, color 0.15s;
    text-decoration: none;
  }
  .dash-nav-btn:hover {
    background: var(--color-cream-soft);
    color: var(--color-text);
  }
  .dash-nav-btn.is-active {
    background: var(--color-primary);
    color: #fff;
  }
  .dash-nav-btn.is-active .icon { stroke: #fff; }

  /* Toggle switch */
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-slider {
    position: absolute;
    inset: 0;
    background: #ccc;
    border-radius: 24px;
    transition: background 0.2s;
  }
  .toggle-slider::before {
    content: '';
    position: absolute;
    width: 18px; height: 18px;
    left: 3px; top: 3px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s;
  }
  .toggle-switch input:checked + .toggle-slider { background: var(--color-primary); }
  .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }

  /* Demande row */
  .dem-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .dem-row:last-child { border-bottom: none; }
  .dem-statut {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .dem-statut--attente { background: #FFF3CD; color: #856404; }
  .dem-statut--acceptee { background: #D4EDDA; color: #155724; }
  .dem-statut--refusee { background: #F8D7DA; color: #721C24; }

  /* Grid responsive profil */
  @media (max-width: 768px) {
    .profil-grid { grid-template-columns: 1fr !important; }
  }
</style>

<!-- ─────────────────────────────────────────────────────────────────────
     Script principal
     ───────────────────────────────────────────────────────────────────── -->
<script define:vars={{ spacesMap }}>
  import { supabase } from '../lib/supabase';

  // ── Éléments DOM ──────────────────────────────────────────────────────────────
  const loadingEl  = document.getElementById('dash-loading');
  const anonEl     = document.getElementById('dash-anonymous');
  const pratEl     = document.getElementById('dash-praticien');
  const hoteEl     = document.getElementById('dash-hote');
  const bannerEl   = document.getElementById('dash-incomplete-banner');

  // ── Navigation sidebar ────────────────────────────────────────────────────────
  function initNav(dashEl) {
    const navBtns  = dashEl.querySelectorAll('.dash-nav-btn[data-section]');
    const sections = dashEl.querySelectorAll('.dash-section');

    function activate(targetId) {
      navBtns.forEach(b => {
        b.classList.toggle('is-active', b.dataset.section === targetId);
        b.setAttribute('aria-current', b.dataset.section === targetId ? 'page' : 'false');
      });
      sections.forEach(s => {
        const show = s.id === targetId;
        s.style.display = show ? '' : 'none';
        s.classList.toggle('is-active', show);
      });
    }

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => activate(btn.dataset.section));
    });

    // Liens "Tout voir" dans l'overview
    dashEl.querySelectorAll('button[data-section]').forEach(btn => {
      if (!btn.classList.contains('dash-nav-btn')) {
        btn.addEventListener('click', () => {
          activate(btn.dataset.section);
          const navBtn = dashEl.querySelector(`.dash-nav-btn[data-section="${btn.dataset.section}"]`);
          if (navBtn) navBtn.classList.add('is-active');
        });
      }
    });
  }

  // ── Formatage date ────────────────────────────────────────────────────────────
  function fmtDate(str) {
    if (!str) return '—';
    try {
      return new Date(str).toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
    } catch { return str; }
  }

  // ── Badge statut ──────────────────────────────────────────────────────────────
  function statutBadge(s) {
    const map = { en_attente: ['attente','⏳ En attente'], acceptee: ['acceptee','✅ Acceptée'], refusee: ['refusee','❌ Refusée'] };
    const [cls, label] = map[s] || ['attente', s];
    return `<span class="dem-statut dem-statut--${cls}">${label}</span>`;
  }

  // ── Rendu d'une ligne de demande ──────────────────────────────────────────────
  function renderDemRow(d) {
    const espaceName = spacesMap[d.space_id] || d.space_id;
    const horaires = d.heure_debut && d.heure_fin ? `${d.heure_debut}–${d.heure_fin}` : '';
    return `
      <div class="dem-row" data-statut="${d.statut}">
        <div style="flex:1;min-width:0;">
          <strong style="display:block;font-size:0.92rem;">${espaceName}</strong>
          <span style="font-size:0.82rem;color:var(--color-text-soft);">${fmtDate(d.date)}${horaires ? ' · ' + horaires : ''}${d.recurrence && d.recurrence !== 'Une seule fois' ? ' · ' + d.recurrence : ''}</span>
        </div>
        ${statutBadge(d.statut)}
      </div>`;
  }

  // ── Dashboard Praticien ───────────────────────────────────────────────────────
  async function loadPraticien(session, profile) {
    pratEl.style.display = 'block';
    initNav(pratEl);

    const prenom = profile?.prenom || session.user.email?.split('@')[0] || 'vous';
    document.getElementById('prat-prenom').textContent = prenom;
    document.getElementById('param-email').textContent = session.user.email || '—';
    document.getElementById('param-role').textContent = profile?.role || 'praticien';

    // Profil section
    const initiales = ((profile?.prenom?.[0] || '') + (profile?.nom?.[0] || '')).toUpperCase() || '?';
    document.getElementById('profil-avatar').textContent = initiales;
    document.getElementById('profil-nom').textContent = `${profile?.prenom || '—'} ${profile?.nom || ''}`.trim();
    document.getElementById('profil-specialite').textContent = profile?.specialite || 'Spécialité non renseignée';
    document.getElementById('profil-ville').textContent = profile?.ville || 'Non renseignée';
    document.getElementById('profil-email').textContent = session.user.email || '—';
    if (profile?.bio) {
      const bioEl = document.getElementById('profil-bio');
      bioEl.textContent = profile.bio;
      bioEl.style.display = 'block';
    }

    // Complétude profil
    const fields = [profile?.prenom, profile?.nom, profile?.specialite, profile?.ville, profile?.bio];
    const filled = fields.filter(Boolean).length;
    const pct = Math.round((filled / fields.length) * 100);
    const completudeEl = document.getElementById('profil-completude');
    const color = pct === 100 ? '#2D6E3F' : pct >= 60 ? '#856404' : 'var(--color-primary)';
    completudeEl.innerHTML = `<span style="color:${color};font-weight:600;">Profil complété à ${pct}%</span>`;

    // Bannière si incomplet
    if (!profile?.prenom || !profile?.specialite) {
      bannerEl.style.display = 'block';
    }

    // Toggles visibilité
    const toggleAnnuaire = document.getElementById('toggle-annuaire');
    const toggleRempl    = document.getElementById('toggle-rempl');
    const toggleRempl2   = document.getElementById('toggle-rempl-2');
    toggleAnnuaire.checked = profile?.visible_annuaire ?? true;
    toggleRempl.checked    = profile?.disponible_remplacement ?? false;
    toggleRempl2.checked   = profile?.disponible_remplacement ?? false;

    // Statut remplacement
    const updateRemplStatus = (checked) => {
      document.getElementById('remp-status-icon').textContent = checked ? '✅' : '⏸️';
      document.getElementById('remp-status-text').textContent = checked
        ? 'Vous êtes disponible pour des remplacements'
        : 'Vous n\'êtes pas disponible pour des remplacements';
    };
    updateRemplStatus(toggleRempl2.checked);

    // Stat visibilité
    document.getElementById('stat-visibilite').textContent = (profile?.visible_annuaire ?? true) ? '✅ Visible' : '❌ Masqué';

    // Fonction de sauvegarde toggle
    async function saveToggle(field, value, el) {
      const msgEl = document.getElementById('toggle-msg');
      try {
        const { error } = await supabase.from('profiles').update({ [field]: value }).eq('id', session.user.id);
        if (error) throw error;
        if (msgEl) {
          msgEl.style.display = 'block';
          msgEl.style.background = '#D4EDDA';
          msgEl.style.color = '#155724';
          msgEl.textContent = '✓ Sauvegardé';
          setTimeout(() => { msgEl.style.display = 'none'; }, 2000);
        }
        if (field === 'visible_annuaire') {
          document.getElementById('stat-visibilite').textContent = value ? '✅ Visible' : '❌ Masqué';
        }
      } catch (e) {
        if (msgEl) {
          msgEl.style.display = 'block';
          msgEl.style.background = '#F8D7DA';
          msgEl.style.color = '#721C24';
          msgEl.textContent = '⚠️ Erreur de sauvegarde';
        }
        if (el) el.checked = !value; // revert
      }
    }

    toggleAnnuaire.addEventListener('change', () => saveToggle('visible_annuaire', toggleAnnuaire.checked, toggleAnnuaire));
    toggleRempl.addEventListener('change', () => {
      toggleRempl2.checked = toggleRempl.checked;
      updateRemplStatus(toggleRempl.checked);
      saveToggle('disponible_remplacement', toggleRempl.checked, toggleRempl);
    });
    toggleRempl2.addEventListener('change', () => {
      toggleRempl.checked = toggleRempl2.checked;
      updateRemplStatus(toggleRempl2.checked);
      saveToggle('disponible_remplacement', toggleRempl2.checked, toggleRempl2);
    });

    // ── Chargement des demandes ───────────────────────────────────────────────
    let allDemandes = [];

    try {
      const { data, error } = await supabase
        .from('demandes')
        .select('*')
        .eq('user_id', session.user.id)
        .order('created_at', { ascending: false });

      if (!error && data) {
        allDemandes = data;

        // Stats
        const total    = data.length;
        const acceptee = data.filter(d => d.statut === 'acceptee').length;
        const attente  = data.filter(d => d.statut === 'en_attente').length;

        document.getElementById('stat-total').textContent    = total;
        document.getElementById('stat-acceptees').textContent = acceptee;
        document.getElementById('stat-attente').textContent   = attente;

        // Badge sidebar
        if (attente > 0) {
          const badge = document.getElementById('badge-pending');
          badge.textContent = attente;
          badge.style.display = 'inline';
        }

        // Dernières demandes (vue d'ensemble — 5 max)
        const overviewEl = document.getElementById('overview-demandes-list');
        if (total === 0) {
          overviewEl.innerHTML = `<p style="color:var(--color-text-soft);text-align:center;padding:32px 24px;">
            Vous n'avez pas encore envoyé de demande.<br/>
            <a href="/explorez">Explorez les espaces disponibles →</a>
          </p>`;
        } else {
          overviewEl.innerHTML = data.slice(0, 5).map(renderDemRow).join('');
        }

        // Liste complète des demandes
        renderDemandesList(data, 'all');
      }
    } catch (e) {
      console.warn('Demandes non chargées', e);
      document.getElementById('stat-total').textContent = '—';
      document.getElementById('stat-acceptees').textContent = '—';
      document.getElementById('stat-attente').textContent = '—';
    }

    // Filtres demandes
    function renderDemandesList(data, filter) {
      const listEl = document.getElementById('demandes-list');
      const filtered = filter === 'all' ? data : data.filter(d => d.statut === filter);
      if (filtered.length === 0) {
        listEl.innerHTML = `<p style="color:var(--color-text-soft);text-align:center;padding:48px 24px;">
          ${filter === 'all' ? 'Aucune demande pour l\'instant. <a href="/explorez">Trouver un espace →</a>' : 'Aucune demande dans cette catégorie.'}
        </p>`;
      } else {
        listEl.innerHTML = filtered.map(renderDemRow).join('');
      }
    }

    pratEl.querySelectorAll('.dem-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        pratEl.querySelectorAll('.dem-filter').forEach(b => {
          b.classList.remove('btn--primary');
          b.classList.add('btn--outline');
        });
        btn.classList.add('btn--primary');
        btn.classList.remove('btn--outline');
        renderDemandesList(allDemandes, btn.dataset.filter);
      });
    });
  }

  // ── Dashboard Hôte ────────────────────────────────────────────────────────────
  function loadHote(profile, fallback) {
    hoteEl.style.display = 'block';
    initNav(hoteEl);
    document.getElementById('hote-prenom').textContent = profile?.prenom || fallback;
  }

  // ── Point d'entrée ────────────────────────────────────────────────────────────
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session?.user) {
      loadingEl.style.display = 'none';
      anonEl.style.display = 'block';
      return;
    }

    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role, prenom, nom, specialite, ville, bio, visible_annuaire, disponible_remplacement, telephone')
        .eq('id', session.user.id)
        .single();

      loadingEl.style.display = 'none';

      if (profile?.role === 'collectivite' || profile?.role === 'entreprise') {
        loadHote(profile, session.user.email?.split('@')[0] || 'vous');
      } else {
        loadPraticien(session, profile);
      }
    } catch (e) {
      loadingEl.style.display = 'none';
      loadPraticien(session, null);
    }
  });
</script>
