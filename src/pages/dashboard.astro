    position: sticky;
    top: var(--header-h, 88px);
    height: calc(100vh - var(--header-h, 88px));
    overflow-y: auto;
    background: #fff;
    border-right: 1px solid var(--color-border);
    padding: 20px 12px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dash-side__user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 16px;
    border-bottom: 1px solid var(--color-border);
