<script>
  import { supabase } from '../lib/supabase';

  const spacesMap: Record<string, string> = JSON.parse(
    document.getElementById('spaces-map-data')?.textContent || '{}'
  );

  const loadingEl = document.getElementById('dash-loading') as HTMLElement;
  const anonEl    = document.getElementById('dash-anonymous') as HTMLElement;
  const pratEl    = document.getElementById('dash-praticien') as HTMLElement;
  const hoteEl    = document.getElementById('dash-hote') as HTMLElement;
  const bannerEl  = document.getElementById('dash-incomplete-banner') as HTMLElement;

  // ── Navigation sidebar — VERSION CORRIGÉE ─────────────────────────────────────
  // Les IDs des sections correspondent EXACTEMENT aux data-section des boutons
  function initNav(dashEl: HTMLElement) {
    const navBtns  = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-nav-btn[data-section]'));
    const sections = Array.from(dashEl.querySelectorAll<HTMLElement>('.dash-section'));

    function activate(targetId: string) {
      // Boutons sidebar
      navBtns.forEach(b => {
        const active = b.dataset.section === targetId;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-current', active ? 'page' : 'false');
      });
      // Sections contenu
      sections.forEach(s => {
        const show = s.id === targetId;
        s.style.display = show ? '' : 'none';
      });
    }

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => activate(btn.dataset.section!));
    });

    // Boutons "Tout voir →" et quick actions dans l'overview
    dashEl.querySelectorAll<HTMLElement>('[data-goto]').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.goto!;
        activate(target);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  // ── Formatage date ────────────────────────────────────────────────────────────
  function fmtDate(str: string | null): string {
    if (!str) return '—';
    try { return new Date(str).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); }
    catch { return str; }
  }

  // ── Badge statut demande ──────────────────────────────────────────────────────
  function statutBadge(s: string): string {
    const map: Record<string, [string, string]> = {
      en_attente: ['attente',  '⏳ En attente'],
      acceptee:   ['acceptee', '✅ Acceptée'],
      refusee:    ['refusee',  '❌ Refusée'],
    };
    const [cls, label] = map[s] || ['attente', s];
    return `<span class="dem-statut dem-statut--${cls}">${label}</span>`;
  }

  // ── Ligne demande ─────────────────────────────────────────────────────────────
  function renderDemRow(d: any): string {
    const nom    = spacesMap[d.space_id] || d.space_id || 'Espace';
    const horaire = d.heure_debut && d.heure_fin ? ` · ${d.heure_debut}–${d.heure_fin}` : '';
    const recur  = d.recurrence && d.recurrence !== 'Une seule fois' ? ` · ${d.recurrence}` : '';
    return `
      <div class="dem-row" data-statut="${d.statut}">
        <div style="flex:1;min-width:0;">
          <strong style="display:block;font-size:0.9rem;">${nom}</strong>
          <span style="font-size:0.8rem;color:var(--color-text-soft);">${fmtDate(d.date)}${horaire}${recur}</span>
        </div>
        ${statutBadge(d.statut)}
      </div>`;
  }

  // ── Dashboard Praticien ───────────────────────────────────────────────────────
  async function loadPraticien(session: any, profile: any) {
    pratEl.style.display = 'block';
    initNav(pratEl);

    // ── Visite guidée ──────────────────────────────────────────────────────
    const fabDash = document.getElementById('tour-fab-dash') as HTMLElement;
    if (fabDash) fabDash.style.display = '';
    if (!localStorage.getItem('mobss_tour_dashboard')) {
      setTimeout(function() { if (window.startTour) window.startTour(window._dashTourSteps, 'mobss_tour_dashboard'); }, 1200);
    }
    // ───────────────────────────────────────────────────────────────────────

    const prenom = profile?.prenom || session.user.email?.split('@')[0] || 'vous';
    const nom    = profile?.nom    || '';
    const initiales = ((profile?.prenom?.[0] || '') + (profile?.nom?.[0] || '')).toUpperCase() || '?';

    // Sidebar user
    (document.getElementById('side-avatar') as HTMLElement).textContent = initiales;
    (document.getElementById('side-nom')    as HTMLElement).textContent = `${prenom} ${nom}`.trim();
    (document.getElementById('side-role')   as HTMLElement).textContent = 'Praticien·ne';

    // En-tête
    (document.getElementById('prat-prenom') as HTMLElement).textContent = prenom;

    // Section profil
    (document.getElementById('profil-avatar')    as HTMLElement).textContent = initiales;
    (document.getElementById('profil-nom')       as HTMLElement).textContent = `${prenom} ${nom}`.trim();
    (document.getElementById('profil-specialite')as HTMLElement).textContent = profile?.specialite || 'Spécialité non renseignée';
    (document.getElementById('profil-ville')     as HTMLElement).textContent = profile?.ville      || 'Non renseignée';
    (document.getElementById('profil-email')     as HTMLElement).textContent = session.user.email  || '—';
    (document.getElementById('profil-tel')       as HTMLElement).textContent = profile?.telephone  || 'Non renseigné';
    if (profile?.bio) {
      const bioEl = document.getElementById('profil-bio') as HTMLElement;
      bioEl.textContent = profile.bio;
      bioEl.style.display = 'block';
    }

    // Complétude profil
    const fields = [profile?.prenom, profile?.nom, profile?.specialite, profile?.ville, profile?.bio, profile?.telephone];
    const filled = fields.filter(Boolean).length;
    const pct    = Math.round((filled / fields.length) * 100);
    const color  = pct === 100 ? '#065F46' : pct >= 60 ? '#92400E' : 'var(--color-primary)';
    (document.getElementById('pct-label') as HTMLElement).style.color = color;
    (document.getElementById('pct-label') as HTMLElement).textContent = `${pct}%`;
    (document.getElementById('pct-bar')   as HTMLElement).style.width = `${pct}%`;
    (document.getElementById('pct-bar')   as HTMLElement).style.background = color;
    const missing = ['Prénom','Nom','Spécialité','Ville','Bio','Téléphone'].filter((_,i) => !fields[i]);
    (document.getElementById('pct-hint')  as HTMLElement).textContent =
      missing.length ? `Manquant : ${missing.join(', ')}` : '✅ Profil complet !';

    // Bannière si incomplet
    if (!profile?.prenom || !profile?.specialite) bannerEl.style.display = 'block';

    // Paramètres
    (document.getElementById('param-email') as HTMLElement).textContent = session.user.email || '—';
    (document.getElementById('param-role')  as HTMLElement).textContent = profile?.role || 'praticien';
    (document.getElementById('param-date')  as HTMLElement).textContent = fmtDate(session.user.created_at);
    (document.getElementById('param-id')    as HTMLElement).textContent = session.user.id;

    // Toggles
    const tA  = document.getElementById('toggle-annuaire') as HTMLInputElement;
    const tR  = document.getElementById('toggle-rempl')    as HTMLInputElement;
    const tR2 = document.getElementById('toggle-rempl-2')  as HTMLInputElement;
    tA.checked  = profile?.visible_annuaire       ?? true;
    tR.checked  = profile?.disponible_remplacement ?? false;
    tR2.checked = profile?.disponible_remplacement ?? false;

    const updateRemplStatus = (on: boolean) => {
      (document.getElementById('remp-icon') as HTMLElement).textContent = on ? '✅' : '⏸️';
      (document.getElementById('remp-text') as HTMLElement).textContent = on
        ? 'Vous êtes disponible pour des remplacements'
        : 'Vous n\'êtes pas disponible pour des remplacements';
    };
    updateRemplStatus(tR2.checked);
    (document.getElementById('stat-visibilite') as HTMLElement).textContent =
      (profile?.visible_annuaire ?? true) ? '✅ Visible' : '❌ Masqué';

    async function saveToggle(field: string, value: boolean, el: HTMLInputElement) {
      const msgEl = document.getElementById('toggle-msg') as HTMLElement;
      try {
        const { error } = await supabase.from('profiles').update({ [field]: value }).eq('id', session.user.id);
        if (error) throw error;
        msgEl.style.display = 'block';
        msgEl.style.background = '#D1FAE5'; msgEl.style.color = '#065F46';
        msgEl.textContent = '✓ Sauvegardé';
        setTimeout(() => { msgEl.style.display = 'none'; }, 2500);
        if (field === 'visible_annuaire')
          (document.getElementById('stat-visibilite') as HTMLElement).textContent = value ? '✅ Visible' : '❌ Masqué';
      } catch {
        msgEl.style.display = 'block';
        msgEl.style.background = '#FEE2E2'; msgEl.style.color = '#991B1B';
        msgEl.textContent = '⚠️ Erreur de sauvegarde';
        el.checked = !value;
      }
    }

    tA.addEventListener('change', () => saveToggle('visible_annuaire', tA.checked, tA));
    tR.addEventListener('change', () => {
      tR2.checked = tR.checked; updateRemplStatus(tR.checked);
      saveToggle('disponible_remplacement', tR.checked, tR);
    });
    tR2.addEventListener('change', () => {
      tR.checked = tR2.checked; updateRemplStatus(tR2.checked);
      saveToggle('disponible_remplacement', tR2.checked, tR2);
    });

    // Réinitialisation mot de passe
    (document.getElementById('btn-reset-pwd') as HTMLButtonElement)?.addEventListener('click', async () => {
      const msgEl = document.getElementById('pwd-msg') as HTMLElement;
      msgEl.style.display = 'block';
      msgEl.style.background = '#FEF3C7'; msgEl.style.color = '#92400E';
      msgEl.textContent = 'Envoi en cours…';
      try {
        const { error } = await supabase.auth.resetPasswordForEmail(session.user.email, {
          redirectTo: window.location.origin + '/connexion'
        });
        if (error) throw error;
        msgEl.style.background = '#D1FAE5'; msgEl.style.color = '#065F46';
        msgEl.textContent = `✅ Email envoyé à ${session.user.email}. Vérifiez votre boîte mail.`;
      } catch {
        msgEl.style.background = '#FEE2E2'; msgEl.style.color = '#991B1B';
        msgEl.textContent = '⚠️ Erreur lors de l\'envoi. Réessayez ou contactez le support.';
      }
    });

    // Déconnexion
    document.getElementById('btn-logout-param')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    // ── Demandes ──────────────────────────────────────────────────────────────
    let allDemandes: any[] = [];
    try {
      const { data, error } = await supabase
        .from('demandes').select('*').eq('user_id', session.user.id)
        .order('created_at', { ascending: false });

      if (!error && data) {
        allDemandes = data;
        const total    = data.length;
        const acceptee = data.filter(d => d.statut === 'acceptee').length;
        const attente  = data.filter(d => d.statut === 'en_attente').length;

        (document.getElementById('stat-total')    as HTMLElement).textContent = String(total);
        (document.getElementById('stat-acceptees')as HTMLElement).textContent = String(acceptee);
        (document.getElementById('stat-attente')  as HTMLElement).textContent = String(attente);

        if (attente > 0) {
          const badge = document.getElementById('badge-pending') as HTMLElement;
          badge.textContent = String(attente);
          badge.style.display = 'inline';
        }

        const overviewEl = document.getElementById('overview-demandes-list') as HTMLElement;
        overviewEl.innerHTML = total === 0
          ? `<p style="color:var(--color-text-soft);text-align:center;padding:32px;">Aucune demande pour l'instant. <a href="/explorez">Trouver un espace →</a></p>`
          : data.slice(0, 5).map(renderDemRow).join('');

        renderDemandesList(data, 'all');
      }
    } catch {
      ['stat-total','stat-acceptees','stat-attente'].forEach(id =>
        ((document.getElementById(id) as HTMLElement).textContent = '—')
      );
    }

    function renderDemandesList(data: any[], filter: string) {
      const listEl   = document.getElementById('demandes-list') as HTMLElement;
      const filtered = filter === 'all' ? data : data.filter(d => d.statut === filter);
      listEl.innerHTML = filtered.length === 0
        ? `<p style="color:var(--color-text-soft);text-align:center;padding:48px;">${filter === 'all' ? 'Aucune demande. <a href="/explorez">Trouver un espace →</a>' : 'Aucune demande dans cette catégorie.'}</p>`
        : filtered.map(renderDemRow).join('');
    }

    pratEl.querySelectorAll<HTMLElement>('.dem-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        pratEl.querySelectorAll('.dem-filter').forEach(b => {
          b.classList.remove('btn--primary'); b.classList.add('btn--outline');
        });
        btn.classList.add('btn--primary'); btn.classList.remove('btn--outline');
        renderDemandesList(allDemandes, btn.dataset.filter!);
      });
    });
  }

  // ── Dashboard Hôte ────────────────────────────────────────────────────────────
  async function loadHote(session: any, profile: any) {
    hoteEl.style.display = 'block';
    initNav(hoteEl);

    // ── Visite guidée ──────────────────────────────────────────────────────
    const fabDash = document.getElementById('tour-fab-dash') as HTMLElement;
    if (fabDash) fabDash.style.display = '';
    if (!localStorage.getItem('mobss_tour_dashboard')) {
      setTimeout(function() { if (window.startTour) window.startTour(window._dashTourSteps, 'mobss_tour_dashboard'); }, 1200);
    }
    // ───────────────────────────────────────────────────────────────────────

    const prenom    = profile?.prenom || session.user.email?.split('@')[0] || 'vous';
    const initiales = ((profile?.prenom?.[0] || '') + (profile?.nom?.[0] || '')).toUpperCase() || '?';
    const roleLabel = profile?.role === 'entreprise' ? 'Entreprise' : 'Collectivité';

    (document.getElementById('hote-side-avatar') as HTMLElement).textContent = initiales;
    (document.getElementById('hote-side-nom')    as HTMLElement).textContent = prenom;
    (document.getElementById('hote-side-role')   as HTMLElement).textContent = roleLabel;
    (document.getElementById('hote-prenom')      as HTMLElement).textContent = prenom;

    (document.getElementById('hote-param-email') as HTMLElement).textContent = session.user.email || '—';
    (document.getElementById('hote-param-role')  as HTMLElement).textContent = roleLabel;
    (document.getElementById('hote-param-date')  as HTMLElement).textContent = fmtDate(session.user.created_at);

    // Reset password
    document.getElementById('hote-btn-reset-pwd')?.addEventListener('click', async () => {
      const msgEl = document.getElementById('hote-pwd-msg') as HTMLElement;
      msgEl.style.display = 'block';
      msgEl.style.background = '#FEF3C7'; msgEl.style.color = '#92400E';
      msgEl.textContent = 'Envoi en cours…';
      try {
        const { error } = await supabase.auth.resetPasswordForEmail(session.user.email, {
          redirectTo: window.location.origin + '/connexion'
        });
        if (error) throw error;
        msgEl.style.background = '#D1FAE5'; msgEl.style.color = '#065F46';
        msgEl.textContent = `✅ Email envoyé à ${session.user.email}.`;
      } catch {
        msgEl.style.background = '#FEE2E2'; msgEl.style.color = '#991B1B';
        msgEl.textContent = '⚠️ Erreur lors de l\'envoi.';
      }
    });

    // Déconnexion
    document.getElementById('hote-btn-logout')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    // ── Demandes reçues hôte ──────────────────────────────────────────────────
    let allHoteDemandes: any[] = [];
    let annoncesMap: Record<string, string> = {};

    async function loadHoteDemandes() {
      const listEl = document.getElementById('hote-demandes-list') as HTMLElement;
      try {
        // 1. Récupère les espaces de cet hôte
        const { data: annonces, error: errA } = await supabase
          .from('annonces')
          .select('id, titre')
          .eq('host_id', session.user.id);

        if (errA || !annonces || annonces.length === 0) {
          listEl.innerHTML = `
            <div style="text-align:center;padding:48px 24px;">
              <div style="font-size:2.5rem;margin-bottom:12px;">📭</div>
              <h3 style="margin-bottom:8px;">Aucun espace référencé</h3>
              <p style="color:var(--color-text-soft);font-size:0.9rem;margin-bottom:20px;max-width:360px;margin-left:auto;margin-right:auto;">
                Déposez un espace pour commencer à recevoir des demandes de praticiens.
              </p>
              <a href="/deposer-annonce" class="btn btn--primary">Déposer un espace →</a>
            </div>`;
          return;
        }

        // Construire la map id → titre pour l'affichage
        annonces.forEach((a: any) => { annoncesMap[a.id] = a.titre || a.id; });
        const spaceIds = annonces.map((a: any) => a.id);

        // 2. Récupère les demandes pour ces espaces
        const { data: demandes, error: errD } = await supabase
          .from('demandes')
          .select('*')
          .in('space_id', spaceIds)
          .order('created_at', { ascending: false });

        if (errD) throw errD;
        allHoteDemandes = demandes || [];

        // Met à jour le badge dans la sidebar
        const pending = allHoteDemandes.filter(d => d.statut === 'en_attente').length;
        const badgeEl = document.getElementById('hote-badge-pending') as HTMLElement;
        if (pending > 0) {
          badgeEl.textContent = String(pending);
          badgeEl.style.display = 'inline';
        }

        renderHoteDemandes(allHoteDemandes, 'all');
      } catch (e) {
        listEl.innerHTML = `<p style="color:#991B1B;padding:24px;text-align:center;">⚠️ Erreur de chargement. Réessayez plus tard.</p>`;
      }
    }

    function renderHoteDemRow(d: any): string {
      const spaceName = annoncesMap[d.space_id] || d.space_id || 'Espace';
      const horaire   = d.heure_debut && d.heure_fin ? ` · ${d.heure_debut}–${d.heure_fin}` : '';
      const recur     = d.recurrence && d.recurrence !== 'Une seule fois' ? ` · ${d.recurrence}` : '';
      const praticien = d.praticien_nom || d.user_email || 'Praticien';
      const actions   = d.statut === 'en_attente'
        ? `<div style="display:flex;gap:8px;flex-shrink:0;">
             <button class="btn btn--outline hote-action-btn" data-id="${d.id}" data-action="acceptee"
               style="font-size:0.8rem;padding:6px 12px;color:#065F46;border-color:#6EE7B7;">
               ✅ Accepter
             </button>
             <button class="btn btn--outline hote-action-btn" data-id="${d.id}" data-action="refusee"
               style="font-size:0.8rem;padding:6px 12px;color:#991B1B;border-color:#FCA5A5;">
               ❌ Refuser
             </button>
           </div>`
        : '';
      return `
        <div class="dem-row" data-id="${d.id}" data-statut="${d.statut}">
          <div style="flex:1;min-width:0;">
            <strong style="display:block;font-size:0.9rem;">${spaceName}</strong>
            <span style="font-size:0.8rem;color:var(--color-text-soft);">
              👤 ${praticien} · ${fmtDate(d.date)}${horaire}${recur}
            </span>
            ${d.message ? `<p style="margin:6px 0 0;font-size:0.82rem;color:var(--color-text-soft);font-style:italic;">"${d.message}"</p>` : ''}
          </div>
          ${statutBadge(d.statut)}
          ${actions}
        </div>`;
    }

    function renderHoteDemandes(data: any[], filter: string) {
      const listEl   = document.getElementById('hote-demandes-list') as HTMLElement;
      const filtered = filter === 'all' ? data : data.filter(d => d.statut === filter);
      if (filtered.length === 0) {
        listEl.innerHTML = `<p style="color:var(--color-text-soft);text-align:center;padding:48px;">
          ${filter === 'all' ? 'Aucune demande reçue pour le moment.' : 'Aucune demande dans cette catégorie.'}
        </p>`;
        return;
      }
      listEl.innerHTML = filtered.map(renderHoteDemRow).join('');
      // Attacher les boutons Accepter/Refuser
      listEl.querySelectorAll<HTMLButtonElement>('.hote-action-btn').forEach(btn => {
        btn.addEventListener('click', () => updateHoteDemandeStatut(btn.dataset.id!, btn.dataset.action as string));
      });
    }

    async function updateHoteDemandeStatut(id: string, statut: string) {
      const row = document.querySelector(`.dem-row[data-id="${id}"]`) as HTMLElement;
      if (row) {
        // Désactiver les boutons pendant la mise à jour
        row.querySelectorAll('button').forEach(b => { (b as HTMLButtonElement).disabled = true; });
      }
      try {
        const { error } = await supabase
          .from('demandes')
          .update({ statut })
          .eq('id', id);
        if (error) throw error;
        // Met à jour localement
        const idx = allHoteDemandes.findIndex(d => d.id === id);
        if (idx !== -1) allHoteDemandes[idx].statut = statut;
        // Recalcule badge
        const pending = allHoteDemandes.filter(d => d.statut === 'en_attente').length;
        const badgeEl = document.getElementById('hote-badge-pending') as HTMLElement;
        badgeEl.textContent = String(pending);
        badgeEl.style.display = pending > 0 ? 'inline' : 'none';
        // Re-render la liste avec le filtre actif
        const activeFilter = (hoteEl.querySelector('.hote-dem-filter.btn--primary') as HTMLElement)?.dataset.filter || 'all';
        renderHoteDemandes(allHoteDemandes, activeFilter);
      } catch {
        if (row) row.querySelectorAll('button').forEach(b => { (b as HTMLButtonElement).disabled = false; });
        alert('⚠️ Erreur lors de la mise à jour. Réessayez.');
      }
    }

    // Filtres
    hoteEl.querySelectorAll<HTMLElement>('.hote-dem-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        hoteEl.querySelectorAll('.hote-dem-filter').forEach(b => {
          b.classList.remove('btn--primary'); b.classList.add('btn--outline');
        });
        btn.classList.add('btn--primary'); btn.classList.remove('btn--outline');
        renderHoteDemandes(allHoteDemandes, btn.dataset.filter!);
      });
    });

    // Charger les demandes dès l'initialisation
    loadHoteDemandes();
  }

  // ── Point d'entrée ────────────────────────────────────────────────────────────
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session?.user) {
      loadingEl.style.display = 'none';
      anonEl.style.display = 'block';
      return;
    }
    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('role, prenom, nom, specialite, ville, bio, telephone, visible_annuaire, disponible_remplacement')
        .eq('id', session.user.id)
        .single();

      loadingEl.style.display = 'none';

      if (profile?.role === 'collectivite' || profile?.role === 'entreprise') {
        loadHote(session, profile);
      } else {
        loadPraticien(session, profile);
      }
    } catch {
      loadingEl.style.display = 'none';
      loadPraticien(session, null);
    }
  });
</script>
