---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mon espace — MOB'SS" description="Votre tableau de bord MOB'SS.">
  <div style="text-align:center;padding:140px 24px;color:var(--color-text-soft);">
    <div style="font-size:2rem;margin-bottom:12px;">⏳</div>
    <p style="font-size:1.05rem;">Chargement de votre espace…</p>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';

  // Passe les query params (ex: ?welcome=1) au sous-dashboard
  const qs = window.location.search;

  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session?.user) {
      window.location.replace('/connexion?retour=/dashboard');
      return;
    }

    // Lire le rôle depuis le profil (fallback sur user_metadata)
    const { data: profile } = await supabase
      .from('profiles')
      .select('role')
      .eq('id', session.user.id)
      .single();

    const role = profile?.role ?? session.user.user_metadata?.role ?? 'praticien';

    if (role === 'collectivite' || role === 'entreprise') {
      window.location.replace('/dashboard/hote' + qs);
    } else {
      window.location.replace('/dashboard/praticien' + qs);
    }
  });
</script>
