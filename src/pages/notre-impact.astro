---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Accueil","item":"https://mobss.fr/"},
    {"@type":"ListItem","position":2,"name":"Notre impact","item":"https://mobss.fr/notre-impact"}
  ]
});
const webpageLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Notre impact — MOB\'SS",
  "description": "Ce que MOB\'SS change concrètement : pour les professionnels de santé et du sport, pour les collectivités et entreprises, et pour les territoires touchés par les déserts médicaux.",
  "url": "https://mobss.fr/notre-impact",
  "inLanguage": "fr-FR",
  "isPartOf": {"@type":"WebSite","name":"MOB\'SS","url":"https://mobss.fr"}
});

---

<BaseLayout
  title="Notre impact — MOB'SS"
  description="Ce que MOB'SS change concrètement : pour les professionnels de santé et du sport, pour les collectivités et entreprises, et pour les territoires touchés par les déserts médicaux."
  currentPage="impact"
>
  <Fragment slot="head" set:html={`<script type="application/ld+json">${breadcrumbLd}</script><script type="application/ld+json">${webpageLd}</script>`} />


  <!-- HERO -->
  <PageHero
    eyebrow="Ce que MOB'SS change"
    title="Un impact concret, pour tous les acteurs"
    lead="MOB'SS ne part pas d'une intuition — elle part d'un constat chiffré et d'une ambition collective. Chaque espace qui s'ouvre, c'est un territoire qui progresse."
  />

  <!-- LES 4 IMPACTS -->
  <section class="section section--white" style="padding:72px 0;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:48px;">
        <span class="section__eyebrow">Impact par acteur</span>
        <h2>Quatre bénéficiaires, une même dynamique</h2>
      </header>

      <!-- Pour les professionnels -->
      <div class="impact-row">
        <div class="impact-row__badge impact-row__badge--pro">⚕️ Professionnels</div>
        <div class="impact-row__content">
          <h3>La possibilité d'exercer là où on a vraiment besoin d'eux</h3>
          <p>
            64 % des médecins seraient prêts à aller en désert médical si un espace adapté était disponible.
            MOB'SS rend ça possible — en leur donnant accès à des espaces conformes, vérifiés, et mis à disposition
            <strong>gratuitement</strong>. Plus besoin d'investir dans un cabinet fixe pour développer une clientèle
            en zone sous-dotée.
          </p>
          <div class="impact-chips">
            <span>Aucun loyer</span>
            <span>Créneaux flexibles</span>
            <span>Profil vérifié visible</span>
            <span>Annuaire public</span>
            <span>Réseau de remplacements</span>
          </div>
        </div>
        <div class="impact-row__stat">
          <div class="impact-big-stat">64 %</div>
          <div class="impact-big-stat__sub">des médecins iraient en désert médical si un espace était dispo</div>
          <div class="impact-big-stat__src">MACSF, 2023</div>
        </div>
      </div>

      <div class="impact-divider" aria-hidden="true"></div>

      <!-- Pour les espaces -->
      <div class="impact-row impact-row--reverse">
        <div class="impact-row__badge impact-row__badge--space">🏢 Collectivités &amp; Entreprises</div>
        <div class="impact-row__content">
          <h3>Des m² inutilisés transformés en valeur sociale — et en avantage fiscal</h3>
          <p>
            Vos bureaux sont vides 65 % du temps. Vos salles polyvalentes, gymnases, locaux reconvertis
            attendent. MOB'SS leur donne une utilité sociale mesurable, sans coût opérationnel supplémentaire.
            Pour les entreprises, la mise à disposition gracieuse ouvre droit à la <strong>réduction d'impôt mécénat</strong>
            (art. 238 bis CGI). Pour les collectivités, c'est un levier concret de politique de santé territoriale.
          </p>
          <div class="impact-chips">
            <span>Impact RSE mesurable</span>
            <span>Réduction d'impôt mécénat</span>
            <span>Tableau de bord territorial</span>
            <span>Zéro investissement</span>
            <span>Partenaires vérifiés</span>
          </div>
        </div>
        <div class="impact-row__stat">
          <div class="impact-big-stat">65 %</div>
          <div class="impact-big-stat__sub">des surfaces de bureaux sont vides la majeure partie du temps</div>
          <div class="impact-big-stat__src">Données bureaux, 2023</div>
        </div>
      </div>

      <div class="impact-divider" aria-hidden="true"></div>

      <!-- Pour les territoires -->
      <div class="impact-row">
        <div class="impact-row__badge impact-row__badge--territory">🗺️ Territoires</div>
        <div class="impact-row__content">
          <h3>Une réponse concrète aux déserts médicaux et sportifs</h3>
          <p>
            1 commune sur 3 est en désert médical. La santé est la première préoccupation des Français.
            MOB'SS offre aux élus locaux une solution déployable immédiatement, sans budget d'infrastructure,
            co-construite avec les acteurs du terrain et <strong>soutenue par la recherche</strong>.
            Chaque déploiement territorial est suivi par des indicateurs d'impact social mesurables.
          </p>
          <div class="impact-chips">
            <span>Indicateurs d'impact</span>
            <span>Sans investissement infra</span>
            <span>Déploiement rapide</span>
            <span>Recherche universitaire</span>
            <span>Co-construction locale</span>
          </div>
        </div>
        <div class="impact-row__stat">
          <div class="impact-big-stat">1/3</div>
          <div class="impact-big-stat__sub">des communes françaises est en désert médical</div>
          <div class="impact-big-stat__src">Croix-Rouge&nbsp;/ CRÉDOC, 2025</div>
        </div>
      </div>

    </div>
  </section>

  <!-- CHIFFRES CLÉS SYNTHÈSE -->
  <section class="section section--alt" style="padding:72px 0;">
    <div class="container" style="max-width:960px;">
      <header class="section__header" style="margin-bottom:40px;">
        <span class="section__eyebrow">L'urgence en données</span>
        <h2>Pourquoi agir maintenant</h2>
        <p class="section__lead">
          Chaque semaine sans solution, c'est une salle vide qui ne sert à rien et un patient qui attend trop longtemps.
        </p>
      </header>

      <div class="urgency-grid">
        <div class="urgency-card">
          <div class="urgency-card__val">76 %</div>
          <p>des Français estiment que l'accès aux soins s'est dégradé en 10 ans</p>
          <span>IFOP / Qare, 2025</span>
        </div>
        <div class="urgency-card">
          <div class="urgency-card__val">84 %</div>
          <p>des médecins n'ont jamais entendu parler d'une solution pour organiser des consultations hors cabinet</p>
          <span>MACSF, 2023</span>
        </div>
        <div class="urgency-card">
          <div class="urgency-card__val">6–8 M</div>
          <p>de personnes vivent dans une commune en désert médical en France</p>
          <span>Croix-Rouge / CRÉDOC, 2025</span>
        </div>
        <div class="urgency-card">
          <div class="urgency-card__val">N° 1</div>
          <p>La santé est la première préoccupation des Français, devant le pouvoir d'achat</p>
          <span>Croix-Rouge / CRÉDOC, 2025</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGE PLACEHOLDER -->
  <section class="section section--white" style="padding:72px 0;">
    <div class="container" style="max-width:760px;text-align:center;">
      <span class="section__eyebrow">Témoignage</span>
      <blockquote class="testimonial-quote">
        "MOB'SS nous a permis de proposer des consultations de kinésithérapie dans notre salle polyvalente,
        deux fois par semaine. Les habitants n'avaient plus à faire 40 km."
      </blockquote>
      <div class="testimonial-author">
        <div class="testimonial-author__avatar" aria-hidden="true">M</div>
        <div>
          <strong>Maire d'une commune de 3 000 habitants</strong>
          <span>Nouvelle-Aquitaine — Bêta-testeur MOB'SS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection title="Rejoignez le mouvement." />

</BaseLayout>

<style>
  /* Impact rows */
  .impact-row {
    display: grid;
    grid-template-columns: 1fr 2fr 180px;
    gap: 32px;
    align-items: start;
    padding: 32px 0;
  }
  .impact-row--reverse {
    grid-template-columns: 1fr 2fr 180px;
  }
  .impact-row__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    align-self: start;
    margin-top: 4px;
  }
  .impact-row__badge--pro       { background: var(--color-cream); color: var(--color-primary); }
  .impact-row__badge--space     { background: var(--color-text); color: #fff; }
  .impact-row__badge--territory { background: #d1fae5; color: #065f46; }
  .impact-row__content h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .impact-row__content p { font-size: 0.95rem; color: var(--color-text-soft); line-height: 1.65; margin: 0 0 14px; }
  .impact-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .impact-chips span {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    font-size: 0.8rem;
    color: var(--color-text-soft);
    font-weight: 500;
  }
  .impact-row__stat { text-align: center; }
  .impact-big-stat {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 8px;
  }
  .impact-big-stat__sub { font-size: 0.82rem; color: var(--color-text-soft); line-height: 1.45; margin-bottom: 6px; }
  .impact-big-stat__src { font-size: 0.72rem; color: var(--color-text-soft); opacity: .65; }
  .impact-divider { border: none; border-top: 1px solid var(--color-border); margin: 0; }

  /* Urgency grid */
  .urgency-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .urgency-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .urgency-card__val { font-size: 2rem; font-weight: 800; color: var(--color-primary); line-height: 1; }
  .urgency-card p { font-size: 0.88rem; color: var(--color-text-soft); line-height: 1.5; margin: 0; flex: 1; }
  .urgency-card span { font-size: 0.72rem; color: var(--color-text-soft); opacity: .65; }

  /* Testimonial */
  .testimonial-quote {
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-text);
    margin: 24px 0;
    quotes: "\00AB" "\00BB";
  }
  .testimonial-quote::before { content: open-quote; }
  .testimonial-quote::after  { content: close-quote; }
  .testimonial-author { display: flex; align-items: center; gap: 14px; justify-content: center; margin-top: 20px; }
  .testimonial-author__avatar {
    width: 40px; height: 40px; border-radius: 8px;
    background: var(--color-cream); color: var(--color-primary);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; flex-shrink: 0;
  }
  .testimonial-author strong { display: block; font-size: 0.95rem; }
  .testimonial-author span { display: block; font-size: 0.8rem; color: var(--color-text-soft); }

  @media (max-width: 860px) {
    .impact-row { grid-template-columns: 1fr; gap: 16px; }
    .urgency-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .urgency-grid { grid-template-columns: 1fr; }
  }
</style>
