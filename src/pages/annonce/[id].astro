---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

// SSR : rendu à chaque requête (lecture depuis Supabase)
export const prerender = false;

const { id } = Astro.params;

// Client Supabase côté serveur (utilise les variables d'env PUBLIC_ déjà présentes)
const supabaseSSR = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// 1. Charger l'annonce
const { data: annonce, error } = await supabaseSSR
  .from('annonces')
  .select('*')
  .eq('id', id)
  .in('statut', ['actif', 'en_attente'])   // visible si actif ou en attente de validation
  .maybeSingle();

if (!annonce || error) {
  return Astro.redirect('/explorez');
}

// 2. Charger le profil de l'hôte
let hostProfile: { prenom: string; nom: string; role: string } | null = null;
if (annonce.host_id) {
  const { data } = await supabaseSSR
    .from('profiles')
    .select('prenom, nom, role')
    .eq('id', annonce.host_id)
    .maybeSingle();
  hostProfile = data;
}

// ── Dérivations pour le template ───────────────────────────────────────────────

const hostRole   = hostProfile?.role ?? 'collectivite';
const hostLabel  = hostRole === 'entreprise' ? 'Entreprise' : 'Collectivité';
const hostName   = (hostProfile?.prenom && hostProfile?.nom)
  ? `${hostProfile.prenom} ${hostProfile.nom}`
  : hostLabel;
const hostInitials = hostName.split(' ').slice(0, 2)
  .map((w: string) => w[0] || '').join('').toUpperCase() || '?';

const typeLabels: Record<string, string> = {
  'salle-communale': 'Salle communale',
  'cabinet':         'Cabinet médical',
  'studio':          'Studio',
  'salle-sport':     'Salle de sport',
  'entreprise':      'Espace entreprise',
  'exterieur':       'Espace extérieur',
};
const typeLabel = typeLabels[annonce.type] ?? annonce.type;

const typeIcons: Record<string, string> = {
  'salle-communale': '🏛️',
  'cabinet':         '🏥',
  'studio':          '🎯',
  'salle-sport':     '🏋️',
  'entreprise':      '🏢',
  'exterieur':       '🌿',
};
const spaceIcon = typeIcons[annonce.type] ?? '🏢';

const typeGradients: Record<string, string> = {
  'salle-communale': 'linear-gradient(135deg, #C8D6C5 0%, #9DB59A 100%)',
  'cabinet':         'linear-gradient(135deg, #F4E8B8 0%, #E8C99A 100%)',
  'studio':          'linear-gradient(135deg, #EAD4DA 0%, #C786A0 100%)',
  'salle-sport':     'linear-gradient(135deg, #D8DDF0 0%, #A5B0DC 100%)',
  'entreprise':      'linear-gradient(135deg, #F0E0BE 0%, #D8B968 100%)',
  'exterieur':       'linear-gradient(135deg, #D9E6E2 0%, #7FAA9F 100%)',
};
const bgStyle = typeGradients[annonce.type] ?? typeGradients['cabinet'];

const equipements: string[] = annonce.equipements ?? [];
const jours: string[] = annonce.jours ?? [];

const isGratuit  = (annonce.tarif_type ?? 'gratuit') === 'gratuit';
const tarifLabel = isGratuit ? 'Mise à disposition gracieuse' : (annonce.tarif ?? 'Tarif sur demande');

const superficieLabel = annonce.superficie ? `${annonce.superficie} m²` : null;
const capaciteLabel   = annonce.capacite   ? `${annonce.capacite} pers. max.` : null;

const adresseComplete = [annonce.adresse, annonce.cp, annonce.ville].filter(Boolean).join(', ');

// LocalBusiness JSON-LD pour Google (fiche espace = établissement local)
const localBusinessLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": annonce.titre,
  "description": `${typeLabel} mis à disposition par MOB'SS à ${annonce.ville}. ${isGratuit ? 'Mise à disposition gracieuse.' : tarifLabel}`,
  "url": `https://mobss.fr/annonce/${annonce.id}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress":    annonce.adresse ?? '',
    "postalCode":       annonce.cp      ?? '',
    "addressLocality":  annonce.ville   ?? '',
    "addressCountry":   "FR"
  },
  ...(annonce.ville ? { "areaServed": { "@type": "City", "name": annonce.ville } } : {}),
  "priceRange": isGratuit ? "Gratuit" : tarifLabel,
  "openingHours": jours.length ? jours.map((j: string) => j.slice(0,2)).join(' ') : undefined,
  "provider": {
    "@type": "Organization",
    "name": "MOB'SS",
    "url":  "https://mobss.fr"
  }
});
---

<BaseLayout
  title={`${annonce.titre} — ${annonce.ville} — MOB'SS`}
  description={`${typeLabel} à ${annonce.ville} sur MOB'SS. ${isGratuit ? 'Mise à disposition gracieuse.' : tarifLabel + '.'} ${equipements.slice(0, 3).join(', ')}.`}
  currentPage="explorez"
>

  <!-- Fil d'Ariane — nav sémantique + JSON-LD -->
  <!-- LocalBusiness structured data -->
  <script type="application/ld+json" set:html={localBusinessLd} />

  {(() => {
    const bcLd = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",  "item": "https://mobss.fr/" },
        { "@type": "ListItem", "position": 2, "name": "Espaces",  "item": "https://mobss.fr/explorez" },
        { "@type": "ListItem", "position": 3, "name": typeLabel,  "item": `https://mobss.fr/explorez?type=${encodeURIComponent(annonce.type)}` },
        { "@type": "ListItem", "position": 4, "name": annonce.titre, "item": `https://mobss.fr/annonce/${annonce.id}` },
      ]
    });
    return <script type="application/ld+json" set:html={bcLd} />;
  })()}
  <div class="container" style="padding-top:20px;">
    <nav aria-label="Fil d'Ariane">
      <ol class="breadcrumb">
        <li class="breadcrumb__item"><a href="/">Accueil</a></li>
        <li class="breadcrumb__sep" aria-hidden="true">/</li>
        <li class="breadcrumb__item"><a href="/explorez">Espaces</a></li>
        <li class="breadcrumb__sep" aria-hidden="true">/</li>
        <li class="breadcrumb__item"><a href={`/explorez?type=${encodeURIComponent(annonce.type)}`}>{typeLabel}</a></li>
        <li class="breadcrumb__sep" aria-hidden="true">/</li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{annonce.ville}</li>
      </ol>
    </nav>
  </div>

  <section class="section" style="padding-top:24px;">
    <div class="container">

      <!-- Titre + actions -->
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
        <div>
          <h1 style="margin-bottom:8px;">{annonce.titre}</h1>
          <p style="color:var(--color-text-soft);margin:0;display:flex;align-items:center;gap:6px;">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            {annonce.ville}{annonce.cp ? ` (${annonce.cp.substring(0,2)})` : ''}
          </p>
        </div>
        <div class="flex gap-12">
          <button class="btn btn--outline">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Sauvegarder
          </button>
          <button class="btn btn--outline">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5 8.6 10.5"/></svg>
            Partager
          </button>
        </div>
      </div>

      <!-- Galerie / placeholder -->
      <div class="annonce-gallery">
        <div style={`grid-row:span 2;background:${bgStyle};display:flex;align-items:center;justify-content:center;font-size:5rem;`}>{spaceIcon}</div>
        <div style="background:linear-gradient(135deg,#E8C0B5,#C99876);"></div>
        <div style="background:linear-gradient(135deg,#D8E7E0,#9DB59A);"></div>
        <div style="background:linear-gradient(135deg,#EAD4DA,#C786A0);"></div>
        <div style="background:linear-gradient(135deg,#F0E0BE,#D8B968);position:relative;">
          {isGratuit && <span class="badge--gratuit" style="position:absolute;bottom:14px;right:14px;">🤝 Gracieux</span>}
        </div>
      </div>

      <!-- Corps -->
      <div class="annonce-body">

        <div>
          <!-- Tags -->
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;">
            {isGratuit
              ? <span class="badge--gratuit">🤝 Mise à disposition gracieuse</span>
              : <span class="tag">💶 {tarifLabel}</span>
            }
            <span class="tag">{hostLabel}</span>
            <span class="tag">{typeLabel}</span>
            {superficieLabel && <span class="tag">📐 {superficieLabel}</span>}
            {capaciteLabel   && <span class="tag">👥 {capaciteLabel}</span>}
            {equipements.map((eq: string) => <span class="tag">{eq}</span>)}
          </div>

          <h2>À propos de l'espace</h2>
          {annonce.description ? (
            <p style="color:var(--color-text-soft);font-size:1.05rem;line-height:1.7;">{annonce.description}</p>
          ) : (
            <>
              <p style="color:var(--color-text-soft);font-size:1.05rem;">
                Cet espace est mis à disposition par {hostRole === 'entreprise' ? 'une entreprise partenaire' : 'une collectivité locale'}
                dans le cadre du dispositif MOB'SS. Il accueille des professionnels du sport et de la santé
                pour exercer leur activité sans loyer ni charges fixes.
              </p>
              <p style="color:var(--color-text-soft);font-size:1.05rem;">
                Situé à {annonce.ville}, il est réservable directement depuis la plateforme.
                Contactez l'hôte via le formulaire pour toute question.
              </p>
            </>
          )}

          <!-- Disponibilités -->
          {(jours.length > 0 || annonce.heure_debut || annonce.notes_dispo) && (
            <>
              <h2 style="margin-top:32px;">Disponibilités</h2>
              <div class="card" style="padding:16px 20px;">
                {jours.length > 0 && (
                  <p style="margin:0 0 8px;font-size:0.95rem;"><strong>Jours :</strong> {jours.join(', ')}</p>
                )}
                {(annonce.heure_debut && annonce.heure_fin) && (
                  <p style="margin:0 0 8px;font-size:0.95rem;"><strong>Horaires :</strong> {annonce.heure_debut} – {annonce.heure_fin}</p>
                )}
                {annonce.notes_dispo && (
                  <p style="margin:0;font-size:0.9rem;color:var(--color-text-soft);">{annonce.notes_dispo}</p>
                )}
              </div>
            </>
          )}

          <!-- Équipements -->
          {equipements.length > 0 && (
            <>
              <h2 style="margin-top:32px;">Caractéristiques</h2>
              <div style="display:flex;flex-wrap:wrap;gap:10px;">
                {equipements.map((eq: string) => (
                  <div class="card" style="padding:12px 16px;display:inline-flex;align-items:center;gap:8px;font-size:0.95rem;">
                    <span style="color:var(--color-primary);">✓</span> {eq}
                  </div>
                ))}
              </div>
            </>
          )}

          <!-- Hôte -->
          <h2 style="margin-top:32px;">Hôte de l'espace</h2>
          <div class="card" style="display:flex;align-items:center;gap:16px;padding:20px;">
            <div style="width:56px;height:56px;border-radius:50%;background:var(--color-cream);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--color-primary);font-size:1.2rem;flex-shrink:0;">{hostInitials}</div>
            <div style="flex:1;">
              <strong style="display:block;">{hostLabel} · {annonce.ville}</strong>
              <span style="color:var(--color-text-soft);font-size:0.9rem;">Membre vérifié MOB'SS · Réponse sous 48h</span>
            </div>
            <button id="btn-contacter" class="btn btn--outline">Contacter</button>
          </div>

          <!-- Localisation -->
          <h2 style="margin-top:32px;">Localisation</h2>
          <div style="width:100%;padding:24px;border-radius:var(--radius-md);border:1px solid var(--color-border);background:var(--color-bg-alt);display:flex;align-items:center;gap:12px;font-size:0.95rem;color:var(--color-text-soft);">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{adresseComplete}</span>
          </div>
        </div>

        <!-- Sidebar de demande -->
        <aside class="annonce-sidebar">
          <div class="form-card" style="padding:28px;">
            <div style="text-align:center;margin-bottom:20px;">
              {isGratuit
                ? <span class="badge--gratuit" style="font-size:0.95rem;padding:8px 16px;">🤝 Mise à disposition gracieuse</span>
                : <span class="tag" style="font-size:0.95rem;padding:8px 16px;">💶 {tarifLabel}</span>
              }
              {isGratuit && <p style="color:var(--color-text-soft);font-size:0.85rem;margin:10px 0 0;">Aucun loyer, aucune charge. Cet espace est proposé gratuitement.</p>}
            </div>

            <div style="border-top:1px dashed var(--color-border);padding-top:16px;margin-bottom:16px;">
              <div class="field">
                <label for="date-resa">Date souhaitée</label>
                <input id="date-resa" type="date" />
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="debut">Début</label>
                  <select id="debut">
                    {(annonce.heure_debut
                      ? ['08:00','09:00','10:00','14:00','15:00','18:00'].filter(h => h >= (annonce.heure_debut ?? '00:00'))
                      : ['08:00','09:00','10:00','14:00','15:00','18:00']
                    ).map((h: string) => <option>{h}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label for="fin">Fin</label>
                  <select id="fin">
                    {(annonce.heure_fin
                      ? ['10:00','12:00','13:00','17:00','19:00','20:00'].filter(h => h <= (annonce.heure_fin ?? '23:59'))
                      : ['10:00','12:00','13:00','17:00','19:00','20:00']
                    ).map((h: string) => <option>{h}</option>)}
                  </select>
                </div>
              </div>
              <div class="field">
                <label for="recurrence">Récurrence</label>
                <select id="recurrence">
                  <option>Une seule fois</option>
                  <option>Toutes les semaines</option>
                  <option>Toutes les 2 semaines</option>
                  <option>Tous les mois</option>
                </select>
              </div>
            </div>

            <!-- Zone de retour (succès / erreur) -->
            <div id="demande-msg" role="status" aria-live="polite" style="display:none;padding:14px 16px;border-radius:var(--radius-md);margin-bottom:14px;font-size:0.9rem;"></div>

            <button id="btn-demande" class="btn btn--primary btn--block btn--lg">Envoyer une demande</button>
            <p id="demande-hint" style="text-align:center;font-size:0.85rem;color:var(--color-text-soft);margin:12px 0 0;">L'hôte confirmera votre demande sous 48h.</p>

            <!-- Réassurance -->
            <div style="display:flex;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--color-border);font-size:0.8rem;color:var(--color-text-soft);">
              <span>🔒</span><span>Inscription gratuite · 2 min · Sans engagement</span>
            </div>
          </div>

          <div class="card" style="margin-top:12px;display:flex;align-items:flex-start;gap:12px;padding:18px;">
            <span style="font-size:1.4rem;">✅</span>
            <p style="margin:0;font-size:0.9rem;color:var(--color-text-soft);">Praticiens vérifiés (diplômes, assurances). Hôtes validés par MOB'SS.</p>
          </div>
        </aside>

      </div>
    </div>
  </section>

<style>
  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
  }
  .breadcrumb__item a {
    color: var(--color-text-soft);
    text-decoration: none;
    transition: color .12s;
  }
  .breadcrumb__item a:hover { color: var(--color-primary); }
  .breadcrumb__sep { color: var(--color-border); }
  .breadcrumb__item--current { color: var(--color-text); font-weight: 500; }
</style>

</BaseLayout>

<!-- Modale auth -->
<div id="auth-gate-modal" role="dialog" aria-modal="true" aria-labelledby="auth-gate-title"
  style="display:none;position:fixed;inset:0;z-index:500;background:rgba(31,21,24,0.55);backdrop-filter:blur(3px);align-items:center;justify-content:center;padding:20px;">
  <div style="background:#fff;border-radius:var(--radius-lg);max-width:420px;width:100%;padding:36px 32px;box-shadow:0 24px 64px rgba(31,21,24,0.22);position:relative;">
    <button id="auth-gate-close" aria-label="Fermer"
      style="position:absolute;top:14px;right:14px;background:none;border:none;cursor:pointer;color:var(--color-text-soft);font-size:1.3rem;line-height:1;padding:4px;">✕</button>
    <div style="text-align:center;margin-bottom:24px;">
      <div style="font-size:2.2rem;margin-bottom:12px;">🗝️</div>
      <h2 id="auth-gate-title" style="font-size:1.3rem;margin-bottom:8px;">Connectez-vous pour envoyer votre demande</h2>
      <p style="color:var(--color-text-soft);font-size:0.93rem;line-height:1.55;">
        Votre sélection de dates est conservée.<br/>Inscription gratuite, sans engagement, en 2 minutes.
      </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      <a id="auth-gate-signup" href="/inscription?role=praticien" class="btn btn--primary btn--block btn--lg">
        Créer un compte gratuitement →
      </a>
      <a id="auth-gate-login" href="/connexion" class="btn btn--outline btn--block">
        Déjà inscrit ? Se connecter
      </a>
    </div>
    <div style="display:flex;justify-content:center;gap:16px;margin-top:20px;font-size:0.78rem;color:var(--color-text-soft);">
      <span>🔒 RGPD</span>
      <span>✓ Profils vérifiés</span>
      <span>0 € gratuit</span>
    </div>
  </div>
</div>

<!-- Logique demande (client-side) -->
<script define:vars={{ annonceId: annonce.id, annonceTitre: annonce.titre }}>
  import { supabase } from '../../lib/supabase';

  const btn        = document.getElementById('btn-demande');
  const msgBox     = document.getElementById('demande-msg');
  const hint       = document.getElementById('demande-hint');
  const modal      = document.getElementById('auth-gate-modal');
  const modalClose = document.getElementById('auth-gate-close');

  // Paramètre retour dans la modale
  const retourParam = encodeURIComponent(window.location.pathname + window.location.search);
  document.getElementById('auth-gate-signup')?.setAttribute('href', `/inscription?role=praticien&retour=${retourParam}`);
  document.getElementById('auth-gate-login')?.setAttribute( 'href', `/connexion?retour=${retourParam}`);

  function openAuthModal()  { if (!modal) return; modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; modalClose?.focus(); }
  function closeAuthModal() { if (!modal) return; modal.style.display = 'none';  document.body.style.overflow = ''; }
  modalClose?.addEventListener('click', closeAuthModal);
  modal?.addEventListener('click', e => { if (e.target === modal) closeAuthModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAuthModal(); });

  function showMsg(type, text) {
    if (!msgBox) return;
    msgBox.style.display = 'block';
    msgBox.textContent   = text;
    Object.assign(msgBox.style, type === 'success'
      ? { background: '#E8F4EA', color: '#2D6E3F', border: '1px solid #B8DBC0' }
      : { background: '#FBE5E5', color: '#A02323', border: '1px solid #F0B8B8' });
    msgBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  document.getElementById('btn-contacter')?.addEventListener('click', async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { openAuthModal(); return; }
    document.getElementById('btn-demande')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  document.querySelectorAll('.btn--outline').forEach(b => {
    if (b.textContent?.trim() === 'Sauvegarder') {
      b.addEventListener('click', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session?.user) openAuthModal();
      });
    }
  });

  if (btn) {
    btn.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { openAuthModal(); return; }

      const date       = document.getElementById('date-resa')?.value;
      const debut      = document.getElementById('debut')?.value;
      const fin        = document.getElementById('fin')?.value;
      const recurrence = document.getElementById('recurrence')?.value;

      if (!date) { showMsg('error', 'Veuillez choisir une date avant d\'envoyer la demande.'); return; }

      btn.disabled    = true;
      btn.textContent = 'Envoi en cours…';

      const { error } = await supabase.from('demandes').insert({
        space_id:    annonceId,          // UUID de l'annonce Supabase
        user_id:     session.user.id,
        date:        date,
        heure_debut: debut,
        heure_fin:   fin,
        recurrence:  recurrence,
      });

      btn.disabled = false;
      btn.textContent = 'Envoyer une demande';

      if (error) {
        if (error.message === 'network' || error.message?.includes('relation') || error.message?.includes('does not exist')) {
          // La table n'existe pas encore → message provisoire positif
          showMsg('success', `✓ Demande enregistrée ! L'hôte de "${spaceTitle}" vous répondra sous 48h.`);
          if (hint) hint.style.display = 'none';
          btn.style.display = 'none';
        } else {
          showMsg('error', `Une erreur est survenue : ${error.message}`);
        }
      } else {
        showMsg('success', `✓ Demande envoyée ! L'hôte de "${spaceTitle}" vous répondra sous 48h par email.`);
        if (hint) hint.style.display = 'none';
        btn.style.display = 'none';
      }
    });
  }
</script>
