---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

// SSR : rendu à chaque requête (lecture depuis Supabase)
export const prerender = false;

const { id } = Astro.params;

// Client Supabase côté serveur (utilise les variables d'env PUBLIC_ déjà présentes)
const supabaseSSR = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// 1. Charger l'annonce
const { data: annonce, error } = await supabaseSSR
  .from('annonces')
  .select('*')
  .eq('id', id)
  .in('statut', ['actif', 'en_attente'])   // visible si actif ou en attente de validation
  .maybeSingle();

if (!annonce || error) {
  return Astro.redirect('/explorez');
}

// 2. Charger le profil de l'hôte
let hostProfile: { prenom: string; nom: string; role: string } | null = null;
if (annonce.host_id) {
  const { data } = await supabaseSSR
    .from('profiles')
    .select('prenom, nom, role')
    .eq('id', annonce.host_id)
    .maybeSingle();
  hostProfile = data;
}

// ── Dérivations pour le template ───────────────────────────────────────────────

const hostRole   = hostProfile?.role ?? 'collectivite';
const hostLabel  = hostRole === 'entreprise' ? 'Entreprise' : 'Collectivité';
const hostName   = (hostProfile?.prenom && hostProfile?.nom)
  ? `${hostProfile.prenom} ${hostProfile.nom}`
  : hostLabel;
const hostInitials = hostName.split(' ').slice(0, 2)
  .map((w: string) => w[0] || '').join('').toUpperCase() || '?';

const typeLabels: Record<string, string> = {
  'salle-communale': 'Salle communale',
  'cabinet':         'Cabinet médical',
  'studio':          'Studio',
  'salle-sport':     'Salle de sport',
  'entreprise':      'Espace entreprise',
  'exterieur':       'Espace extérieur',
};
const typeLabel = typeLabels[annonce.type] ?? annonce.type;

const typeIcons: Record<string, string> = {
  'salle-communale': '🏛️',
  'cabinet':         '🏥',
  'studio':          '🎯',
  'salle-sport':     '🏋️',
  'entreprise':      '🏢',
  'exterieur':       '🌿',
};
const spaceIcon = typeIcons[annonce.type] ?? '🏢';

const typeGradients: Record<string, string> = {
  'salle-communale': 'linear-gradient(135deg, #C8D6C5 0%, #9DB59A 100%)',
  'cabinet':         'linear-gradient(135deg, #F4E8B8 0%, #E8C99A 100%)',
  'studio':          'linear-gradient(135deg, #EAD4DA 0%, #C786A0 100%)',
  'salle-sport':     'linear-gradient(135deg, #D8DDF0 0%, #A5B0DC 100%)',
  'entreprise':      'linear-gradient(135deg, #F0E0BE 0%, #D8B968 100%)',
  'exterieur':       'linear-gradient(135deg, #D9E6E2 0%, #7FAA9F 100%)',
};
const bgStyle = typeGradients[annonce.type] ?? typeGradients['cabinet'];

const equipements: string[] = annonce.equipements ?? [];
const jours: string[] = annonce.jours ?? [];

const isGratuit  = (annonce.tarif_type ?? 'gratuit') === 'gratuit';
const tarifLabel = isGratuit ? 'Mise à disposition gracieuse' : (annonce.tarif ?? 'Tarif sur demande');

const superficieLabel = annonce.superficie ? `${annonce.superficie} m²` : null;
const capaciteLabel   = annonce.capacite   ? `${annonce.capacite} pers. max.` : null;

const adresseComplete = [annonce.adresse, annonce.cp, annonce.ville].filter(Boolean).join(', ');
const photos: string[] = annonce.photos ?? [];
const mainPhoto = photos[0] ?? null;
---

<BaseLayout
  title={`${annonce.titre} — ${annonce.ville} — MOB'SS`}
  description={`${typeLabel} à ${annonce.ville} sur MOB'SS. ${isGratuit ? 'Mise à disposition gracieuse.' : tarifLabel + '.'} ${equipements.slice(0, 3).join(', ')}.`}
  currentPage="explorez"
>

  <!-- Fil d'Ariane -->
  <div class="container" style="padding-top:20px;padding-bottom:8px;">
    <p style="color:var(--color-text-soft);font-size:0.88rem;margin:0;">
      <a href="/explorez" style="color:var(--color-text-soft);text-decoration:none;">Explorez</a>
      <span style="margin:0 6px;">›</span>
      <a href={`/explorez?type=${encodeURIComponent(annonce.type)}`} style="color:var(--color-text-soft);text-decoration:none;">{typeLabel}</a>
      <span style="margin:0 6px;">›</span>
      <span>{annonce.ville}</span>
    </p>
  </div>

  <!-- ── Galerie plein-largeur ──────────────────────────────────────────── -->
  <div class="annonce-hero-gallery">
    <!-- Photo principale -->
    <div class="annonce-hero-main" style={mainPhoto ? `background:url('${mainPhoto}') center/cover no-repeat;` : `background:${bgStyle};`}>
      {!mainPhoto && <span style="font-size:6rem;opacity:0.7;">{spaceIcon}</span>}
      {isGratuit && (
        <span class="badge--gratuit" style="position:absolute;bottom:18px;left:18px;font-size:0.9rem;padding:6px 14px;z-index:2;">
          🤝 Mise à disposition gracieuse
        </span>
      )}
      {photos.length > 1 && (
        <button id="gallery-all-btn" style="position:absolute;bottom:18px;right:18px;z-index:2;background:rgba(255,255,255,0.92);border:none;border-radius:var(--radius-sm);padding:8px 14px;font-size:0.85rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Voir les {photos.length} photos
        </button>
      )}
    </div>
    <!-- Vignettes secondaires -->
    <div class="annonce-hero-grid">
      {[1,2,3,4].map((i) => (
        <div style={photos[i]
          ? `background:url('${photos[i]}') center/cover no-repeat;`
          : `background:${['linear-gradient(135deg,#E8C0B5,#C99876)','linear-gradient(135deg,#D8E7E0,#9DB59A)','linear-gradient(135deg,#EAD4DA,#C786A0)','linear-gradient(135deg,#F0E0BE,#D8B968)'][i-1]};`}
        />
      ))}
    </div>
  </div>

  <!-- ── Corps de la page ───────────────────────────────────────────────── -->
  <section style="padding:32px 0 80px;">
    <div class="container">

      <div class="annonce-body">

        <!-- ── Colonne principale ────────────────────────────────────── -->
        <div>

          <!-- En-tête : titre + actions -->
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;margin-bottom:20px;">
            <div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                <span class="tag" style="font-size:0.8rem;">{spaceIcon} {typeLabel}</span>
                <span class="tag" style="font-size:0.8rem;">{hostLabel}</span>
                {superficieLabel && <span class="tag" style="font-size:0.8rem;">📐 {superficieLabel}</span>}
                {capaciteLabel   && <span class="tag" style="font-size:0.8rem;">👥 {capaciteLabel}</span>}
              </div>
              <h1 style="margin:0 0 8px;font-size:1.75rem;">{annonce.titre}</h1>
              <p style="color:var(--color-text-soft);margin:0;display:flex;align-items:center;gap:5px;font-size:0.95rem;">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                {annonce.ville}{annonce.cp ? ` (${annonce.cp.substring(0,2)})` : ''}
              </p>
            </div>
            <div style="display:flex;gap:10px;flex-shrink:0;">
              <button class="btn btn--outline" style="padding:8px 14px;font-size:0.88rem;">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                Sauvegarder
              </button>
              <button class="btn btn--outline" style="padding:8px 14px;font-size:0.88rem;">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5 8.6 10.5"/></svg>
                Partager
              </button>
            </div>
          </div>

          <hr style="border:none;border-top:1px solid var(--color-border);margin:0 0 28px;" />

          <!-- Hôte résumé -->
          <div style="display:flex;align-items:center;gap:14px;padding-bottom:28px;border-bottom:1px solid var(--color-border);margin-bottom:28px;">
            <div style="width:52px;height:52px;border-radius:50%;background:var(--color-cream);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--color-primary);font-size:1.1rem;flex-shrink:0;">{hostInitials}</div>
            <div>
              <strong style="display:block;font-size:1rem;">{hostLabel} — {annonce.ville}</strong>
              <span style="color:var(--color-text-soft);font-size:0.88rem;">Membre vérifié MOB'SS · Réponse sous 48h</span>
            </div>
            <button id="btn-contacter" class="btn btn--outline" style="margin-left:auto;padding:8px 16px;font-size:0.88rem;">Contacter</button>
          </div>

          <!-- Description -->
          <h2 style="font-size:1.2rem;margin-bottom:14px;">À propos de l'espace</h2>
          {annonce.description ? (
            <p style="color:var(--color-text-soft);font-size:1rem;line-height:1.75;margin-bottom:0;">{annonce.description}</p>
          ) : (
            <p style="color:var(--color-text-soft);font-size:1rem;line-height:1.75;margin-bottom:0;">
              Cet espace est mis à disposition par {hostRole === 'entreprise' ? 'une entreprise partenaire' : 'une collectivité locale'} dans le cadre du dispositif MOB'SS.
              Il accueille des professionnels du sport et de la santé pour exercer leur activité sans loyer ni charges fixes.
              Situé à {annonce.ville}, il est réservable directement depuis la plateforme.
            </p>
          )}

          <!-- Disponibilités -->
          {(jours.length > 0 || annonce.heure_debut || annonce.notes_dispo) && (
            <>
              <h2 style="font-size:1.2rem;margin:32px 0 14px;">Disponibilités</h2>
              <div class="card" style="padding:18px 22px;display:flex;flex-wrap:wrap;gap:20px;">
                {jours.length > 0 && (
                  <div>
                    <p style="margin:0 0 4px;font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-soft);">Jours</p>
                    <p style="margin:0;font-size:0.95rem;font-weight:600;">{jours.join(', ')}</p>
                  </div>
                )}
                {(annonce.heure_debut && annonce.heure_fin) && (
                  <div>
                    <p style="margin:0 0 4px;font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-soft);">Horaires</p>
                    <p style="margin:0;font-size:0.95rem;font-weight:600;">{annonce.heure_debut} – {annonce.heure_fin}</p>
                  </div>
                )}
                {annonce.notes_dispo && (
                  <p style="margin:0;font-size:0.88rem;color:var(--color-text-soft);flex-basis:100%;">{annonce.notes_dispo}</p>
                )}
              </div>
            </>
          )}

          <!-- Équipements -->
          {equipements.length > 0 && (
            <>
              <h2 style="font-size:1.2rem;margin:32px 0 14px;">Équipements & caractéristiques</h2>
              <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">
                {equipements.map((eq: string) => (
                  <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:var(--radius-sm);border:1px solid var(--color-border);font-size:0.92rem;">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    {eq}
                  </div>
                ))}
              </div>
            </>
          )}

          <!-- Localisation -->
          <h2 style="font-size:1.2rem;margin:32px 0 14px;">Localisation</h2>
          <div style="padding:20px 22px;border-radius:var(--radius-md);border:1px solid var(--color-border);background:var(--color-bg-alt);display:flex;align-items:center;gap:12px;font-size:0.95rem;">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2">
              <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{adresseComplete || `${annonce.ville}${annonce.cp ? ` (${annonce.cp})` : ''}`}</span>
          </div>

        </div>

        <!-- ── Sidebar sticky ─────────────────────────────────────── -->
        <aside class="annonce-sidebar">
          <div class="form-card" style="padding:28px;">

            <!-- Prix / gratuité -->
            <div style="margin-bottom:20px;">
              {isGratuit ? (
                <>
                  <p style="font-size:1.5rem;font-weight:700;margin:0 0 4px;">Gratuit</p>
                  <p style="font-size:0.88rem;color:var(--color-text-soft);margin:0;">Mise à disposition gracieuse · sans engagement</p>
                </>
              ) : (
                <>
                  <p style="font-size:1.5rem;font-weight:700;margin:0 0 4px;">{tarifLabel}</p>
                  <p style="font-size:0.88rem;color:var(--color-text-soft);margin:0;">Tarif communiqué par l'hôte</p>
                </>
              )}
            </div>

            <div style="border-top:1px solid var(--color-border);padding-top:18px;margin-bottom:18px;">
              <div class="field">
                <label for="date-resa">Date souhaitée</label>
                <input id="date-resa" type="date" />
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="debut">Début</label>
                  <select id="debut">
                    {(annonce.heure_debut
                      ? ['08:00','09:00','10:00','14:00','15:00','18:00'].filter(h => h >= (annonce.heure_debut ?? '00:00'))
                      : ['08:00','09:00','10:00','14:00','15:00','18:00']
                    ).map((h: string) => <option>{h}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label for="fin">Fin</label>
                  <select id="fin">
                    {(annonce.heure_fin
                      ? ['10:00','12:00','13:00','17:00','19:00','20:00'].filter(h => h <= (annonce.heure_fin ?? '23:59'))
                      : ['10:00','12:00','13:00','17:00','19:00','20:00']
                    ).map((h: string) => <option>{h}</option>)}
                  </select>
                </div>
              </div>
              <div class="field">
                <label for="recurrence">Récurrence</label>
                <select id="recurrence">
                  <option>Une seule fois</option>
                  <option>Toutes les semaines</option>
                  <option>Toutes les 2 semaines</option>
                  <option>Tous les mois</option>
                </select>
              </div>
            </div>

            <!-- Retour (succès / erreur) -->
            <div id="demande-msg" role="status" aria-live="polite" style="display:none;padding:14px 16px;border-radius:var(--radius-md);margin-bottom:14px;font-size:0.9rem;"></div>

            <button id="btn-demande" class="btn btn--primary btn--block btn--lg">Envoyer une demande</button>
            <p id="demande-hint" style="text-align:center;font-size:0.82rem;color:var(--color-text-soft);margin:10px 0 0;">L'hôte confirmera votre demande sous 48h.</p>

            <!-- Réassurance -->
            <div style="display:flex;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--color-border);font-size:0.78rem;color:var(--color-text-soft);">
              <span>🔒</span><span>Inscription gratuite · 2 min · Sans engagement</span>
            </div>
          </div>

          <!-- Trust signals -->
          <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:1px solid var(--color-border);border-radius:var(--radius-sm);font-size:0.88rem;color:var(--color-text-soft);">
              <span style="color:#2D6E3F;font-size:1rem;">✓</span>
              <span>Diplômes et assurances vérifiés</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:1px solid var(--color-border);border-radius:var(--radius-sm);font-size:0.88rem;color:var(--color-text-soft);">
              <span style="color:#2B5BD7;font-size:1rem;">✓</span>
              <span>Hôte validé par l'équipe MOB'SS</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:1px solid var(--color-border);border-radius:var(--radius-sm);font-size:0.88rem;color:var(--color-text-soft);">
              <span style="color:var(--color-primary);font-size:1rem;">✓</span>
              <span>Aucune commission sur la mise en relation</span>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

</BaseLayout>

<!-- Modale auth -->
<div id="auth-gate-modal" role="dialog" aria-modal="true" aria-labelledby="auth-gate-title"
  style="display:none;position:fixed;inset:0;z-index:500;background:rgba(31,21,24,0.55);backdrop-filter:blur(3px);align-items:center;justify-content:center;padding:20px;">
  <div style="background:#fff;border-radius:var(--radius-lg);max-width:420px;width:100%;padding:36px 32px;box-shadow:0 24px 64px rgba(31,21,24,0.22);position:relative;">
    <button id="auth-gate-close" aria-label="Fermer"
      style="position:absolute;top:14px;right:14px;background:none;border:none;cursor:pointer;color:var(--color-text-soft);font-size:1.3rem;line-height:1;padding:4px;">✕</button>
    <div style="text-align:center;margin-bottom:24px;">
      <div style="font-size:2.2rem;margin-bottom:12px;">🗝️</div>
      <h2 id="auth-gate-title" style="font-size:1.3rem;margin-bottom:8px;">Connectez-vous pour envoyer votre demande</h2>
      <p style="color:var(--color-text-soft);font-size:0.93rem;line-height:1.55;">
        Votre sélection de dates est conservée.<br/>Inscription gratuite, sans engagement, en 2 minutes.
      </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      <a id="auth-gate-signup" href="/inscription?role=praticien" class="btn btn--primary btn--block btn--lg">
        Créer un compte gratuitement →
      </a>