---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://mobss.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Notre histoire", "item": "https://mobss.fr/notre-histoire" }
  ]
});

const orgLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "MOB'SS",
  "description": "MOB'SS connecte les praticiens libéraux sans local avec les espaces inutilisés des mairies, communes et entreprises — gratuitement, pour lutter contre les déserts médicaux.",
  "url": "https://mobss.fr",
  "foundingDate": "2025",
  "areaServed": "FR",
  "slogan": "La santé n'attend pas. Les espaces non plus."
});
---

<BaseLayout
  title="Notre histoire — Pourquoi MOB'SS existe | MOB'SS"
  description="MOB'SS est né d'un constat simple : des milliers de salles vides d'un côté, des praticiens sans espace de l'autre. Voici l'histoire et les valeurs derrière le projet."
  currentPage="histoire"
>
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <script type="application/ld+json" set:html={orgLd} />

  <!-- HERO ────────────────────────────────────────────────────────────────── -->
  <section class="nh-hero">
    <div class="container nh-hero__inner">
      <nav aria-label="Fil d'Ariane">
        <ol class="breadcrumb" style="font-size:0.82rem;list-style:none;display:flex;gap:6px;flex-wrap:wrap;padding:0;margin:0 0 24px;">
          <li><a href="/" style="color:var(--color-text-soft);text-decoration:none;">Accueil</a></li>
          <li style="color:var(--color-border);">/</li>
          <li style="color:var(--color-text);">Notre histoire</li>
        </ol>
      </nav>
      <span class="section__eyebrow">Qui sommes-nous</span>
      <h1>L&apos;histoire de MOB&apos;SS</h1>
      <p class="nh-hero__lead">
        Tout a commencé par un constat trop simple pour être ignoré.
        Et trop grave pour rester sans réponse.
      </p>
    </div>
  </section>

  <!-- LE DÉCLIC ────────────────────────────────────────────────────────────── -->
  <section class="section section--white nh-section">
    <div class="container nh-container">
      <div class="nh-pull-quote">
        <span class="nh-pull-quote__mark" aria-hidden="true">"</span>
        <blockquote>
          44&nbsp;% des Français estiment vivre dans un désert médical.
          Dans le même temps, 65&nbsp;% des espaces de bureaux et salles communales
          sont vides la majeure partie du temps.
          Ces deux chiffres ne devraient jamais coexister.
        </blockquote>
      </div>

      <div class="nh-prose">
        <h2>Le constat qui a tout déclenché</h2>
        <p>
          En 2024, une personne cherche un kinésithérapeute dans une commune rurale de Normandie.
          La liste d&apos;attente : six semaines minimum. Pendant ce temps, à 800 mètres de là,
          la salle polyvalente de la mairie est vide quatre jours sur cinq.
        </p>
        <p>
          Ce n&apos;est pas un cas isolé. C&apos;est la réalité de milliers de territoires français.
          Des ressources existent — locaux, gymnases, salles de réunion — mais elles ne sont jamais
          connectées à ceux qui en auraient besoin pour exercer et soigner.
        </p>
        <p>
          <strong>MOB&apos;SS est né de ce paradoxe.</strong> L&apos;idée est simple : créer
          l&apos;intermédiaire qui n&apos;existait pas. Pas une application de plus.
          Pas un outil de gestion. Un pont entre deux mondes qui se tournaient le dos.
        </p>
      </div>
    </div>
  </section>

  <!-- LA MISSION ──────────────────────────────────────────────────────────── -->
  <section class="section section--cream nh-section">
    <div class="container nh-container">
      <h2 class="nh-section-title">Notre mission</h2>
      <div class="nh-mission-grid">

        <div class="nh-mission-card nh-mission-card--main">
          <div class="nh-mission-card__eyebrow">Ce qu&apos;on fait</div>
          <p class="nh-mission-card__text">
            Connecter les professionnels de santé et du sport qui cherchent un espace pour exercer
            avec les mairies, communes et entreprises qui ont des locaux disponibles —
            <strong>gratuitement, sans paperasse, sans délai</strong>.
          </p>
        </div>

        <div class="nh-mission-card">
          <div class="nh-mission-card__eyebrow">Ce qu&apos;on ne fait pas</div>
          <p class="nh-mission-card__text">
            On n&apos;est pas une agence immobilière. On ne gère pas les locations.
            On ne prend pas de commission. On est uniquement le lien — la mise en relation
            qui permet à un kiné d&apos;exercer là où les patients ont besoin de lui.
          </p>
        </div>

        <div class="nh-mission-card">
          <div class="nh-mission-card__eyebrow">Ce qu&apos;on vise</div>
          <p class="nh-mission-card__text">
            Un praticien libéral qui cherche un espace devrait trouver en moins de 48h.
            Une mairie qui a une salle vide devrait pouvoir la valoriser en moins de 5 minutes.
            MOB&apos;SS ne s&apos;arrêtera pas avant que ça soit la norme.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- NOS VALEURS ─────────────────────────────────────────────────────────── -->
  <section class="section section--white nh-section">
    <div class="container nh-container">
      <h2 class="nh-section-title">Ce qui nous guide</h2>
      <div class="nh-values">

        <div class="nh-value">
          <div class="nh-value__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none">
              <circle cx="22" cy="22" r="21" fill="#f7e5a2"/>
              <path d="M14 22l6 6 10-12" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Transparence totale</h3>
          <p>
            Pourquoi c&apos;est gratuit, comment on gagne de l&apos;argent à terme,
            ce qu&apos;on fait de vos données — tout est expliqué. Sans jargon.
            <a href="/pourquoi-gratuit">Voir notre modèle →</a>
          </p>
        </div>

        <div class="nh-value">
          <div class="nh-value__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none">
              <circle cx="22" cy="22" r="21" fill="#f7e5a2"/>
              <path d="M22 10v6M22 28v6M10 22h6M28 22h6" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="22" cy="22" r="4" fill="#C8424F"/>
            </svg>
          </div>
          <h3>Impact mesurable</h3>
          <p>
            Chaque mise en relation est une consultation rendue possible.
            On suit ça — nombre d&apos;espaces, de praticiens, de communes couvertes.
            <a href="/notre-impact">Voir notre impact →</a>
          </p>
        </div>

        <div class="nh-value">
          <div class="nh-value__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none">
              <circle cx="22" cy="22" r="21" fill="#f7e5a2"/>
              <path d="M15 30c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="22" cy="16" r="4" fill="#C8424F"/>
            </svg>
          </div>
          <h3>Les humains d&apos;abord</h3>
          <p>
            MOB&apos;SS n&apos;est pas une plateforme froide. On répond aux messages.
            On écoute les retours. On adapte. Chaque praticien et chaque hôte
            est une personne, pas un compte.
          </p>
        </div>

        <div class="nh-value">
          <div class="nh-value__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="44" height="44" fill="none">
              <circle cx="22" cy="22" r="21" fill="#f7e5a2"/>
              <rect x="10" y="18" width="24" height="14" rx="3" fill="none" stroke="#C8424F" stroke-width="2.5"/>
              <path d="M16 18v-3a6 6 0 0112 0v3" stroke="#C8424F" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="22" cy="25" r="2" fill="#C8424F"/>
            </svg>
          </div>
          <h3>Confiance avant tout</h3>
          <p>
            Espaces vérifiés. Praticiens identifiés. Conventions claires.
            On ne mise pas sur la vitesse au détriment de la sécurité
            — ni pour les hôtes, ni pour les praticiens.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- OÙ ON EN EST ─────────────────────────────────────────────────────────── -->
  <section class="section section--cream nh-section">
    <div class="container nh-container">
      <h2 class="nh-section-title">Où on en est aujourd&apos;hui</h2>

      <div class="nh-timeline">

        <div class="nh-tl-item nh-tl-item--done">
          <div class="nh-tl-dot"></div>
          <div class="nh-tl-content">
            <span class="nh-tl-date">2024</span>
            <h3>L&apos;idée</h3>
            <p>Constat du paradoxe. Premières interviews de praticiens libéraux
            en Normandie. Validation du besoin.</p>
          </div>
        </div>

        <div class="nh-tl-item nh-tl-item--done">
          <div class="nh-tl-dot"></div>
          <div class="nh-tl-content">
            <span class="nh-tl-date">Début 2025</span>
            <h3>La plateforme</h3>
            <p>Construction de la plateforme. Premiers partenariats avec des
            communes normandes. Tests avec les premiers praticiens.</p>
          </div>
        </div>

        <div class="nh-tl-item nh-tl-item--current">
          <div class="nh-tl-dot"></div>
          <div class="nh-tl-content">
            <span class="nh-tl-date">2026 — maintenant</span>
            <h3>Beta ouverte</h3>
            <p>MOB&apos;SS est en accès bêta. Nous ouvrons progressivement
            à de nouveaux praticiens et de nouvelles communes partout en France.</p>
          </div>
        </div>

        <div class="nh-tl-item nh-tl-item--next">
          <div class="nh-tl-dot"></div>
          <div class="nh-tl-content">
            <span class="nh-tl-date">Prochain</span>
            <h3>Déploiement national</h3>
            <p>Extension à toutes les régions de France. Fonctionnalités de
            tableau de bord avancées pour les communes et les praticiens.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- L'ÉQUIPE ─────────────────────────────────────────────────────────────── -->
  <section class="section section--white nh-section">
    <div class="container nh-container">
      <h2 class="nh-section-title">L&apos;équipe</h2>
      <p class="nh-team-lead">
        MOB&apos;SS est construit par une petite équipe — quelques personnes convaincues
        qu&apos;un problème de société concret mérite une solution concrète.
        Pas de levée de fonds en cascade, pas de roadmap sur 5 ans gravée dans le marbre.
        Juste l&apos;envie de faire fonctionner quelque chose d&apos;utile.
      </p>

      <div class="nh-team-grid">
        <div class="nh-team-card">
          <div class="nh-team-card__avatar" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
              <circle cx="32" cy="32" r="32" fill="#f7e5a2"/>
              <circle cx="32" cy="24" r="10" fill="#C8424F"/>
              <path d="M12 56c0-11.046 8.954-20 20-20s20 8.954 20 20" fill="#9C2E3A" opacity="0.6"/>
            </svg>
          </div>
          <div class="nh-team-card__info">
            <strong>Flora B.</strong>
            <span>Fondatrice &amp; Product</span>
            <p>À l&apos;origine du projet. Convaincue que la technologie peut
            servir à quelque chose de concret pour les territoires.</p>
          </div>
        </div>

        <div class="nh-team-card nh-team-card--open">
          <div class="nh-team-card__avatar nh-team-card__avatar--open" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
              <circle cx="32" cy="32" r="32" fill="var(--color-border)"/>
              <path d="M32 22v20M22 32h20" stroke="var(--color-text-soft)" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="nh-team-card__info">
            <strong>Vous ?</strong>
            <span>On cherche des gens qui y croient</span>
            <p>Développeur, conseiller en santé territoriale, commercial
            auprès des communes — <a href="/contact">écrivez-nous</a>.</p>
          </div>
        </div>
      </div>

      <div class="nh-contact-strip">
        <p>Une question sur l&apos;histoire du projet, une idée, une critique ?</p>
        <a href="mailto:contact@mobss.fr" class="btn btn--outline">
          Écrire à l&apos;équipe →
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Vous partagez cette conviction ?"
    subtitle="Rejoignez les premiers utilisateurs qui construisent MOB'SS avec nous."
    primaryLabel="Je m'inscris →"
    primaryHref="/inscription"
    secondaryLabel="Voir notre modèle"
    secondaryHref="/pourquoi-gratuit"
  />

</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .nh-hero {
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
    padding: 64px 0 52px;
  }
  .nh-hero__inner { max-width: 700px; }
  .nh-hero h1 { margin-top: 12px; }
  .nh-hero__lead {
    font-size: 1.1rem;
    color: var(--color-text-soft);
    line-height: 1.7;
    margin-top: 16px;
    font-style: italic;
  }

  /* ── Layout commun ───────────────────────────────────────────────────────── */
  .nh-section { padding: 72px 0; }
  .nh-container { max-width: 800px; }
  .nh-section-title {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    margin-bottom: 36px;
  }

  /* ── Pull quote ──────────────────────────────────────────────────────────── */
  .nh-pull-quote {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 48px;
    padding: 28px 32px;
    background: rgba(200,66,79,0.04);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }
  .nh-pull-quote__mark {
    font-size: 5rem;
    line-height: 0.7;
    color: var(--color-primary);
    font-family: var(--font-display);
    opacity: 0.35;
    flex-shrink: 0;
    user-select: none;
  }
  .nh-pull-quote blockquote {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-text);
    font-style: italic;
    margin: 0;
  }

  /* ── Prose ───────────────────────────────────────────────────────────────── */
  .nh-prose h2 { font-size: clamp(1.2rem, 2.5vw, 1.5rem); margin-bottom: 16px; }
  .nh-prose p { line-height: 1.8; margin-bottom: 18px; color: var(--color-text); }

  /* ── Mission grid ────────────────────────────────────────────────────────── */
  .nh-mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .nh-mission-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 22px;
  }
  .nh-mission-card--main {
    grid-column: 1 / -1;
    border-color: var(--color-primary);
    background: rgba(200,66,79,0.03);
  }
  .nh-mission-card__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 10px;
  }
  .nh-mission-card__text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    margin: 0;
  }
  .nh-mission-card--main .nh-mission-card__text {
    font-size: 1rem;
    color: var(--color-text);
  }

  /* ── Valeurs ─────────────────────────────────────────────────────────────── */
  .nh-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .nh-value { display: flex; flex-direction: column; gap: 10px; }
  .nh-value__icon { flex-shrink: 0; }
  .nh-value h3 { font-size: 1.02rem; margin: 0; }
  .nh-value p { font-size: 0.9rem; color: var(--color-text-soft); line-height: 1.65; margin: 0; }
  .nh-value a { color: var(--color-primary); font-size: 0.85rem; }

  /* ── Timeline ────────────────────────────────────────────────────────────── */
  .nh-timeline {
    position: relative;
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .nh-timeline::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: var(--color-border);
  }
  .nh-tl-item {
    position: relative;
    padding: 0 0 36px 24px;
  }
  .nh-tl-item:last-child { padding-bottom: 0; }
  .nh-tl-dot {
    position: absolute;
    left: -22px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2.5px solid var(--color-border);
    background: var(--color-bg);
    z-index: 1;
  }
  .nh-tl-item--done .nh-tl-dot { border-color: var(--color-primary); background: var(--color-primary); }
  .nh-tl-item--current .nh-tl-dot { border-color: var(--color-primary); background: #fff; box-shadow: 0 0 0 3px rgba(200,66,79,0.18); }
  .nh-tl-item--next .nh-tl-dot { border-color: var(--color-border); background: var(--color-bg-soft); }
  .nh-tl-date { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); }
  .nh-tl-item--next .nh-tl-date { color: var(--color-text-soft); }
  .nh-tl-content h3 { font-size: 1rem; margin: 4px 0 6px; }
  .nh-tl-content p { font-size: 0.88rem; color: var(--color-text-soft); line-height: 1.6; margin: 0; }

  /* ── Équipe ──────────────────────────────────────────────────────────────── */
  .nh-team-lead {
    font-size: 0.97rem;
    color: var(--color-text-soft);
    line-height: 1.75;
    max-width: 640px;
    margin-bottom: 36px;
  }
  .nh-team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 36px; }
  .nh-team-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--color-bg-soft);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    align-items: flex-start;
  }
  .nh-team-card--open { border-style: dashed; background: #fff; }
  .nh-team-card__avatar { flex-shrink: 0; border-radius: 50%; overflow: hidden; }
  .nh-team-card__info { display: flex; flex-direction: column; gap: 2px; }
  .nh-team-card__info strong { font-size: 0.97rem; color: var(--color-text); }
  .nh-team-card__info span { font-size: 0.78rem; color: var(--color-primary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; }
  .nh-team-card__info p { font-size: 0.85rem; color: var(--color-text-soft); line-height: 1.55; margin: 6px 0 0; }
  .nh-team-card__info a { color: var(--color-primary); }
  .nh-contact-strip {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 24px;
    background: rgba(200,66,79,0.05);
    border-radius: var(--radius-lg);
    flex-wrap: wrap;
  }
  .nh-contact-strip p { margin: 0; font-size: 0.92rem; color: var(--color-text-soft); flex: 1; }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .nh-mission-grid { grid-template-columns: 1fr; }
    .nh-mission-card--main { grid-column: auto; }
    .nh-values { grid-template-columns: 1fr; }
    .nh-team-grid { grid-template-columns: 1fr; }
    .nh-pull-quote__mark { display: none; }
  }
</style>
