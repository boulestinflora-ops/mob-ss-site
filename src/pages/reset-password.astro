---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nouveau mot de passe — MOB'SS"
  description="Choisissez un nouveau mot de passe pour votre espace MOB'SS."
>
  <section class="section">
    <div class="container" style="max-width:480px;">
      <div class="text-center" style="margin-bottom:32px;">
        <span class="section__eyebrow">Sécurité</span>
        <h1>Nouveau mot de passe</h1>
        <p style="color:var(--color-text-soft);">Choisissez un mot de passe sécurisé pour votre compte.</p>
      </div>

      <div class="form-card">
        <div id="rp-message" style="display:none;padding:14px 18px;border-radius:var(--radius-md);margin-bottom:18px;font-size:0.95rem;"></div>

        <!-- Vue : chargement / vérification du token -->
        <div id="view-loading" style="text-align:center;padding:40px 0;color:var(--color-text-soft);">
          Vérification du lien…
        </div>

        <!-- Vue : formulaire nouveau mot de passe -->
        <div id="view-form" style="display:none;">
          <form id="rp-form" novalidate>
            <div class="field">
              <label for="new-password">Nouveau mot de passe</label>
              <input id="new-password" type="password" required minlength="8" autocomplete="new-password"
                placeholder="8 caractères minimum" />
            </div>
            <div class="field">
              <label for="confirm-password">Confirmer le mot de passe</label>
              <input id="confirm-password" type="password" required minlength="8" autocomplete="new-password"
                placeholder="Répétez le mot de passe" />
            </div>
            <button type="submit" class="btn btn--primary btn--block btn--lg">
              Enregistrer le nouveau mot de passe
            </button>
          </form>
        </div>

        <!-- Vue : lien invalide ou expiré -->
        <div id="view-invalid" style="display:none;text-align:center;padding:24px 0;">
          <p style="color:var(--color-text-soft);margin-bottom:20px;">
            Ce lien est invalide ou a expiré. Demandez un nouveau lien depuis la page de connexion.
          </p>
          <a href="/connexion" class="btn btn--primary">Retour à la connexion</a>
        </div>

        <!-- Vue : succès -->
        <div id="view-success" style="display:none;text-align:center;padding:24px 0;">
          <div style="font-size:2.5rem;margin-bottom:12px;">✓</div>
          <h2 style="font-size:1.2rem;margin-bottom:8px;">Mot de passe mis à jour</h2>
          <p style="color:var(--color-text-soft);margin-bottom:24px;">
            Votre mot de passe a bien été modifié. Vous allez être redirigé vers votre espace.
          </p>
          <a href="/dashboard" class="btn btn--primary">Accéder à mon espace</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  import { showMessage, markError, clearErrors } from '../lib/forms';

  const msgBox       = document.getElementById('rp-message')    as HTMLDivElement;
  const viewLoading  = document.getElementById('view-loading')  as HTMLDivElement;
  const viewForm     = document.getElementById('view-form')     as HTMLDivElement;
  const viewInvalid  = document.getElementById('view-invalid')  as HTMLDivElement;
  const viewSuccess  = document.getElementById('view-success')  as HTMLDivElement;

  function showView(v: HTMLDivElement) {
    [viewLoading, viewForm, viewInvalid, viewSuccess].forEach(el => el.style.display = 'none');
    v.style.display = '';
  }

  // Supabase with detectSessionInUrl:true exchanges the ?code= automatically.
  // We listen for the PASSWORD_RECOVERY event which fires when the recovery
  // link is valid. Any other auth event on this page means the link is invalid.
  let recoverySessionReady = false;

  supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'PASSWORD_RECOVERY') {
      recoverySessionReady = true;
      showView(viewForm);
    } else if (event === 'SIGNED_IN' && !recoverySessionReady) {
      // Token was for a normal sign-in, not a password reset — show invalid
      showView(viewInvalid);
    }
  });

  // Timeout : si aucun événement en 4 s, le lien est invalide / expiré
  const timer = setTimeout(() => {
    if (!recoverySessionReady) showView(viewInvalid);
  }, 4000);

  // ─── Formulaire nouveau mot de passe ──────────────────────────────────────
  const rpForm = document.getElementById('rp-form') as HTMLFormElement;
  rpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    showMessage(msgBox, 'error', '');  // reset
    msgBox.style.display = 'none';

    const newPwd     = (document.getElementById('new-password')     as HTMLInputElement).value;
    const confirmPwd = (document.getElementById('confirm-password') as HTMLInputElement).value;

    clearErrors('new-password', 'confirm-password');
    let hasError = false;

    if (!newPwd || newPwd.length < 8) {
      markError('new-password', 'Le mot de passe doit contenir au moins 8 caractères.');
      hasError = true;
    }
    if (newPwd !== confirmPwd) {
      markError('confirm-password', 'Les mots de passe ne correspondent pas.');
      hasError = true;
    }
    if (hasError) return;

    const btn = rpForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled    = true;
    btn.textContent = 'Enregistrement…';

    const { error } = await supabase.auth.updateUser({ password: newPwd });

    btn.disabled    = false;
    btn.textContent = 'Enregistrer le nouveau mot de passe';

    if (error) {
      showMessage(msgBox, 'error', `Erreur : ${error.message}`);
    } else {
      clearTimeout(timer);
      showView(viewSuccess);
      // Redirection automatique après 3 s
      setTimeout(() => { window.location.href = '/dashboard'; }, 3000);
    }
  });
</script>
