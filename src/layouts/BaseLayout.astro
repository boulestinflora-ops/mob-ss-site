---
// BaseLayout — Le squelette HTML commun à toutes les pages
// On le définit UNE FOIS ici, puis chaque page l'utilise.
// Pour modifier le menu, le pied de page ou le bandeau cookies,
// il suffit de changer Header.astro, Footer.astro ou CookieBanner.astro.

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/style.css';

// Les pages peuvent passer des informations au layout (titre, description, etc.)
// Exemple : <BaseLayout title="Contact" description="Nous contacter">
const {
  title = "MOB'SS — Rendre le sport et la santé accessibles à tous",
  description = "MOB'SS connecte les professionnels du sport et de la santé avec des espaces inoccupés pour faciliter l'accès aux soins et au bien-être partout en France.",
  currentPage = ''
} = Astro.props;

// Utilise l'URL définie dans astro.config.mjs (mise à jour après déploiement)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://mobss.vercel.app';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// ⚠️ BETA — Empêche l'indexation par Google pendant la phase de test.
// Pour désactiver, mettre PUBLIC_BETA_MODE=false dans .env (ou supprimer la variable).
const BETA_MODE = import.meta.env.PUBLIC_BETA_MODE !== 'false';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- URL canonique -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph — partage sur LinkedIn, WhatsApp, etc. -->
  <meta property="og:type"         content="website" />
  <meta property="og:site_name"    content="MOB'SS" />
  <meta property="og:locale"       content="fr_FR" />
  <meta property="og:url"          content={canonicalUrl} />
  <meta property="og:title"        content={title} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content="MOB'SS — Des espaces gratuits pour exercer, partout en France" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@mobss_france" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={`${siteUrl}/og-image.png`} />

  <!-- JSON-LD — Organisation + moteur de recherche -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "MOB'SS",
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.svg`
        },
        "description": "MOB'SS connecte les espaces inoccupés des collectivités et des entreprises avec les professionnels du sport et de la santé — gratuitement, partout en France.",
        "email": "contact@mobss.fr",
        "sameAs": [
          "https://www.linkedin.com/company/mobss",
          "https://www.instagram.com/mobss.france"
        ]
      },
      {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "url": siteUrl,
        "name": "MOB'SS",
        "publisher": { "@id": `${siteUrl}/#organization` },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": `${siteUrl}/explorez?q={search_term_string}`
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />

  <!-- Noindex bêta — RETIRER cette ligne au lancement officiel (mettre BETA_MODE = false) -->
  {BETA_MODE && <meta name="robots" content="noindex, nofollow" />}

  <!-- Moteur de visite guidée — chargé en premier pour être disponible partout -->
  <!-- Slot optionnel pour les pages qui ont besoin d'injecter dans <head>
       (ex : Leaflet CSS/JS pour la page Explorez) -->
  <slot name="head" />

  <!-- Polices : Playfair Display (titres) + DM Sans (corps) — chargées sans bloquer le rendu -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Lien d'accès rapide pour la navigation au clavier -->
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <!-- Bandeau "site en cours de développement" -->
  <div class="dev-banner" role="status" aria-label="Avis de développement" aria-live="polite">
    🚧&nbsp; Site en cours de création — MOB'SS est en développement, la société n'est pas encore créée.
    <button type="button" class="dev-banner__close" aria-label="Fermer" onclick="this.parentElement.style.display='none'">✕</button>
  </div>

  <!-- En-tête (le menu en haut, identique sur toutes les pages) -->
  <Header currentPage={currentPage} />

  <!-- Le contenu de la page : c'est le <slot /> qui reçoit
       le HTML spécifique à chaque page -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Pied de page (identique sur toutes les pages) -->
  <Footer />

  <!-- Bandeau cookies RGPD (identique sur toutes les pages) -->
  <CookieBanner />

  <!-- Scripts JavaScript globaux -->
  <script src="/scripts/script.js" is:inline></script>
</body>
</html>
