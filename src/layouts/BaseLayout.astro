---
// BaseLayout — Le squelette HTML commun à toutes les pages
// On le définit UNE FOIS ici, puis chaque page l'utilise.
// Pour modifier le menu, le pied de page ou le bandeau cookies,
// il suffit de changer Header.astro, Footer.astro ou CookieBanner.astro.

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/style.css';

// Polices auto-hébergées via fontsource (pas de dépendance Google Fonts)
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/space-grotesk';

const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
const POSTHOG_HOST = 'https://eu.posthog.com';

// Les pages peuvent passer des informations au layout (titre, description, etc.)
// Exemple : <BaseLayout title="Contact" description="Nous contacter">
const {
  title = "MOB'SS — Rendre le sport et la santé accessibles à tous",
  description = "MOB'SS : des espaces pour exercer sans loyer ni bail, des territoires qui agissent contre les déserts médicaux. Gratuit pour praticiens et collectivités.",
  currentPage = ''
} = Astro.props;

// Utilise l'URL définie dans astro.config.mjs (mise à jour après déploiement)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://mobss.vercel.app';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// ⚠️ BETA — Empêche l'indexation par Google pendant la phase de test.
// Pour désactiver, mettre PUBLIC_BETA_MODE=false dans .env (ou supprimer la variable).
const BETA_MODE = import.meta.env.PUBLIC_BETA_MODE !== 'false';

// JSON-LD construit dans le frontmatter pour éviter que Vite parse le JSON
// comme du JS (erreur "invalid JS syntax at astro.config.mjs:1:1")
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "MOB'SS",
      "url": siteUrl,
      "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.svg` },
      "description": "MOB'SS connecte les espaces inoccupés des collectivités et des entreprises avec les professionnels du sport et de la santé — gratuitement, partout en France.",
      "email": "contact@mobss.fr",
      "sameAs": [
        "https://www.linkedin.com/company/mobss",
        "https://www.instagram.com/mobss.france"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "MOB'SS",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/explorez?q={search_term_string}` },
        "query-input": "required name=search_term_string"
      }
    }
  ]
});
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- URL canonique -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph — partage sur LinkedIn, WhatsApp, etc. -->
  <meta property="og:type"         content="website" />
  <meta property="og:site_name"    content="MOB'SS" />
  <meta property="og:locale"       content="fr_FR" />
  <meta property="og:url"          content={canonicalUrl} />
  <meta property="og:title"        content={title} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content="MOB'SS — Des espaces gratuits pour exercer, partout en France" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@mobss_france" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={`${siteUrl}/og-image.png`} />

  <!-- JSON-LD — Organisation + moteur de recherche (Fragment évite le parsing Vite) -->
  <Fragment set:html={`<script type="application/ld+json">${jsonLd}</script>`} />

  <!-- Noindex bêta — RETIRER cette ligne au lancement officiel (mettre BETA_MODE = false) -->
  {BETA_MODE && <meta name="robots" content="noindex, nofollow" />}

  <!-- Slot optionnel pour les pages qui ont besoin d'injecter dans <head>
       (ex : Leaflet CSS/JS pour la page Explorez) -->
  <slot name="head" />

</head>
<body>

  <!-- Lien d'accès rapide pour la navigation au clavier -->
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <!-- Bandeau "site en cours de développement" -->
  <div class="dev-banner" role="status" aria-label="Avis de développement" aria-live="polite">
    <span aria-hidden="true">🚧</span>&nbsp; Site en cours de création — MOB'SS est en développement, la société n'est pas encore créée.
    <button type="button" class="dev-banner__close" id="dev-banner-close" aria-label="Fermer le bandeau de développement">✕</button>
  </div>

  <script is:inline>
    (function() {
      var btn = document.getElementById('dev-banner-close');
      if (btn) {
        var handler = function() {
          var banner = btn.parentElement;
          if (banner) banner.style.display = 'none';
        };
        btn.addEventListener('click', handler);
        // Support clavier explicite (Enter + Espace) pour les lecteurs d'écran
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handler(); }
        });
      }
    })();
  </script>

  <!-- En-tête (le menu en haut, identique sur toutes les pages) -->
  <Header currentPage={currentPage} />

  <!-- Le contenu de la page : c'est le <slot /> qui reçoit
       le HTML spécifique à chaque page -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Pied de page (identique sur toutes les pages) -->
  <Footer />

  <!-- Bandeau cookies RGPD (identique sur toutes les pages) -->
  <CookieBanner />

  <!-- Scripts JavaScript globaux -->
  <script src="/scripts/script.js" is:inline></script>

  <!-- Service Worker — cache offline homepage + assets statiques -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  </script>

  <!-- PostHog — analytics privacy-first (EU cloud, ne charge pas si clé absente) -->
  {POSTHOG_KEY && (
    <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+" (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(POSTHOG_KEY, { api_host: POSTHOG_HOST, person_profiles: 'identified_only' });

      // Capture des erreurs JS non gérées → PostHog (évite d'ajouter Sentry)
      window.addEventListener('error', function(e) {
        window.posthog && posthog.capture('$exception', {
          message: e.message,
          filename: e.filename,
          lineno: e.lineno,
          colno: e.colno,
          stack: e.error && e.error.stack ? e.error.stack.slice(0, 500) : null,
        });
      });
      window.addEventListener('unhandledrejection', function(e) {
        window.posthog && posthog.capture('$exception', {
          message: String(e.reason),
          type: 'unhandledrejection',
        });
      });
    </script>
  )}
</body>
</html>
