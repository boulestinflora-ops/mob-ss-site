---
interface Props {
  title?: string;
  style?: string;
  id?: string;
}
const { title, style, id } = Astro.props;
---
<div class="panel" style={style} id={id}>
  {title && (
    <div class="panel__head">
      <h3>{title}</h3>
      <slot name="actions" />
    </div>
  )}
  <slot name="head" />
  <slot />
</div>
