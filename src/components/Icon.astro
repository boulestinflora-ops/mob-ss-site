---
// Icon — Composant centralisé pour toutes les icônes du site
// Au lieu de coller le code SVG partout, on l'écrit ici une seule fois
// et on l'utilise via <Icon name="map-pin" />
const { name, width = 24, height = 24 } = Astro.props;
---

{name === 'map-pin' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 1 1 16 0Z"/>
    <circle cx="12" cy="10" r="3"/>
  </svg>
)}
{name === 'calendar' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="3" y="4" width="18" height="18" rx="2"/>
    <path d="M16 2v4M8 2v4M3 10h18"/>
  </svg>
)}
{name === 'credit-card' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="2" y="6" width="20" height="12" rx="2"/>
    <path d="M2 10h20M6 15h2"/>
  </svg>
)}
{name === 'message' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
  </svg>
)}
{name === 'chart' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/>
  </svg>
)}
{name === 'subscription' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="3" y="6" width="18" height="13" rx="2"/>
    <path d="M3 10h18M8 6V4M16 6V4"/>
  </svg>
)}
{name === 'search' && (
  <svg aria-hidden="true" width={width} height={height} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.35-4.35"/>
  </svg>
)}
