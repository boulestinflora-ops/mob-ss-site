---
// FeatureCard — Une carte fonctionnalité (Géolocalisation, Calendrier, etc.)
import Icon from './Icon.astro';
const { icon, title, description } = Astro.props;
---

<div class="card">
  <div class="card__icon">
    <Icon name={icon} width={28} height={28} />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</div>
