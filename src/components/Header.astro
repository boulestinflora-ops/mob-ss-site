---
const { currentPage = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Accueil', key: 'accueil' },
  { href: '/explorez', label: 'Espaces', key: 'explorez' },
  { href: '/contact', label: 'Contact', key: 'contact' }
];

const commentLinks = [
  { href: '/comment-ca-marche', label: 'Comment ça marche', desc: 'Le fonctionnement pas à pas', icon: '⚙️' },
  { href: '/le-probleme', label: 'Le problème', desc: 'Le paradoxe des territoires français', icon: '\U0001f4ca' },
  { href: '/notre-solution', label: 'La solution', desc: "Comment MOB'SS fait le lien", icon: '\U0001f517' },
  { href: '/notre-impact', label: 'Notre impact', desc: "Ce que MOB'SS change concrètement", icon: '\U0001f3af' },
];

const isCommentActive = ['comment','probleme','solution','impact'].includes(currentPage);
// Annuaire et Remplacements sont visibles pour tous (état actif géré par JS)
---

<header class="site-header">
  <div class="container site-header__inner">

    <!-- Logo (SVG inliné — les polices de la page s'appliquent) -->
    <a class="brand" href="/" aria-label="MOB'SS Accueil">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 58" height="66" width="auto" aria-hidden="true" style="display:block;flex-shrink:0;">
        <!-- Badge icône -->
        <rect x="0" y="5" width="50" height="50" rx="11" fill="#9C2E3A"/>
        <rect x="0" y="0" width="50" height="50" rx="11" fill="#C8424F"/>
        <text x="25" y="34" font-family="inherit" font-size="27" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">M</text>
        <!-- Wordmark -->
        <text x="62" y="31" font-family="inherit" font-size="25" font-weight="800" font-style="italic" fill="#C8424F" letter-spacing="0.5">MOB'SS</text>
        <!-- Tagline -->
        <text x="63" y="46" font-family="inherit" font-size="9.5" font-weight="400" fill="#6B7280" letter-spacing="1.8">mobile · sport · santé</text>
      </svg>
    </a>

    <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav">
      <span aria-hidden="true"></span>
    </button>

    <!-- Backdrop mobile (overlay sombre derrière le menu ouvert) -->
    <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

    <!-- Navigation -->
    <nav class="nav" id="main-nav" aria-label="Navigation principale" style="justify-content:center;">
      {navLinks.map(link => (
        <a href={link.href} class={currentPage === link.key ? 'is-active' : ''} style="white-space:nowrap;">
          {link.label}
        </a>
      ))}

      <!-- Dropdown "Comment ça marche" -->
      <div class="nav-dropdown" id="nav-comment-dropdown">
        <button
          type="button"
          class={`nav-dropdown__trigger${isCommentActive ? ' is-active' : ''}`}
          aria-expanded="false"
          aria-haspopup="true"
          id="nav-comment-btn"
        >
          Comment ça marche
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav-dropdown__panel" id="nav-comment-panel" role="menu">
          {commentLinks.map(link => (
            <a href={link.href} class={`nav-dropdown__item${currentPage === link.key ? ' is-active' : ''}`} role="menuitem">
              <span class="nav-dropdown__item-icon" aria-hidden="true">{link.icon}</span>
              <span class="nav-dropdown__item-text">
                <strong>{link.label}</strong>
                <span>{link.desc}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Annuaire et Remplacements — visibles pour tous, le JS gère uniquement l'état actif -->
      <a href="/annuaire" id="nav-annuaire" style="white-space:nowrap;">Annuaire</a>
      <a href="/remplacements" id="nav-remplacements" style="white-space:nowrap;">Remplacements</a>

      <!-- Actions mobile -->
      <div class="nav__mobile-actions">
        <div id="nav-loggedout-mobile" style="display:flex;flex-direction:column;gap:8px;">
          <a href="/connexion" class="btn btn--outline">Se connecter</a>
          <a href="/inscription" class="btn btn--outline">S'inscrire</a>
        </div>
        <div id="nav-loggedin-mobile" style="display:none;flex-direction:column;gap:8px;">
          <a href="/dashboard" class="btn btn--outline">Mon espace</a>
          <button type="button" id="logout-mobile" class="btn btn--outline">Se déconnecter</button>
        </div>
        <a href="/deposer-annonce" id="nav-deposer-mobile" class="btn btn--cream" style="margin-top:4px;">Déposer un espace</a>
      </div>
    </nav>

    <!-- Actions desktop -->
    <div class="header-actions">

      <!-- Non connecté -->
      <div id="user-loggedout" style="display:flex;align-items:center;gap:8px;">
        <a href="/deposer-annonce" class="btn btn--cream" style="white-space:nowrap;" id="deposer-btn-out">Déposer un espace</a>
        <a href="/connexion" class="btn btn--outline" style="white-space:nowrap;">Se connecter</a>
        <a href="/inscription" class="btn btn--outline" style="white-space:nowrap;">S'inscrire</a>
      </div>

      <!-- Connecté -->
      <div id="user-loggedin" style="display:none;align-items:center;gap:10px;">
        <a href="/deposer-annonce" id="deposer-btn-in" class="btn btn--cream" style="white-space:nowrap;">Déposer un espace</a>

        <!-- Avatar + dropdown -->
        <div class="user-menu" id="user-menu">
          <button type="button" class="user-menu__trigger" id="user-menu-trigger" aria-expanded="false" aria-haspopup="true">
            <span id="user-avatar" style="width:34px;height:34px;border-radius:8px;background:var(--color-cream);color:var(--color-primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.9rem;">?</span>
            <span id="user-name" style="font-weight:600;font-size:0.92rem;">Mon espace</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="user-menu__dropdown" id="user-dropdown" role="menu">
            <a href="/dashboard" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
              Mon tableau de bord
            </a>
            <a href="/dashboard" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              Mon profil
            </a>
            <hr style="border:none;border-top:1px solid var(--color-border);margin:4px 0;" />
            <button type="button" id="logout-btn" role="menuitem" style="width:100%;text-align:left;display:flex;align-items:center;gap:8px;padding:8px 14px;color:var(--color-text-soft);background:none;border:none;font-family:inherit;font-size:0.9rem;cursor:pointer;border-radius:var(--radius-sm);">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Se déconnecter
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* ── Nav dropdown "Comment ça marche" ── */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown__trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: var(--color-text);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color .15s;
  }
  .nav-dropdown__trigger:hover,
  .nav-dropdown__trigger.is-active {
    color: var(--color-primary);
  }
  .nav-dropdown__trigger.is-active {
    border-bottom-color: var(--color-primary);
  }
  .nav-dropdown__trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .nav-dropdown__trigger svg {
    transition: transform .2s ease;
    flex-shrink: 0;
  }
  .nav-dropdown__panel {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 280px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px rgba(31,21,24,0.12);
    z-index: 200;
    padding: 8px;
    animation: dropIn .15s ease;
  }
  .nav-dropdown__panel.is-open { display: block; }
  .nav-dropdown__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background .12s;
  }
  .nav-dropdown__item:hover,
  .nav-dropdown__item.is-active {
    background: var(--color-cream-soft);
  }
  .nav-dropdown__item-icon {
    font-size: 1.3rem;
    width: 36px;
    height: 36px;
    background: var(--color-bg-soft);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .nav-dropdown__item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-dropdown__item-text strong {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 600;
  }
  .nav-dropdown__item-text span {
    font-size: 0.78rem;
    color: var(--color-text-soft);
  }
  .nav-dropdown__item.is-active .nav-dropdown__item-text strong {
    color: var(--color-primary);
  }

  /* Mobile — dropdown en liste verticale */
  @media (max-width: 1024px) {
    .nav-dropdown__trigger {
      font-size: 1rem;
      padding: 10px 0;
      border-bottom: none;
      border-top: 1px solid var(--color-border);
      width: 100%;
      justify-content: space-between;
    }
    .nav-dropdown__panel {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0 0 0 12px;
      background: transparent;
      animation: none;
    }
    .nav-dropdown__panel.is-open { display: block; }
    .nav-dropdown__item { padding: 8px 0; }
    .nav-dropdown__item-icon { display: none; }
  }

  /* Uniformiser les boutons Se connecter / S'inscrire */
  #user-loggedout .btn--outline {
    padding: 10px 18px;
    font-size: 0.9rem;
  }

  /* User menu dropdown */
  .user-menu {
    position: relative;
  }
  .user-menu__trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-border);
    background: #fff;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .user-menu__trigger:hover,
  .user-menu__trigger[aria-expanded="true"] {
    border-color: var(--color-primary);
    background: var(--color-cream-soft);
  }
  .user-menu__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 210px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(31,21,24,0.10);
    z-index: 200;
    padding: 6px;
    animation: dropIn 0.15s ease;
  }
  .user-menu__dropdown.is-open { display: block; }
  .user-menu__dropdown a,
  .user-menu__dropdown button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.12s;
    font-family: inherit;
  }
  .user-menu__dropdown a:hover,
  .user-menu__dropdown button:hover {
    background: var(--color-cream-soft);
    color: var(--color-primary);
  }
  @keyframes dropIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // Déconnexion
  async function doLogout() {
    try { await supabase.auth.signOut(); } catch (e) {}
    window.location.href = '/';
  }
  document.getElementById('logout-btn')?.addEventListener('click', doLogout);
  document.getElementById('logout-mobile')?.addEventListener('click', doLogout);

  // Dropdown user menu toggle
  const trigger  = document.getElementById('user-menu-trigger');
  const dropdown = document.getElementById('user-dropdown');
  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = dropdown?.classList.toggle('is-open');
    trigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!document.getElementById('user-menu')?.contains(e.target as Node)) {
      dropdown?.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdown?.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Dropdown "Comment ça marche"
  const commentBtn   = document.getElementById('nav-comment-btn');
  const commentPanel = document.getElementById('nav-comment-panel');
  commentBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = commentPanel?.classList.toggle('is-open');
    commentBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!document.getElementById('nav-comment-dropdown')?.contains(e.target as Node)) {
      commentPanel?.classList.remove('is-open');
      commentBtn?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      commentPanel?.classList.remove('is-open');
      commentBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Session
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    const loggedOut = document.getElementById('user-loggedout');
    const loggedIn  = document.getElementById('user-loggedin');
    const avatar    = document.getElementById('user-avatar');
    const nameEl    = document.getElementById('user-name');
    const navLoggedOutMobile = document.getElementById('nav-loggedout-mobile');
    const navLoggedInMobile  = document.getElementById('nav-loggedin-mobile');

    if (!session?.user) return;

    // Affiche le bloc connecté
    if (loggedOut) loggedOut.style.display = 'none';
    if (loggedIn)  loggedIn.style.display  = 'flex';
    if (navLoggedOutMobile) navLoggedOutMobile.style.display = 'none';
    if (navLoggedInMobile)  navLoggedInMobile.style.display  = 'flex';
    // Cacher "Déposer un espace" pour tout utilisateur connecté
    document.getElementById('deposer-btn-in')?.style.setProperty('display', 'none');
    document.getElementById('nav-deposer-mobile')?.style.setProperty('display', 'none');

    // Fallback immédiat
    const fallback = session.user.email?.split('@')[0] || '?';
    if (nameEl) nameEl.textContent = fallback;
    if (avatar) avatar.textContent = (fallback[0] || '?').toUpperCase();

    // Profil complet
    try {
      const { data: profile } = await supabase
        .from('profiles')
        .select('prenom, nom, role')
        .eq('id', session.user.id)
        .single();

      if (profile) {
        const prenom = profile.prenom || fallback;
        const initiales = ((prenom[0] || '') + (profile.nom?.[0] || '')).toUpperCase() || '?';
        if (avatar) avatar.textContent = initiales;
        if (nameEl) nameEl.textContent = prenom;

        // Active state sur Annuaire / Remplacements selon l'URL courante
        const path = window.location.pathname;
        if (path.startsWith('/annuaire'))      document.getElementById('nav-annuaire')?.classList.add('is-active');
        if (path.startsWith('/remplacements')) document.getElementById('nav-remplacements')?.classList.add('is-active');


      }
    } catch (e) {
      console.warn('Profil header non chargé', e);
    }
  });
</script>
