# Modèle des variables d'environnement (à copier en .env et remplir)
# Ce fichier est versionné, le .env ne l'est PAS.
#
# ── Stratégie d'environnements ────────────────────────────────────
# Development  : .env local (ce fichier comme base)
# Staging      : Vercel Preview Deployments (chaque push/PR hors main)
#                → PUBLIC_BETA_MODE=true forcé dans Vercel → Preview
# Production   : branche main → mobss.fr
#                → PUBLIC_BETA_MODE=false uniquement au lancement officiel
#
# À configurer dans Vercel → Project Settings → Environment Variables :
#   Production  : PUBLIC_BETA_MODE=false  (activer au lancement)
#   Preview     : PUBLIC_BETA_MODE=true   (toujours)
#   Development : PUBLIC_BETA_MODE=true   (toujours)
# ─────────────────────────────────────────────────────────────────

# ── Supabase (obligatoire) ────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# ── Mode bêta (false = lancement officiel, noindex retiré) ────────
PUBLIC_BETA_MODE=true

# ── Admin (optionnel — protège /admin) ───────────────────────────
PUBLIC_ADMIN_EMAIL=admin@mobss.fr

# ── Analytics PostHog (optionnel) ────────────────────────────────
# Clé disponible sur https://app.posthog.com → Project settings
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Edge Functions (Supabase → Settings → Secrets uniquement) ─────
# ESANTE_API_KEY=xxxx   ← NE PAS mettre ici
