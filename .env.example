# Modèle des variables d'environnement (à copier en .env et remplir)
# Ce fichier est versionné, le .env ne l'est PAS.

PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Mettre à false pour désactiver le noindex (lancement officiel)
PUBLIC_BETA_MODE=true

# Email de l'administrateur — garde-fou UX côté client (la vraie protection est server-side).
# Ne jamais hardcoder un email dans le code source.
PUBLIC_ADMIN_EMAIL=admin@example.com
