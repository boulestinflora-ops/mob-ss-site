# Modèle des variables d'environnement (à copier en .env et remplir)
# Ce fichier est versionné, le .env ne l'est PAS.

# ── Supabase (obligatoire) ────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# ── Mode bêta (mettre false au lancement officiel) ────────────────
PUBLIC_BETA_MODE=true

# ── Admin (optionnel — protège /admin) ───────────────────────────
PUBLIC_ADMIN_EMAIL=admin@mobss.fr

# ── Analytics PostHog (optionnel) ────────────────────────────────
# Clé disponible sur https://app.posthog.com → Project settings
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
